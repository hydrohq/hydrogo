package v1

// themeNavigationList renders validated menu entries (RenderThemeNavigation)
// as nested lists. Hrefs are same-origin paths checked before rendering.
templ themeNavigationList(nodes []themeNavigationNode, depth int) {
	<ul class={ themeNavigationListClass(depth) }>
		for _, node := range nodes {
			<li class="site-navigation-item"><a class="site-navigation-link" href={ templ.SafeURL(node.Item.Href) } if node.Item.Target == "_blank" { target="_blank" rel="noopener noreferrer" }>{ node.Item.Label }</a>@themeNavigationChildren(node.Children, depth)</li>
		}
	</ul>
}

templ themeNavigationChildren(nodes []themeNavigationNode, depth int) {
	if len(nodes) > 0 {
		@themeNavigationList(nodes, depth+1)
	}
}
