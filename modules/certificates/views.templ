package certificates
import (
	"strings"
	"time"
 "github.com/ardaozyildirim/hydrogo/internal/sectoral"
)
templ Collection(items []Certificate) {
<section class="sectoral-collection bg-background text-foreground" data-module="certificates">
 for _, item := range items {
  if item.Status == "published" {
   <article class="sectoral-card bg-surface border-border"><h2>{ item.Title }</h2><p>{ item.Issuer }</p>
   if item.ExpiresAt.IsZero() {
    <p>Geçerlilik süresi belirtilmemiş</p>
   }
   if !item.ExpiresAt.IsZero() {
    <time datetime={ item.ExpiresAt.Format(time.RFC3339) }>{ item.ExpiresAt.Format("02.01.2006") } tarihine kadar geçerli</time>
   }
				<a href={ templ.SafeURL(sectoral.SanitizeWebURL(item.DocumentURL)) }>Belgeyi görüntüle</a>
				if strings.HasSuffix(strings.ToLower(item.DocumentURL), ".pdf") {
					<iframe class="certificate-pdf-preview" src={ templ.SafeURL(sectoral.SanitizeWebURL(item.DocumentURL)) } title={ item.Title + " PDF önizlemesi" } sandbox="" loading="lazy"></iframe>
				}
   </article>
  }
 }
</section>
}
