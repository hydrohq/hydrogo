package designsystem

templ HelpfulFeedback(p HelpfulFeedbackProps) {
	<section class="mx-auto grid gap-3 border-t border-border py-4 text-foreground" id={ p.ElementID } data-feedback data-feedback-type={ p.ContentType } data-feedback-id={ p.ContentID } aria-label="Bu içerik yardımcı oldu mu?">
		<p class="font-semibold">Bu içerik yardımcı oldu mu?</p>
		<div class="flex gap-2">
			<form method="post" action="/api/v1/feedback" hx-post="/api/v1/feedback" hx-target={ "#" + p.ElementID } hx-swap="outerHTML">
				<input type="hidden" name="_csrf" value=""/><input type="hidden" name="content_type" value={ p.ContentType }/><input type="hidden" name="content_id" value={ p.ContentID }/><input type="hidden" name="element_id" value={ p.ElementID }/><input type="hidden" name="reaction" value="up"/>
				<button type="submit" class="button button-quiet" aria-label="Evet, içerik yardımcı oldu">👍 Evet</button>
			</form>
			<form method="post" action="/api/v1/feedback" hx-post="/api/v1/feedback" hx-target={ "#" + p.ElementID } hx-swap="outerHTML">
				<input type="hidden" name="_csrf" value=""/><input type="hidden" name="content_type" value={ p.ContentType }/><input type="hidden" name="content_id" value={ p.ContentID }/><input type="hidden" name="element_id" value={ p.ElementID }/><input type="hidden" name="reaction" value="down"/>
				<button type="submit" class="button button-quiet" aria-label="Hayır, içerik yardımcı olmadı">👎 Hayır</button>
			</form>
		</div>
		<p class="text-sm text-muted-foreground" aria-live="polite">{ p.Up } kişi faydalı buldu · { p.Down } kişi faydalı bulmadı</p>
		if p.LoadHTMX {
			<script src="/vendor/htmx/htmx.min.js" defer></script>
		}
		<script src="/designsystem/static/feedback.js" defer></script>
	</section>
}

templ HelpfulFeedbackThanks(p HelpfulFeedbackProps) {
	<section class="mx-auto grid gap-3 border-t border-border py-4 text-foreground" id={ p.ElementID } aria-live="polite"><p>Geri bildiriminiz için teşekkürler.</p><p>{ p.Up } kişi faydalı buldu · { p.Down } kişi faydalı bulmadı</p></section>
}

templ FAQFeedbackReport(items []FAQFeedbackMetric) {
	if len(items) > 0 {
		<section class="studio-card" aria-labelledby="faq-feedback-title">
			<h2 id="faq-feedback-title">SSS geri bildirimleri</h2>
			<div class="overflow-x-auto">
				<table>
					<thead><tr><th scope="col">Soru</th><th scope="col">Yararlı</th><th scope="col">Yararlı değil</th></tr></thead>
					<tbody>
						for _, item := range items {
							<tr><th scope="row">{ item.Question }</th><td>{ item.Up }</td><td>{ item.Down }</td></tr>
						}
					</tbody>
				</table>
			</div>
		</section>
	}
}
