package designsystem

templ CodeBlock(props CodeBlockProps) {
	<figure class="ds-code-block">
		<figcaption class="ds-code-block-head">
			<span class="ds-code-block-language">{ NormalizeCodeLanguage(props.Language) }</span>
			<button class="ds-code-copy" type="button" data-copy-code aria-label="Kod bloğunu panoya kopyala">Kodu kopyala</button>
			<span class="ds-code-copy-status" data-code-copy-status role="status" aria-live="polite"></span>
		</figcaption>
		<pre><code class={ "language-" + NormalizeCodeLanguage(props.Language) }>
			for _, token := range CodeTokens(props.Code, props.Language) {
				@codeToken(token)
			}
		</code></pre>
	</figure>
}

templ codeToken(token CodeToken) {
	if token.Kind == "" {
		{ token.Text }
	} else {
		<span class={ "code-token code-token-" + token.Kind }>{ token.Text }</span>
	}
}

templ PasswordStrengthMeter() {
	<div class="ds-password-strength">
		<meter min="0" max="4" value="0" data-password-meter aria-label="Parola gücü"></meter>
		<p data-password-feedback role="status" aria-live="polite">En az 8 karakter seçin; yaygın parolalardan kaçının.</p>
	</div>
}
