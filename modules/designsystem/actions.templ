package designsystem

templ ExportLinks(items []ExportLink) {
	<nav class="export-links" style="display:inline-flex;gap:8px;align-items:center;flex-wrap:wrap;margin:4px 0 10px;" aria-label="Export data">
		if len(items) == 0 {
			<span role="status" class="ds-sr-only">No export links available</span>
		}
		for _, item := range items {
			if href := safeLink(item.URL); href != "" {
				<a class="button button-quiet button-sm" href={ href } download style="display:inline-flex;align-items:center;gap:6px;text-decoration:none;"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg><span>{ item.Label }</span></a>
			}
		}
	</nav>
}

templ CopyButton(p CopyButtonProps) {
	<button class="ds-copy" type="button" data-copy-text={ p.Text } aria-label={ label(p.Label, "Copy to clipboard") } aria-live="polite">
		if p.IconOnly {
			<span data-copy-idle aria-hidden="true">⧉</span>
		} else {
			<span data-copy-idle>{ label(p.Label, "Copy") }</span>
		}
		<span data-copy-done hidden role="status">{ label(p.CopiedLabel, "Copied") }</span>
	</button>
}
