package designsystem

templ SoundAlertPreference(p SoundAlertPreferenceProps) {
	<section class="mt-4 rounded-lg border border-border bg-surface p-4 text-foreground" data-sound-alert-settings aria-labelledby="sound-alert-title">
		<h2 id="sound-alert-title" class="text-base font-semibold">{ p.Title }</h2>
		<p class="mb-3 text-sm">{ p.Description }</p>
		<label class="inline-flex items-center gap-2 text-sm">
			<input type="checkbox" data-sound-alert-preference aria-label={ p.Label } />
			<span>{ p.Label }</span>
		</label>
	</section>
}

templ FormSuccessConfetti(p ConfettiProps) {
	if p.Enabled {
		<span class="ds-confetti" data-confetti-success aria-hidden="true" data-success-label={ label(p.Label, "Form submitted") }></span>
	}
}

templ ContactWidgetSettings(p ContactWidgetSettingsProps) {
	<form class="studio-card grid gap-4" method="post" action="/admin/appearance/contact-widget">
		<input type="hidden" name="_csrf" value={ p.CSRF } />
		<label class="flex items-center gap-2"><input type="checkbox" name="enabled" value="true" checked?={ p.Enabled } /> Enable floating contact widget</label>
		<label class="grid gap-1">WhatsApp number with country code<input class="rounded border border-border bg-surface p-2" name="whatsapp_number" type="tel" maxlength="40" value={ p.WhatsAppNumber } placeholder="+90 555 123 4567" aria-label="WhatsApp Number" /></label>
		<label class="grid gap-1">Direct call number<input class="rounded border border-border bg-surface p-2" name="phone" type="tel" maxlength="40" value={ p.Phone } placeholder="+90 212 555 0100" aria-label="Phone Number" /></label>
		<label class="grid gap-1">WhatsApp welcome message<textarea class="rounded border border-border bg-surface p-2" name="message" maxlength="500" aria-label="Welcome message">{ p.Message }</textarea></label>
		<label class="grid gap-1">Position<select class="rounded border border-border bg-surface p-2" name="position" aria-label="Widget position"><option value="bottom-right" selected?={ p.Position == "bottom-right" }>Bottom right</option><option value="bottom-left" selected?={ p.Position == "bottom-left" }>Bottom left</option></select></label>
		<label class="flex items-center gap-2"><input type="checkbox" name="mobile_only" value="true" checked?={ p.MobileOnly } /> Show only on mobile devices</label>
		<button class="ds-button ds-button--primary" type="submit" aria-busy="false" data-loading-text="Saving...">Save contact widget</button>
	</form>
}

templ SocialAccounts(p SocialAccountsProps) {
	<form class="studio-card grid gap-4" method="post" action="/admin/site/social-links">
		<input type="hidden" name="_csrf" value={ p.CSRF } />
		for _, platform := range SocialAccountPlatforms() {
			<label class="grid gap-1">{ socialPlatformLabel(platform) }<input class="rounded border border-border bg-surface p-2" type="url" name={ "social_" + platform } maxlength="2048" value={ p.URLs[platform] } placeholder={ "https://" + platform + ".com/your-profile" } aria-label={ platform + " URL" } /></label>
		}
		<button class="ds-button ds-button--primary" type="submit" aria-busy="false" data-loading-text="Saving...">Save social profiles</button>
	</form>
}

templ PageLayoutPicker(p PageLayoutPickerProps) {
	<fieldset class="ds-layout-picker" aria-label={ p.Legend }>
		<legend>{ p.Legend }</legend>
		if len(p.Options) == 0 {
			<p role="status" class="empty-state">{ p.EmptyMessage }</p>
		} else {
			<div class="ds-layout-picker__options">
				for _, option := range p.Options {
					<label class="ds-layout-option">
						<input type="radio" name="layout_template" value={ option.ID } checked?={ option.ID == "blank" } aria-label={ option.Name } />
						<span class="ds-layout-option__preview" aria-hidden="true"><i></i><i></i><i></i></span>
						<span class="ds-layout-option__copy"><strong>{ option.Name }</strong><small>{ option.Description }</small></span>
					</label>
				}
			</div>
		}
	</fieldset>
}

templ PasswordResetForm(p PasswordResetFormProps) {
	<html lang={ inviteAcceptLocale(p.Locale) }>
		<head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{ passwordResetTitle(p.Locale) }</title><link rel="stylesheet" href="/designsystem/static/designsystem.css"/></head>
		<body class="grid min-h-screen place-items-center bg-background p-4 text-foreground">
			<main class="mx-auto grid w-full max-w-md gap-4 rounded-xl border border-border bg-surface p-6 text-foreground" aria-labelledby="password-reset-title">
				if p.Locale == "tr" {
					<h1 id="password-reset-title" class="text-2xl font-bold">Yeni parola belirle</h1>
					<p>Hesabını güvenceye almak için yeni bir parola seç.</p>
				} else {
					<h1 id="password-reset-title" class="text-2xl font-bold">Choose a new password</h1>
					<p>Choose a new password to secure your account.</p>
				}
				if p.Error != "" {
					<p role="alert" class="rounded border border-border p-3">{ passwordResetError(p.Locale, p.Error) }</p>
				}
				if p.Error != "invalid" {
					<form class="grid gap-4" method="post" action="/auth/password-reset/confirm">
						<input type="hidden" name="_csrf" value={ p.CSRF } />
						<input type="hidden" name="token" value={ p.Token } />
						<input type="hidden" name="lang" value={ inviteAcceptLocale(p.Locale) } />
						if p.Locale == "tr" {
							<label class="grid gap-1">Yeni parola<input class="rounded border border-border bg-background p-2" name="password" type="password" autocomplete="new-password" minlength="8" maxlength="1024" required aria-label="Yeni parola" /></label>
							<label class="grid gap-1">Yeni parolayı doğrula<input class="rounded border border-border bg-background p-2" name="password_confirm" type="password" autocomplete="new-password" minlength="8" maxlength="1024" required aria-label="Yeni parolayı doğrula" /></label>
							<button class="ds-button ds-button--primary" type="submit">Parolayı yenile</button>
						} else {
							<label class="grid gap-1">New password<input class="rounded border border-border bg-background p-2" name="password" type="password" autocomplete="new-password" minlength="8" maxlength="1024" required aria-label="New password" /></label>
							<label class="grid gap-1">Confirm new password<input class="rounded border border-border bg-background p-2" name="password_confirm" type="password" autocomplete="new-password" minlength="8" maxlength="1024" required aria-label="Confirm new password" /></label>
							<button class="ds-button ds-button--primary" type="submit">Reset password</button>
						}
					</form>
				} else {
					<a class="underline underline-offset-4" href="/login">Return to sign in</a>
				}
				<script>history.replaceState(null, "", "/password-reset")</script>
			</main>
		</body>
	</html>
}

templ MFASettings(p MFASettingsProps) {
	<section class="studio-card mfa-settings" data-mfa-settings data-locale={ p.Locale } aria-labelledby="mfa-settings-title">
		<div>
			if p.Locale == "en" {
				<h2 id="mfa-settings-title" class="text-xl font-semibold">Authenticator app</h2>
				<p>Protect this account with a time-based code. Keep the recovery codes somewhere separate from this device.</p>
			} else {
				<h2 id="mfa-settings-title" class="text-xl font-semibold">Authenticator uygulaması</h2>
				<p>Hesabınızı süreli doğrulama koduyla koruyun. Kurtarma kodlarını bu cihazdan ayrı bir yerde saklayın.</p>
			}
		</div>
		<div data-mfa-state>
			if !p.StatusLoaded {
				<p role="status">{ mfaText(p.Locale, "status_error") }</p>
			} else if p.Enabled {
				<p role="status" class="mb-3">{ mfaText(p.Locale, "enabled") }</p>
				if p.Available {
					<form method="post" action="/auth/me/mfa/disable" data-mfa-disable class="studio-form">
						<input type="hidden" name="_csrf" value={ p.CSRF } />
						<label class="studio-form-field"><span>{ mfaText(p.Locale, "code_label") }</span><input type="text" name="code" inputmode="text" autocapitalize="characters" spellcheck="false" autocomplete="one-time-code" required aria-label={ mfaText(p.Locale, "code_label") } /></label>
						<button class="button button-quiet" type="submit" data-mfa-submit>{ mfaText(p.Locale, "disable") }</button>
					</form>
				} else {
					<p>{ mfaText(p.Locale, "unavailable_enabled") }</p>
				}
			} else if p.Available {
				<form method="post" action="/auth/me/mfa/enroll" data-mfa-enroll>
					<input type="hidden" name="_csrf" value={ p.CSRF } />
					<button class="button button-primary" type="submit" data-mfa-submit>{ mfaText(p.Locale, "setup") }</button>
				</form>
			} else {
				<p role="status">{ mfaText(p.Locale, "unavailable_setup") }</p>
			}
		</div>
		<div data-mfa-enrollment hidden>
			<div>
				<h3 class="font-semibold">{ mfaText(p.Locale, "connect") }</h3>
				<p>{ mfaText(p.Locale, "connect_help") }</p>
				<label class="studio-form-field"><span>{ mfaText(p.Locale, "secret") }</span><input readonly data-mfa-secret aria-label={ mfaText(p.Locale, "secret_label") } /></label>
				<a class="underline underline-offset-4" data-mfa-provisioning target="_blank" rel="noopener noreferrer">{ mfaText(p.Locale, "provisioning") }</a>
			</div>
			<div data-mfa-recovery-section>
				<h3 class="font-semibold">{ mfaText(p.Locale, "recovery_title") }</h3>
				<p>{ mfaText(p.Locale, "recovery_help") }</p>
				<ul data-mfa-recovery-codes></ul>
				<button type="button" class="button button-quiet" data-mfa-copy>{ mfaText(p.Locale, "copy") }</button>
				<label class="flex items-start gap-2"><input type="checkbox" data-mfa-recovery-saved required /><span>{ mfaText(p.Locale, "saved") }</span></label>
			</div>
			<form method="post" action="/auth/me/mfa/enable" data-mfa-enable class="studio-form">
				<input type="hidden" name="_csrf" value={ p.CSRF } />
			<label class="studio-form-field"><span>{ mfaText(p.Locale, "verify") }</span><input type="text" name="code" inputmode="numeric" autocomplete="one-time-code" required aria-label={ mfaText(p.Locale, "verify") } /></label>
			<button class="button button-primary" type="submit" data-mfa-submit disabled>{ mfaText(p.Locale, "enable") }</button>
			</form>
		</div>
		<p class="min-h-6" role="status" aria-live="polite" data-mfa-message></p>
		<noscript>
			if p.Locale == "en" {
				<p>JavaScript is required to display the one-time setup details securely.</p>
			} else {
				<p>Tek kullanımlık kurulum bilgilerini güvenli biçimde göstermek için JavaScript açık olmalıdır.</p>
			}
		</noscript>
		<script>
			const initializeMFASettings = () => {
				const root = document.querySelector("[data-mfa-settings]");
				if (!root || root.dataset.initialized === "true") return;
				root.dataset.initialized = "true";
				const message = root.querySelector("[data-mfa-message]");
				const csrf = () => decodeURIComponent((document.cookie.match(/(?:^|; )hydro_csrf=([^;]+)/) || [])[1] || "");
				const copy = async value => {
					if (navigator.clipboard && window.isSecureContext) return navigator.clipboard.writeText(value);
					const field = document.createElement("textarea"); field.value = value; field.setAttribute("readonly", ""); field.style.position = "fixed"; field.style.opacity = "0"; document.body.append(field); field.select();
					const copied = document.execCommand("copy"); field.remove(); if (!copied) throw new Error("copy");
				};
				const english = root.dataset.locale === "en";
				const messages = english ? {
					invalid: "The code is incorrect. Check the latest code and try again.", rate: "Too many attempts. Wait a moment and try again.", conflict: "MFA is already enabled. Refresh this page to see its current status.", forbidden: "Your session or permission has expired. Sign in again and retry.", generic: "The request could not be completed. Try again.", network: "Connection problem. Check your network and retry.", working: "Working…", enrolled: "Setup details are ready. Save your recovery codes before enabling MFA.", saved: "Save the recovery codes before continuing.", enabled: "MFA is enabled. Refreshing account security…", copied: "Recovery codes copied.", copyError: "Copy failed. Select the codes and copy them manually."
				} : {
					invalid: "Kod geçersiz. Güncel kodu kontrol edip yeniden deneyin.", rate: "Çok fazla deneme yapıldı. Biraz bekleyip yeniden deneyin.", conflict: "MFA zaten açık. Güncel durumu görmek için sayfayı yenileyin.", forbidden: "Oturum veya yetki süresi doldu. Yeniden giriş yapıp tekrar deneyin.", generic: "İşlem tamamlanamadı. Yeniden deneyin.", network: "Bağlantı sorunu oluştu. Ağınızı kontrol edip yeniden deneyin.", working: "İşlem sürüyor…", enrolled: "Kurulum bilgileri hazır. MFA'yı açmadan önce kurtarma kodlarınızı kaydedin.", saved: "Devam etmeden önce kurtarma kodlarını kaydedin.", enabled: "MFA açıldı. Hesap güvenliği yenileniyor…", copied: "Kurtarma kodları kopyalandı.", copyError: "Kopyalama başarısız oldu. Kodları seçip elle kopyalayın."
				};
				const errorText = status => {
					if (status === 401) return messages.invalid;
					if (status === 429) return messages.rate;
					if (status === 409) return messages.conflict;
					if (status === 403) return messages.forbidden;
					return messages.generic;
				};
				const submit = async (form, onSuccess) => {
					const button = form.querySelector("[data-mfa-submit]"); if (button) { button.disabled = true; button.setAttribute("aria-busy", "true"); }
					message.setAttribute("role", "status"); message.textContent = messages.working;
					try {
						const body = new URLSearchParams();
						for (const [key, value] of new FormData(form)) if (typeof value === "string") body.append(key, value);
						const response = await fetch(form.action, { method: "POST", body, credentials: "same-origin", headers: { "X-CSRF-Token": csrf(), "Accept": "application/json" } });
						if (!response.ok) { message.setAttribute("role", "alert"); message.textContent = errorText(response.status); return; }
						await onSuccess(response);
				} catch (_) { message.setAttribute("role", "alert"); message.textContent = messages.network; }
					finally { if (button) { button.disabled = false; button.removeAttribute("aria-busy"); } }
				};
				const enroll = root.querySelector("[data-mfa-enroll]");
				if (enroll) enroll.addEventListener("submit", event => { event.preventDefault(); submit(enroll, async response => {
					const data = await response.json();
					if (!data.Secret || !data.Provisioning || !Array.isArray(data.RecoveryCodes)) throw new Error("enrollment");
					root.querySelector("[data-mfa-enrollment]").hidden = false;
					root.querySelector("[data-mfa-state]").hidden = true;
					root.querySelector("[data-mfa-secret]").value = data.Secret;
					const provisioning = new URL(data.Provisioning, location.href);
					if (provisioning.protocol !== "otpauth:") throw new Error("provisioning URI");
					const link = root.querySelector("[data-mfa-provisioning]"); link.href = provisioning.href;
					const list = root.querySelector("[data-mfa-recovery-codes]"); list.replaceChildren();
					for (const code of data.RecoveryCodes) { const item = document.createElement("li"); item.textContent = code; list.append(item); }
					message.textContent = messages.enrolled;
				}); });
				const enable = root.querySelector("[data-mfa-enable]");
				if (enable) {
					const saved = root.querySelector("[data-mfa-recovery-saved]"), button = enable.querySelector("[data-mfa-submit]");
					saved.addEventListener("change", () => { button.disabled = !saved.checked; });
					enable.addEventListener("submit", event => { event.preventDefault(); if (!saved.checked) { message.textContent = messages.saved; return; } submit(enable, async () => { message.textContent = messages.enabled; window.location.reload(); }); });
				}
				const disable = root.querySelector("[data-mfa-disable]");
				if (disable) disable.addEventListener("submit", event => { event.preventDefault(); submit(disable, async () => window.location.reload()); });
				const copyButton = root.querySelector("[data-mfa-copy]");
				if (copyButton) copyButton.addEventListener("click", async () => { const codes = [...root.querySelectorAll("[data-mfa-recovery-codes] li")].map(item => item.textContent).join("\n"); try { await copy(codes); message.textContent = messages.copied; } catch (_) { message.textContent = messages.copyError; } });
			};
			if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", initializeMFASettings, { once: true });
			else initializeMFASettings();
		</script>
	</section>
}

templ InviteAcceptForm(p InviteAcceptFormProps) {
	<html lang={ inviteAcceptLocale(p.Locale) }>
		<head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{ inviteAcceptTitle(p.Locale) }</title><link rel="stylesheet" href="/designsystem/static/designsystem.css"/></head>
		<body class="grid min-h-screen place-items-center bg-background p-4 text-foreground">
		<main class="mx-auto grid w-full max-w-md gap-4 rounded-xl border border-border bg-surface p-6 text-foreground" aria-labelledby="invite-accept-title">
		if p.Locale == "tr" {
			<h1 id="invite-accept-title" class="text-2xl font-bold">Hesabını oluştur</h1>
			<p>Yönetici davetini tamamlamak için güvenli bir parola belirle.</p>
		} else {
			<h1 id="invite-accept-title" class="text-2xl font-bold">Set up your account</h1>
			<p>Choose a secure password to accept your administrator’s invitation.</p>
		}
		if p.Error != "" {
			<p role="alert" class="rounded border border-border p-3">
				{ inviteAcceptError(p.Locale, p.Error) }
			</p>
		}
		<form class="grid gap-4" method="post" action="/auth/invites/accept">
			<input type="hidden" name="_csrf" value={ p.CSRF } />
			<input type="hidden" name="token" value={ p.Token } />
			<input type="hidden" name="lang" value={ p.Locale } />
			if p.Locale == "tr" {
				<label class="grid gap-1">Parola<input class="rounded border border-border bg-background p-2" name="password" type="password" autocomplete="new-password" minlength="12" maxlength="1024" required aria-label="Parola" /></label>
				<label class="grid gap-1">Parolayı doğrula<input class="rounded border border-border bg-background p-2" name="password_confirm" type="password" autocomplete="new-password" minlength="12" maxlength="1024" required aria-label="Parolayı doğrula" /></label>
				<button class="ds-button ds-button--primary" type="submit">Davetimi kabul et</button>
			} else {
				<label class="grid gap-1">Password<input class="rounded border border-border bg-background p-2" name="password" type="password" autocomplete="new-password" minlength="12" maxlength="1024" required aria-label="Password" /></label>
				<label class="grid gap-1">Confirm password<input class="rounded border border-border bg-background p-2" name="password_confirm" type="password" autocomplete="new-password" minlength="12" maxlength="1024" required aria-label="Confirm password" /></label>
				<button class="ds-button ds-button--primary" type="submit">Accept invitation</button>
			}
		</form>
		<script>history.replaceState(null, "", "/auth/invites/accept")</script>
		</main>
		</body>
	</html>
}
