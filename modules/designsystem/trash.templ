package designsystem

import (
	"net/url"

	"github.com/ardaozyildirim/hydrogo/internal/trash"
)

templ TrashNavLink(active bool) {
	if active {
		<a class="nav-item active" href="/admin/trash" aria-current="page">Çöp kutusu</a>
	} else {
		<a class="nav-item" href="/admin/trash">Çöp kutusu</a>
	}
}

templ TrashPage(items []trash.Entry, csrf string) {
	<main class="mx-auto max-w-5xl p-6 text-foreground">
		<h1 class="mb-2 text-2xl font-semibold">Çöp kutusu</h1>
		<p class="mb-6 text-muted-foreground">Silinen öğeler 30 gün boyunca geri yüklenebilir.</p>
		if len(items) == 0 {
			<p class="rounded border border-border bg-surface p-6">Gösterilecek içerik yok.</p>
		} else {
			<div class="overflow-x-auto rounded border border-border bg-surface">
				<table class="w-full text-left">
					<thead><tr><th class="p-3">Tür</th><th class="p-3">Öğe</th><th class="p-3">Durum</th><th class="p-3">İşlem</th></tr></thead>
					<tbody>
						for _, item := range items {
							<tr class="border-t border-border">
								<td class="p-3">{ trashLabel(item.Kind) }</td>
								<td class="p-3">{ item.Label }</td>
								if item.Trashed {
									<td class="p-3"><time datetime={ item.DeletedAt.UTC().Format("2006-01-02T15:04:05Z07:00") }>{ item.DeletedAt.UTC().Format("2006-01-02 15:04 UTC") }</time></td>
									<td class="p-3"><form method="post" action={ trashActionPath(item.Kind, item.ID, true) }><input type="hidden" name="_csrf" value={ csrf }/><button class="rounded bg-primary px-3 py-2 text-primary-foreground" type="submit">Geri yükle</button></form></td>
								} else {
									<td class="p-3">Etkin</td>
									<td class="p-3"><form method="post" action={ trashActionPath(item.Kind, item.ID, false) }><input type="hidden" name="_csrf" value={ csrf }/><button class="rounded border border-border px-3 py-2" type="submit">Çöp kutusuna taşı</button></form></td>
								}
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</main>
}

func trashLabel(kind trash.Kind) string {
	switch kind {
	case trash.Pages: return "Page"
	case trash.News: return "News"
	case trash.Submissions: return "Form submission"
	case trash.Media: return "Media"
	default: return "Item"
	}
}

func trashActionPath(kind trash.Kind, id string, restore bool) string {
	action := "delete"
	if restore {
		action = "restore"
	}
	return "/admin/trash/" + url.PathEscape(string(kind)) + "/" + url.PathEscape(id) + "/" + action
}
