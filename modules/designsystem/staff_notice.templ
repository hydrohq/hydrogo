package designsystem

templ StaffNoticeNavLink() {
	<a class="nav-item" href="/admin/site/broadcast"><span class="nav-icon">●</span><span>Staff notice</span></a>
}

templ StaffBroadcastNotice(message, severity, dismissKey string) {
	<div class={ StaffBroadcastNoticeClass(severity) } role={ StaffBroadcastNoticeRole(severity) } data-staff-notice={ dismissKey }>
		<p>{ message }</p>
		<button class="button button-quiet" type="button" data-staff-notice-dismiss aria-label="Dismiss staff notice">Dismiss</button>
	</div>
}

templ StaffBroadcastNoticeEditor(active bool, severity, message, expiresAt, csrf string) {
	<section class="studio-card"><h1>Staff broadcast notice</h1><p>Share a short notice with signed-in staff. It disappears when dismissed or expired.</p>
	<form class="studio-form mt-6 grid gap-4" method="post" action="/admin/site/broadcast">
		<input type="hidden" name="_csrf" value={ csrf }/>
		<label class="flex items-center gap-2"><input type="checkbox" name="active" value="true" checked?={ active }/> Publish notice</label>
		<label class="grid gap-1">Severity<select name="severity"><option value="info" selected?={ severity == "info" }>Information</option><option value="warning" selected?={ severity == "warning" }>Warning</option><option value="critical" selected?={ severity == "critical" }>Critical</option></select></label>
		<label class="grid gap-1">Message<textarea name="message" maxlength="1000" rows="4" required>{ message }</textarea></label>
		<label class="grid gap-1">Expires at (UTC)<input type="datetime-local" name="expires_at" value={ expiresAt } required/></label>
		<button class="button button-primary" type="submit">Save notice</button>
	</form></section>
}
