package designsystem

templ AuthenticatorChallenge() {
	<section id="mfa-challenge" class="mt-4 rounded-lg border border-slate-200 bg-white p-4 text-slate-900 shadow-sm dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100" aria-labelledby="mfa-challenge-title" hidden>
		<h2 id="mfa-challenge-title" class="text-base font-semibold">İki adımlı doğrulama</h2>
		<p class="mt-1 text-sm text-slate-600 dark:text-slate-300">Authenticator uygulamanızdaki güncel kodu veya kurtarma kodlarından birini girin.</p>
		<label class="mt-3 block text-sm font-medium" for="login-mfa-code">Doğrulama kodu</label>
		<input id="login-mfa-code" class="mt-1 block w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-base tracking-widest text-slate-900 dark:border-slate-600 dark:bg-slate-800 dark:text-white" name="mfa_code" type="text" inputmode="numeric" maxlength="64" autocomplete="one-time-code" aria-describedby="mfa-countdown" disabled />
		<p id="mfa-countdown" class="mt-2 text-sm text-slate-600 dark:text-slate-300" aria-live="polite" data-mfa-countdown></p>
		<button class="mt-2 rounded-md border border-slate-300 px-3 py-2 text-sm font-medium disabled:cursor-not-allowed disabled:opacity-50 dark:border-slate-600" type="button" data-mfa-next disabled>Sonraki kodu kullan</button>
	</section>
}
