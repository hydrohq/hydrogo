package designsystem

templ LocalePicker(p LocalePickerProps) {
	if len(p.Locales) > 1 {
		<form class="fixed right-4 top-4 z-10 flex items-center gap-2 rounded-lg border border-border bg-surface p-2 text-sm text-foreground shadow" action="/" method="get" aria-label="Language selection">
			<label for="hydro-locale">Language</label>
			<select id="hydro-locale" name="locale">
				for _, locale := range p.Locales {
					<option value={ locale } selected?={ locale == p.Selected }>{ locale }</option>
				}
			</select>
			<button class="rounded bg-primary px-3 py-1 text-primary-foreground" type="submit">Apply</button>
		</form>
	}
}

templ Callout(p CalloutProps) {
	<aside class={ "ds-callout ds-callout--" + calloutTone(p.Tone) } role="note" data-block="callout">
		<strong>{ p.Title }</strong><p>{ p.Text }</p>
	</aside>
}

templ ActionCard(p ActionCardProps) {
	<aside class="ds-action-card bg-surface text-foreground" data-block="action_card">
		<div><h2>{ p.Title }</h2><p>{ p.Text }</p></div>
		if href := safeLink(p.ButtonURL); href != "" && p.ButtonText != "" {
			<a class="ds-button ds-button--primary" href={ href }>{ p.ButtonText }</a>
		}
	</aside>
}

templ ImageCarousel(p CarouselProps) {
	<section id={ safeID(p.ID) } class="ds-carousel bg-surface text-foreground" aria-label={ label(p.Label, "Image carousel") } data-block="carousel">
		<div class="ds-carousel__track" tabindex="0" aria-label="Swipe or use arrow keys to browse images">
			for _, slide := range p.Slides {
				<figure class="ds-carousel__slide"><img src={ validMediaURL(slide.Src) } alt={ slide.Alt } loading="lazy" />
					if slide.Caption != "" {
						<figcaption>{ slide.Caption }</figcaption>
					}
				</figure>
			}
		</div>
	</section>
}

templ ColumnLayout(p ColumnsProps) {
	<div class={ "ds-columns ds-columns--" + fmtPosition(layoutCount(p.Count)) } data-block="columns">
		for _, column := range p.Columns {
			<section class="ds-columns__item bg-surface text-foreground"><h2>{ column.Title }</h2><p>{ column.Text }</p>
				if href := safeLink(column.ButtonURL); href != "" && column.ButtonText != "" {
					<a class="ds-button ds-button--secondary" href={ href }>{ column.ButtonText }</a>
				}
			</section>
		}
	</div>
}

templ FeatureList(p FeatureListProps) {
	<section class="ds-feature-list bg-background text-foreground" data-block="feature_list">
		if p.Heading != "" {
			<h2>{ p.Heading }</h2>
		}
		<ul class={ featureListClass(p.Checklist) }>
			for _, item := range p.Items {
				<li><span class="ds-feature-list__icon" aria-hidden="true">{ iconText(item.Icon) }</span><span><strong>{ item.Title }</strong><br />{ item.Text }</span></li>
			}
		</ul>
	</section>
}

templ VideoHero(p VideoHeroProps) {
	<section class="ds-video-hero" data-block="video_hero">
		if src := validMediaURL(p.VideoURL); src != "" {
			<video class="ds-video-hero__media" autoplay muted loop playsinline preload="metadata" poster={ validMediaURL(p.PosterURL) }><source src={ src } type="video/mp4" /></video>
		}
		<div class="ds-video-hero__content"><h1>{ p.Title }</h1>
			if p.Subtitle != "" {
				<p>{ p.Subtitle }</p>
			}
			if href := safeLink(p.ButtonURL); href != "" && p.ButtonText != "" {
				<a class="ds-button ds-button--primary" href={ href }>{ p.ButtonText }</a>
			}
		</div>
	</section>
}

templ TrustBar(p TrustBarProps) {
	<section class="ds-trust-bar bg-surface text-foreground" data-block="trust_bar" aria-label={ label(p.Heading, "Trust and guarantees") }>
		if p.Heading != "" {
			<h2>{ p.Heading }</h2>
		}
		<ul>
			for _, item := range p.Items {
				<li><span aria-hidden="true">{ iconText(item.Icon) }</span><div><strong>{ item.Title }</strong><small>{ item.Subtitle }</small></div></li>
			}
		</ul>
	</section>
}

templ SemanticFigure(p FigureProps) {
	<figure class="ds-figure" data-block="figure"><img src={ validMediaURL(p.Src) } alt={ p.Alt } loading="lazy" />
		if p.Caption != "" || p.Credit != "" {
			<figcaption>{ p.Caption }
				if p.Credit != "" {
					<span class="ds-figure__credit">{ p.Credit }
						if href := safeLink(p.CreditURL); href != "" {
							<a href={ href } rel="license noopener noreferrer">Source</a>
						}
					</span>
				}
			</figcaption>
		}
	</figure>
}

templ BusinessStatusBadge(p BusinessStatusProps) {
	<span class={ "ds-business-status ds-business-status--" + map[bool]string{true:"open", false:"closed"}[p.Open] } role="status"><span aria-hidden="true"></span>
		{ businessStatusLabel(p) }
		if p.Hours != "" {
			<small>{ p.Hours }</small>
		}
	</span>
}
