package designsystem

import "github.com/ardaozyildirim/hydrogo/internal/ai"

type AIInboxOption struct{ ID, Label string }

templ AIAssistantRequest(action, csrf string, locales []string) {
	<section class="studio-card mt-4" data-ai-assistant>
		<h2>Taslak yardımcısı</h2>
		<p>Öneri almak için içerik, yapılandırılmış yapay zekâ sağlayıcısına gönderilir. Öneri incelenmeden kaydedilmez veya yayımlanmaz.</p>
		<form method="post" action={ action } class="mt-3 flex flex-wrap items-end gap-3">
			<input type="hidden" name="_csrf" value={ csrf } />
			<label class="grid gap-1">Yardım türü
				<select name="operation"><option value="refine">Metni iyileştir</option><option value="seo">Başlık ve metni SEO için düzenle</option><option value="summary">Metni kısalt</option><option value="translate">Başka dile çevir</option></select>
			</label>
			<label class="grid gap-1">Hedef dil
				<select name="target_locale"><option value="">Seçin</option>
					for _, locale := range locales {
						<option value={ locale }>{ locale }</option>
					}
				</select>
			</label>
			<label class="grid gap-1">Üslup
				<select name="tone"><option value="professional">Profesyonel</option><option value="concise">Öz</option><option value="friendly">Samimi</option></select>
			</label>
			<label class="flex max-w-xl items-start gap-2 text-sm"><input type="checkbox" name="consent" value="yes" required />Bu işlemde taslak içeriğin sağlayıcıya gönderilmesini onaylıyorum.</label>
			<button type="submit" class="rounded bg-primary px-3 py-2 text-primary-foreground">Öneri oluştur</button>
		</form>
	</section>
}

templ AIInboxSummary(options []AIInboxOption, action, csrf, summary string) {
	<section class="studio-card mt-4" data-ai-inbox-summary>
		<h2>Gelen talep özeti</h2>
		<p>Seçilen form yanıtı, açık onayınızla yapılandırılmış sağlayıcıya gönderilir. Özet kaydedilmez.</p>
		<form method="post" action={ action } class="mt-3 flex flex-wrap items-end gap-3">
			<input type="hidden" name="_csrf" value={ csrf } />
			<label class="grid gap-1">Form yanıtı
				<select name="submission_id" required><option value="">Seçin</option>
					for _, option := range options {
						<option value={ option.ID }>{ option.Label }</option>
					}
				</select>
			</label>
			<label class="flex max-w-xl items-start gap-2 text-sm"><input type="checkbox" name="consent" value="yes" required />Bu form yanıtının sağlayıcıya gönderilmesini onaylıyorum.</label>
			<button type="submit" class="rounded bg-primary px-3 py-2 text-primary-foreground">Yanıtı özetle</button>
		</form>
		if summary != "" {
			<div class="mt-4 rounded border border-border p-4"><h3 class="font-semibold">Özet</h3><p class="whitespace-pre-wrap">{ summary }</p></div>
		}
	</section>
}

templ AIAssistantSuggestion(beforeTitle, beforeBody string, suggestion ai.Suggestion, auditAction, csrf string) {
	<section class="studio-card mt-4" data-ai-suggestion>
		<h2>Yapay zekâ önerisi</h2>
		<p>Bu içerik yalnızca taslak düzenleyiciye aktarılır. Kaydetme ve yayımlama işlemleri size aittir.</p>
		<div class="mt-3 grid gap-3 md:grid-cols-2">
			<article class="rounded border border-border p-3"><h3 class="font-semibold">Mevcut taslak</h3><p>{ beforeTitle }</p><pre class="whitespace-pre-wrap">{ beforeBody }</pre></article>
			<article class="rounded border border-border p-3"><h3 class="font-semibold">Öneri</h3><p data-ai-title>{ suggestion.Title }</p><pre class="whitespace-pre-wrap" data-ai-body>{ suggestion.Body }</pre></article>
		</div>
		<button type="button" class="mt-3 rounded bg-primary px-3 py-2 text-primary-foreground" data-ai-apply data-audit-action={ auditAction } data-csrf={ csrf }>Öneriyi taslağa aktar</button>
		<p class="mt-2" role="status" aria-live="polite" data-ai-apply-status></p>
		<script>
			document.querySelectorAll('[data-ai-apply]').forEach(function(button){
				button.addEventListener('click', function(){
					var panel=button.closest('[data-ai-suggestion]');
					var title=document.querySelector('input[name="title"]');
					var body=document.querySelector('[data-richtext] .richtext-value');
					var editor=document.querySelector('[data-richtext] .richtext-editor');
					var nextTitle=panel.querySelector('[data-ai-title]').textContent;
					var nextBody=panel.querySelector('[data-ai-body]').textContent;
					if(title && nextTitle) { title.value=nextTitle; title.dispatchEvent(new Event('input',{bubbles:true})); }
					if(editor && editor.__quill) { editor.__quill.setText(nextBody); }
					else if(body) { body.value=nextBody; body.dispatchEvent(new Event('input',{bubbles:true})); }
					button.textContent='Taslak düzenleyici güncellendi';
					fetch(button.dataset.auditAction,{method:'POST',headers:{'X-CSRF-Token':button.dataset.csrf}}).then(function(response){
						if(!response.ok) throw new Error();
					}).catch(function(){
						panel.querySelector('[data-ai-apply-status]').textContent='Taslak güncellendi ancak işlem denetim kaydı tamamlanamadı.';
					});
				});
			});
		</script>
	</section>
}
