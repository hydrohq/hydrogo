package designsystem

templ CookieNotice(p CookieNoticeProps) {
	<section class={ "ds-cookie-notice ds-cookie-notice--" + cookieVariant(p.Variant) + " bg-surface text-foreground" } data-cookie-notice aria-label={ label(p.Heading, "Cookie preferences") }>
		<div><h2>{ label(p.Heading, "Gizlilik tercihleriniz") }</h2><p>{ p.Message }</p></div>
		<form method="post" action={ safeConsentAction(p.Action) }>
			<input type="hidden" name="_csrf" value={ p.CSRF }/>
			<button class="ds-button ds-button--primary" type="submit" name="choice" value="accepted" data-cookie-choice="accepted">{ label(p.AcceptLabel, "Kabul et") }</button>
			<button class="ds-button ds-button--secondary" type="submit" name="choice" value="rejected" data-cookie-choice="rejected">{ label(p.RejectLabel, "Reddet") }</button>
		</form>
	</section>
}

templ ResponsiveDataTable(p DataTableProps) {
	<div class="ds-responsive-table" role="region" aria-label={ p.Caption } tabindex="0">
		<table>
			<caption>{ p.Caption }</caption>
			<thead><tr>
				for _, column := range p.Columns {
					<th scope="col">{ column }</th>
				}
			</tr></thead>
			<tbody>
				for _, row := range p.Rows {
					<tr>
						for index := range p.Columns {
							<td>{ tableValue(row, index) }</td>
						}
					</tr>
				}
			</tbody>
		</table>
	</div>
}

templ SocialPhotoGrid(p SocialPhotoGridProps) {
	<section class="ds-social-grid bg-background text-foreground" aria-label={ label(p.Label, "Social photos") }>
		for _, photo := range p.Photos {
			if safe := validMediaURL(photo.Image); safe != "" {
				<figure><img src={ safe } alt={ photo.Alt } loading="lazy"/>
					if href := safeLink(photo.URL); href != "" {
						<a href={ href } target="_blank" rel="noopener noreferrer">{ label(p.Label, "View photo") }</a>
					}
				</figure>
			}
		}
	</section>
}

templ ReadingTimeLabel(value string) {
	<span class="ds-reading-time">{ formatReadingTime(ReadingTime(value)) }</span>
}

templ SmartTypographyText(value string) {
	<span class="ds-smart-typography">{ SmartTypography(value) }</span>
}
