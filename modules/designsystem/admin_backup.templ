package designsystem

type AdminBackupPageProps struct {
	CSRF string
	Locale string
	Recent []AdminBackupItem
	CloudEnabled bool
	PublicKey string
}

type AdminBackupItem struct {
	Name string
	Created string
	Size string
}

templ AdminBackupPage(p AdminBackupPageProps) {
	<section class="mx-auto max-w-3xl space-y-5 p-4 text-foreground">
		<header>
			if p.Locale == "en" {
				<h1 class="text-2xl font-semibold">Full site backup</h1>
				<p class="mt-2 text-sm">Create a consistent copy of the database and uploaded files.</p>
			} else {
				<h1 class="text-2xl font-semibold">Tam site yedeği</h1>
				<p class="mt-2 text-sm">Veritabanı ve yüklenen dosyaların tutarlı bir kopyasını oluşturun.</p>
			}
		</header>
		<div class="rounded-lg border border-border bg-surface p-5">
			if p.PublicKey == "" {
				if p.Locale == "en" {
					<p role="status">Backup signing is not configured. Check the installation settings.</p>
				} else {
					<p role="status">Yedek imzalama yapılandırılmamış. Kurulum ayarlarını kontrol edin.</p>
				}
			} else {
				<form method="post" action="/admin/backup" class="grid gap-4">
					<input type="hidden" name="_csrf" value={ p.CSRF }/>
					<label class="grid gap-2 text-sm" for="backup-password">
						if p.Locale == "en" {
							<span>Confirm your password to continue</span>
						} else {
							<span>Devam etmek için parolanızı doğrulayın</span>
						}
						<input id="backup-password" class="min-h-10 rounded border border-border bg-background px-3" type="password" name="password" autocomplete="current-password" required/>
					</label>
					<button class="button button-primary w-fit" type="submit">
						if p.Locale == "en" {
							Create and download backup
						} else {
							Yedeği oluştur ve indir
						}
					</button>
				</form>
				<details class="mt-5 text-sm">
					<summary>
						if p.Locale == "en" {
							Backup verification key
						} else {
							Yedek doğrulama anahtarı
						}
					</summary>
					<p class="mt-2">
						if p.Locale == "en" {
							Keep this public key with the downloaded backup. Pass it to <code>hydro restore unpack --public-key</code> when verifying the archive.
						} else {
							Bu açık anahtarı indirilen yedekle birlikte saklayın. Arşivi doğrularken <code>hydro restore unpack --public-key</code> komutuna verin.
						}
					</p>
					<code class="block break-all rounded border border-border p-3">{ p.PublicKey }</code>
				</details>
			}
		</div>
		<section class="rounded-lg border border-border bg-surface p-5" aria-labelledby="backup-history-title">
			<h2 id="backup-history-title" class="text-lg font-semibold">
				if p.Locale == "en" {
					Recent scheduled backups
				} else {
					Zamanlanmış yedekler
				}
			</h2>
			if !p.CloudEnabled {
				<p class="mt-2 text-sm">
					if p.Locale == "en" {
						Scheduled cloud backups are not configured.
					} else {
						Bulut üzerinden zamanlanmış yedekleme ayarlanmamış.
					}
				</p>
			} else if len(p.Recent) == 0 {
				<p class="mt-2 text-sm">
					if p.Locale == "en" {
						No recent scheduled backups were found.
					} else {
						Yakın zamanda zamanlanmış yedek bulunamadı.
					}
				</p>
			} else {
				<ul class="mt-3 divide-y divide-border">
					for _, item := range p.Recent {
						<li class="flex flex-wrap justify-between gap-2 py-2 text-sm"><span>{ item.Name }</span><span>{ item.Created } · { item.Size }</span></li>
					}
				</ul>
			}
		</section>
	</section>
}
