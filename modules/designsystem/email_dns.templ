package designsystem

templ EmailDNSChecks(checks []EmailDNSCheck) {
	<section class="studio-card" aria-labelledby="email-dns-title">
		<h2 id="email-dns-title">Email domain checks</h2>
		<ul class="studio-check-list">
			for _, check := range checks {
				<li>
					<strong>{ check.Name }</strong>
					if check.OK {
						<span role="status">Verified</span>
					} else {
						<span role="status">Needs attention</span>
					}
					if check.Detail != "" {
						<p>{ check.Detail }</p>
					}
					if check.Guidance != "" {
						<p>{ check.Guidance }</p>
					}
				</li>
			}
		</ul>
	</section>
}
