package designsystem

templ CustomCodeNavLink() {
	<a class="nav-item" href="/admin/site/custom-code"><span class="nav-icon">&lt;/&gt;</span><span>Custom code</span></a>
}

templ CustomCodeEditor(head, body, csrf string) {
	<section class="studio-card">
		<h1>Custom site integrations</h1>
		<p>Only approved Google, Meta, Hotjar, and Zendesk sources are accepted. Changes affect public pages after saving.</p>
		<form class="studio-form mt-6 grid gap-4" method="post" action="/admin/site/custom-code">
			<input type="hidden" name="_csrf" value={ csrf }/>
			<label class="grid gap-1">Head code<textarea name="custom_head_code" rows="10" maxlength="16384" class="w-full font-mono">{ head }</textarea></label>
			<label class="grid gap-1">Before closing body<textarea name="custom_body_end_code" rows="10" maxlength="16384" class="w-full font-mono">{ body }</textarea></label>
			<button class="button button-primary" type="submit">Save integration code</button>
		</form>
	</section>
}
