package designsystem

templ MaintenancePage(headline, message string) {
	<!doctype html>
	<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{ headline }</title><link rel="stylesheet" href="/designsystem/static/designsystem.css"/></head>
	<body class="min-h-screen bg-background text-foreground"><main class="mx-auto grid min-h-screen max-w-2xl content-center justify-items-center gap-5 px-6 py-12 text-center"><h1 class="text-4xl font-bold">{ headline }</h1><p class="max-w-prose text-lg text-muted-foreground">{ message }</p></main></body></html>
}

templ MaintenanceEditor(enabled bool, allowlist, csrf string) {
	<section class="studio-card"><h1>Maintenance mode</h1><p>Visitors see a short notice while staff can continue working.</p>
	<form class="studio-form mt-6 grid gap-4" method="post" action="/admin/site/maintenance"><input type="hidden" name="_csrf" value={ csrf }/>
	<label class="flex items-center gap-2"><input type="checkbox" name="enabled" value="true" checked?={ enabled }/> Enable maintenance mode</label>
	<label class="grid gap-1">Allowed IP addresses or networks<textarea class="rounded border border-border bg-surface p-2" name="allowlist" rows="4" placeholder="192.0.2.10 or 192.0.2.0/24">{ allowlist }</textarea></label>
	<button class="button button-primary" type="submit">Save maintenance settings</button></form></section>
}
