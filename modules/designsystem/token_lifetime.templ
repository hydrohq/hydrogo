package designsystem

templ TokenLifetimeLink() {
	<p><a class="button button-quiet" href="/admin/security/token-lifetimes">Configure password reset and invitation expiration</a></p>
}

templ TokenLifetimeForm(p TokenLifetimeFormProps) {
	<section class="studio-card">
		<h1>Security link expiration</h1>
		<p>New password reset links and invitations will use these lifetimes. Existing links keep their original expiration.</p>
		<form method="post" action="/admin/security/token-lifetimes" class="studio-form">
			<input type="hidden" name="_csrf" value={ p.CSRF }/>
			<label>Password reset link
				<select name="password_reset_ttl">
					<option value="15m" selected?={ p.Reset == "15m0s" }>15 minutes</option>
					<option value="1h" selected?={ p.Reset == "1h0m0s" }>1 hour</option>
					<option value="24h" selected?={ p.Reset == "24h0m0s" }>24 hours</option>
				</select>
			</label>
			<label>Invitation link
				<select name="invitation_ttl">
					<option value="24h" selected?={ p.Invitation == "24h0m0s" }>1 day</option>
					<option value="72h" selected?={ p.Invitation == "72h0m0s" }>3 days</option>
					<option value="168h" selected?={ p.Invitation == "168h0m0s" }>7 days</option>
				</select>
			</label>
			<button class="button button-primary" type="submit">Save lifetimes</button>
		</form>
		if p.Saved {
			<p role="status">Security link lifetimes saved.</p>
		}
	</section>
}
