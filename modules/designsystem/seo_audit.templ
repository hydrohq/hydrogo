package designsystem

templ SEOAudit() {
	<section class="studio-card seo-audit" data-seo-audit hidden aria-label="SEO içerik denetimi" aria-live="polite">
		<h2>SEO içerik denetimi</h2>
		<ul>
			<li data-seo-title>Başlık uzunluğu: denetleniyor</li>
			<li data-seo-description>Arama açıklaması: denetleniyor</li>
			<li data-seo-heading>Başlık yapısı: denetleniyor</li>
			<li data-seo-alt>Görsel açıklamaları: denetleniyor</li>
			<li data-seo-readability>Okunabilirlik: denetleniyor</li>
		</ul>
	</section>
}
