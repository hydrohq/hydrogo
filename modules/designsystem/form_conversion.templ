package designsystem

import "strconv"

templ FormConversionMetrics(rows []FormConversionMetric) {
	<section class="studio-card mt-4" aria-labelledby="form-conversion-heading">
		<h2 id="form-conversion-heading">Form performance · last 30 days</h2>
		<div class="mt-4 grid gap-3 md:grid-cols-2">
			for _, row := range rows {
				<article class="rounded-md border border-border bg-surface p-4">
					<h3 class="font-semibold">{ row.Title }</h3>
					if row.Views > 0 {
						<p class="mt-1 text-sm text-muted-foreground">Viewed { strconv.FormatInt(row.Views, 10) } times · { strconv.FormatInt(row.Submissions, 10) } submissions · { FormConversionPercentage(row.ConversionPercent) } conversion</p>
					} else {
						<p class="mt-1 text-sm text-muted-foreground">No privacy-safe views recorded yet</p>
					}
					<div class="mt-3 flex h-12 items-end gap-1" role="img" aria-label={ row.Title + " submissions over the last 30 days" }>
						for _, day := range row.Trend {
							<span class={ FormTrendBarClass(day.Submissions, row.Trend) } title={ day.Day + ": " + strconv.FormatInt(day.Submissions, 10) + " submissions" }></span>
						}
					</div>
				</article>
			}
		</div>
	</section>
}
