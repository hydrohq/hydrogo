package team
import (
 "github.com/ardaozyildirim/hydrogo/internal/sectoral"
)
templ Collection(items []Member) {
<section class="sectoral-collection bg-background text-foreground" data-module="team">
 for _, item := range items {
  if item.Status == "published" {
   <article class="sectoral-card bg-surface border-border"><h2>{ item.Title }</h2><p>{ item.Role }</p>
   if item.Biography != "" {
	<p>{ item.Biography }</p>
   }
   if item.PhotoURL != "" {
	<img src={ templ.SafeURL(sectoral.SanitizeWebURL(item.PhotoURL)) } alt={ item.Title } loading="lazy"/>
   }
   for _, link := range item.SocialLinks {
	<a href={ templ.SafeURL(sectoral.SanitizeWebURL(link.URL)) } rel="noopener noreferrer">{ link.Label }</a>
   }
   </article>
  }
 }
</section>
}
