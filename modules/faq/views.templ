package faq

templ Collection(items []Question) {
<section class="sectoral-faq bg-background text-foreground" data-module="faq" aria-label="Sıkça sorulan sorular">
 <label>Sorularda ara<input type="search" data-faq-search autocomplete="off"/></label>
 for _, item := range items {
  if item.Status == "published" {
   <article class="sectoral-card" data-faq-item><h2>{ item.Category }</h2><details><summary>{ item.QuestionText }</summary><div>{ item.Answer }</div></details></article>
  }
 }
</section>
}
