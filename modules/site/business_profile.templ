package site

import "time"

templ BusinessProfileView(profile BusinessProfile, openNow bool) {
	<section class="business-profile bg-surface text-foreground" aria-label="İşletme bilgileri">
		<h2>{ profile.Name }</h2>
		<address>{ profile.Address }</address>
		if profile.Phone != "" {
			<p><a href={ "tel:" + profile.Phone }>{ profile.Phone }</a></p>
		}
		if profile.Email != "" {
			<p><a href={ "mailto:" + profile.Email }>{ profile.Email }</a></p>
		}
		if openNow {
			<p role="status">Şu anda açığız</p>
		} else {
			<p role="status">Şu anda kapalıyız</p>
		}
		<ul aria-label="Çalışma saatleri">
			for day := time.Sunday; day <= time.Saturday; day++ {
				if hours, ok := profile.Hours[day]; ok {
					<li>{ day.String() } · { businessHoursLabel(hours) }</li>
				}
			}
		</ul>
	</section>
}
