package transport

import (
	"net/url"

	uicomponents "github.com/ardaozyildirim/hydrogo/internal/ui/components"
	"github.com/ardaozyildirim/hydrogo/modules/designsystem"
)

// translationMatrixView is the locale-by-key grid on /admin/translations.
type translationMatrixView struct {
	Locales []translationLocaleView
	Rows    []translationRowView
	CSRF    string
}

type translationLocaleView struct{ Code, Label string }

type translationRowView struct {
	Key, Default, Search string
	Cells                []translationCellView
}

type translationCellView struct {
	ID, Key, Locale, Value string
	Missing                bool
}

templ translationMatrix(view translationMatrixView) {
	<main class="studio-card translation-editor">
		<div class="studio-form-field translation-search">
			<label class="studio-form-label" for="translation-search">Çevirilerde ara</label>
			<input id="translation-search" type="search" autocomplete="off" aria-controls="translation-matrix"/>
		</div>
		<p class="muted">Eksik çeviriler sarı renkle işaretlenir. Boş bırakılan değerler Türkçe metne geri döner.</p>
		<div class="studio-table-wrap">
			<table id="translation-matrix">
				<thead>
					<tr>
						<th scope="col">Anahtar</th>
						for _, locale := range view.Locales {
							<th scope="col">{ locale.Label }</th>
						}
					</tr>
				</thead>
				<tbody>
					for _, row := range view.Rows {
						<tr data-translation-row data-search={ row.Search }>
							<th scope="row"><code>{ row.Key }</code><small>{ row.Default }</small></th>
							for _, cell := range row.Cells {
								<td
									if cell.Missing {
										class="translation-missing"
									}
								>
									@uicomponents.Form(uicomponents.FormProps{Action: "/admin/translations", Method: "post", Body: translationCellFields(cell, view.CSRF)})
								</td>
							}
						</tr>
					}
				</tbody>
			</table>
		</div>
	</main>
	@uicomponents.Script("/admin-assets/js/translations.js")
}

// translationCellFields always carries the _csrf field, even when the token
// is empty, so the form keeps its shape for the CSRF middleware.
templ translationCellFields(cell translationCellView, csrf string) {
	@uicomponents.HiddenInput(uicomponents.HiddenInputProps{Name: "_csrf", Value: csrf})
	@uicomponents.HiddenInput(uicomponents.HiddenInputProps{Name: "key", Value: cell.Key})
	@uicomponents.HiddenInput(uicomponents.HiddenInputProps{Name: "locale", Value: cell.Locale})
	@uicomponents.Input(uicomponents.InputProps{ID: cell.ID, Name: "value", Type: "text", Label: cell.Locale + " " + cell.Key, Value: cell.Value, HasMaxLength: true, MaxLength: 1000})
	@uicomponents.Button(uicomponents.ButtonProps{Label: "Kaydet", Type: "submit", Variant: uicomponents.Quiet})
}

// redirectReportLink points from the redirect rules to the 404 report.
templ redirectReportLink() {
	<p><a class="text-link" href="/admin/redirects">Bulunamayan bağlantı raporunu aç</a></p>
}

type savedFormLink struct{ ID, Title string }

templ savedFormsList(items []savedFormLink, selected string) {
	<section class="studio-card saved-forms" aria-labelledby="saved-forms-title">
		<p id="saved-forms-title" class="muted">Kayıtlı formlar</p>
		<nav class="studio-actions" aria-labelledby="saved-forms-title">
			for _, item := range items {
				@uicomponents.ButtonLink(uicomponents.ButtonLinkProps{Href: "/admin/site/forms?id=" + url.QueryEscape(item.ID), Label: item.Title, Current: item.ID == selected})
			}
		</nav>
	</section>
}

// inboxToolbar is the search form and export links above the submissions table.
templ inboxToolbar(form, query string) {
	@uicomponents.Form(uicomponents.FormProps{Action: "/admin/site/inbox/" + url.PathEscape(form), Method: "get", Class: "studio-form inbox-search", Body: inboxSearchFields(query)})
	<div class="inbox-exports">
		@designsystem.ExportLinks([]designsystem.ExportLink{{Label: "CSV indir", URL: "/admin/site/inbox/" + url.PathEscape(form) + "/export.csv"}, {Label: "Excel indir", URL: "/admin/site/inbox/" + url.PathEscape(form) + "/export.xlsx"}})
	</div>
}

templ inboxSearchFields(query string) {
	@uicomponents.Input(uicomponents.InputProps{ID: "inbox-search", Name: "q", Label: "Ara", Value: query, Type: "search", MaxLength: 128, HasMaxLength: true})
	@uicomponents.Button(uicomponents.ButtonProps{Label: "Ara", Type: "submit", Variant: uicomponents.Primary})
}

// appearanceView carries the saved appearance settings into the form.
type appearanceView struct {
	Fields []uicomponents.InputProps
	Font   string
	CSRF   string
}

templ appearanceCard(view appearanceView) {
	@uicomponents.Card(uicomponents.CardProps{Title: "Renkler ve tipografi", Body: uicomponents.Form(uicomponents.FormProps{Action: "/admin/site/appearance", Method: "post", CSRF: view.CSRF, Body: appearanceFields(view)})})
	@uicomponents.Script("/admin-assets/js/appearance.js")
}

templ appearanceFields(view appearanceView) {
	for _, field := range view.Fields {
		@uicomponents.Input(field)
		if isMediaPathField(field.Name) {
			<button type="button" class="button button-quiet media-picker-open" data-media-target={ field.ID }>Medyadan seç</button>
		}
	}
	@uicomponents.Select(uicomponents.SelectProps{ID: "appearance-font", Name: "font_family", Label: "Yazı tipi", Value: view.Font, Options: []string{"system", "inter", "lato", "roboto"}})
	<p
		id="appearance-contrast"
		role="status"
		aria-live="polite"
		data-message-low="Kontrast yetersiz: beyaz metin için en az 4,5:1 gerekli."
		data-message-aa="WCAG AA uyumlu: en düşük oran {ratio}:1."
		data-message-aaa="WCAG AAA uyumlu: en düşük oran {ratio}:1."
	>Renk kontrastı denetleniyor…</p>
	<section id="appearance-preview" class="appearance-preview" aria-label="Canlı site görünümü önizlemesi">
		<p>Site görünümü önizlemesi</p>
		<img id="appearance-preview-logo" class="appearance-preview-logo" alt="Logo önizlemesi" hidden/>
		<h2>İşinizi büyütmeye hazır mısınız?</h2>
		<button type="button" class="appearance-preview-cta" tabindex="-1">İletişime geçin</button>
		<p id="appearance-preview-font">Örnek metin • Aa 123</p>
	</section>
	@uicomponents.Button(uicomponents.ButtonProps{Label: "Görünümü kaydet", Type: "submit", Variant: uicomponents.Primary})
}

// fontPickerStatus shows the active local font and the post-save notice.
templ fontPickerStatus(current string, saved bool) {
	if current != "" {
		<p>Etkin yerel yazı tipi: <code>{ current }</code></p>
	}
	if saved {
		<p role="status">Yazı tipi indirildi ve siteye uygulandı.</p>
	}
}
