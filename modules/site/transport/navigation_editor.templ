package transport

import (
	"net/url"
	"strconv"
	"strings"

	uicomponents "github.com/ardaozyildirim/hydrogo/internal/ui/components"
	"github.com/ardaozyildirim/hydrogo/modules/site"
)

// navigationEditorView is the menu tree editor for one locale.
type navigationEditorView struct {
	Locale      string
	Locales     []string
	CSRF        string
	Suggestions []site.NavigationSuggestion
	Rows        []navigationRowView
	// Template is the empty row cloned by navigation-editor.js; its ids end in
	// navigationNewRowKey, which the script replaces with a unique key.
	Template navigationRowView
}

type navigationRowView struct {
	Key      string
	Item     site.NavigationItem
	Parents  []uicomponents.SelectOption
	Position string
}

const navigationNewRowKey = "__new__"

var (
	navigationTargetOptions     = []uicomponents.SelectOption{{Value: "_self", Label: "Aynı sekmede"}, {Value: "_blank", Label: "Yeni sekmede"}}
	navigationVisibilityOptions = []uicomponents.SelectOption{{Value: "true", Label: "Yayında"}, {Value: "false", Label: "Gizli"}}
)

func navigationVisibleValue(visible bool) string {
	return strconv.FormatBool(visible)
}

templ navigationEditorPage(view navigationEditorView) {
	<main class="studio-card navigation-editor">
		<nav class="studio-actions" aria-label="Menü dili">
			for _, locale := range view.Locales {
				@uicomponents.ButtonLink(uicomponents.ButtonLinkProps{Href: "/admin/site/navigation/editor?locale=" + url.QueryEscape(locale), Label: strings.ToUpper(locale), Current: locale == view.Locale})
			}
		</nav>
		<p class="muted">Bağlantıları sürükleyerek sıralayın. Üst menü seçerek açılır alt menü oluşturabilirsiniz.</p>
		@uicomponents.Form(uicomponents.FormProps{Action: "/admin/site/navigation/editor", Method: "post", Class: "navigation-editor-form", CSRF: view.CSRF, Body: navigationEditorFields(view)})
	</main>
	@uicomponents.Script("/admin-assets/js/navigation-editor.js")
}

templ navigationEditorFields(view navigationEditorView) {
	@uicomponents.HiddenInput(uicomponents.HiddenInputProps{Name: "locale", Value: view.Locale})
	if len(view.Suggestions) > 0 {
		<datalist id="published-page-paths">
			for _, suggestion := range view.Suggestions {
				<option value={ suggestion.Href }>{ suggestion.Label }</option>
			}
		</datalist>
	}
	<div class="table-wrap">
		<table class="navigation-table">
			<caption class="visually-hidden">Menü bağlantıları</caption>
			<thead>
				<tr>
					<th scope="col">Sıra</th>
					<th scope="col">Bağlantı</th>
					<th scope="col">Üst menü</th>
					<th scope="col">Açılış</th>
					<th scope="col">Durum</th>
				</tr>
			</thead>
			<tbody id="navigation-tree">
				for _, row := range view.Rows {
					@navigationRow(row)
				}
			</tbody>
		</table>
	</div>
	<template id="navigation-row-template" data-row-key={ navigationNewRowKey }>
		@navigationRow(view.Template)
	</template>
	<div class="studio-actions">
		<button class="button button-quiet" type="button" id="navigation-add">Bağlantı ekle</button>
		@uicomponents.Button(uicomponents.ButtonProps{Label: "Menüyü kaydet", Type: "submit", Variant: uicomponents.Primary})
	</div>
}

templ navigationRow(row navigationRowView) {
	<tr data-navigation-row draggable="true">
		<td class="navigation-order">
			<button type="button" class="button button-quiet" data-drag-handle aria-label="Sürükleyerek sırala">↕</button>
			<button type="button" class="button button-quiet" data-move-up aria-label="Yukarı taşı">↑</button>
			<button type="button" class="button button-quiet" data-move-down aria-label="Aşağı taşı">↓</button>
			@uicomponents.HiddenInput(uicomponents.HiddenInputProps{Name: "id", Value: row.Item.ID})
			@uicomponents.HiddenInput(uicomponents.HiddenInputProps{Name: "position", Value: row.Position})
		</td>
		<td>
			@uicomponents.Input(uicomponents.InputProps{ID: "nav-label-" + row.Key, Name: "label", Label: "Bağlantı adı", Value: row.Item.Label, Required: true, HasMaxLength: true, MaxLength: 256})
			@uicomponents.Input(uicomponents.InputProps{ID: "nav-href-" + row.Key, Name: "href", Label: "Sayfa yolu", Value: row.Item.Href, Placeholder: "/hakkimizda", Required: true, HasMaxLength: true, MaxLength: 2048})
		</td>
		<td>
			@uicomponents.Select(uicomponents.SelectProps{ID: "nav-parent-" + row.Key, Name: "parent_id", Label: "Üst menü", Value: row.Item.ParentID, Items: row.Parents})
		</td>
		<td>
			@uicomponents.Select(uicomponents.SelectProps{ID: "nav-target-" + row.Key, Name: "target", Label: "Açılış şekli", Value: row.Item.Target, Items: navigationTargetOptions})
		</td>
		<td>
			@uicomponents.Select(uicomponents.SelectProps{ID: "nav-visible-" + row.Key, Name: "visible", Label: "Görünürlük", Value: navigationVisibleValue(row.Item.Visible), Items: navigationVisibilityOptions})
			<button type="button" class="button button-quiet button-danger" data-remove-row>Bağlantıyı kaldır</button>
		</td>
	</tr>
}
