package transport

import (
	ui "github.com/ardaozyildirim/hydrogo/internal/ui/components"
	"github.com/ardaozyildirim/hydrogo/modules/designsystem"
	"strconv"
)

// Admin member screens (/admin/members). Handlers in admin.go build the view
// models; styles live in static/admin/admin.css ("Members admin").

templ memberListPage(v memberListView) {
	<section class="studio-card member-admin">
		<form class="table-toolbar" method="get" action="/admin/members">
			<div class="search-wrap">
				<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
				<input type="search" name="q" value={ v.Query } placeholder="E-posta ile üye ara…" aria-label="E-posta ile üye ara"/>
			</div>
			<select name="status" aria-label="Üye durumu">
				for _, option := range v.StatusOptions {
					<option value={ option.Value } selected?={ option.Value == v.Status }>{ option.Label }</option>
				}
			</select>
			<button type="submit" class="button">Filtrele</button>
			if v.Query != "" || v.Status != "all" {
				<a href="/admin/members" class="button button-quiet">Temizle</a>
			}
		</form>
		@designsystem.ExportLinks(v.ExportLinks)
		<div class="table-wrap">
			<table>
				<thead>
					<tr><th>E-posta</th><th>Durum</th><th>E-posta Doğrulama</th><th>Son Giriş</th><th>Kayıt Tarihi</th><th>İşlem</th></tr>
				</thead>
				<tbody>
					if len(v.Rows) == 0 {
						<tr><td colspan="6" class="empty">Eşleşen üye kaydı bulunamadı.</td></tr>
					}
					for _, row := range v.Rows {
						<tr>
							<td><strong><a class="member-email-link" href={ templ.URL(row.DetailURL) }>{ row.Email }</a></strong></td>
							<td>
								if row.Active {
									<span class="status-badge status-badge-success">Aktif</span>
								} else {
									<span class="status-badge">Pasif</span>
								}
							</td>
							<td>
								if row.VerifiedAt != "" {
									<span class="member-verified" title={ row.VerifiedAt }>✓ Doğrulanmış</span>
								} else {
									<span class="member-muted">Doğrulanmamış</span>
								}
							</td>
							<td>
								if row.LastLogin != "" {
									<span class="member-mono">{ row.LastLogin }</span>
								} else {
									<span class="member-muted">—</span>
								}
							</td>
							<td class="member-mono">{ row.Created }</td>
							<td>
								<div class="member-row-actions">
									<a href={ templ.URL(row.DetailURL) } class="button button-quiet member-row-button">Detay</a>
									if row.ResendAction != "" {
										@designsystem.EmailVerificationResendForm(row.ResendAction, v.CSRF)
									}
								</div>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		if v.Pages > 1 {
			<div class="pagination member-pagination">
				<span class="muted">Toplam { strconv.Itoa(v.Total) } üye (Sayfa { strconv.Itoa(v.Page) } / { strconv.Itoa(v.Pages) })</span>
				<div class="member-pagination-links">
					if v.PrevURL != "" {
						<a href={ templ.URL(v.PrevURL) } class="button button-quiet member-page-button">← Önceki</a>
					}
					if v.NextURL != "" {
						<a href={ templ.URL(v.NextURL) } class="button button-quiet member-page-button">Sonraki →</a>
					}
				</div>
			</div>
		}
	</section>
}

templ memberDetailPage(v memberDetailView) {
	<div class="member-admin member-detail">
		<div class="member-detail-toolbar">
			<a href="/admin/members" class="button button-quiet member-action-button">← Üye Listesine Dön</a>
			<div class="member-detail-actions">
				@ui.ActionForm(v.ToggleActive)
			</div>
		</div>
		<section class="studio-card">
			<div class="card-title-group"><h2>Üye Bilgileri</h2></div>
			<div class="kpi-grid member-kpis">
				@memberKPI("E-POSTA", v.Email)
				@memberKPI("DURUM", v.StatusText)
				@memberKPI("DOĞRULAMA", v.VerifyText)
				@memberKPI("SON GİRİŞ", v.LastLogin)
			</div>
			<div class="member-quick-actions">
				@ui.ActionForm(v.Verify)
			</div>
		</section>
		<section class="studio-card">
			<div class="member-card-head">
				<div class="card-title-group"><h2>Aktif Oturumlar</h2></div>
				if v.RevokeAll != nil {
					@ui.ActionForm(*v.RevokeAll)
				}
			</div>
			<div class="table-wrap">
				<table>
					<thead>
						<tr><th>IP Adresi</th><th>Tarayıcı / Cihaz</th><th>Son Görülme</th><th>Son Geçerlilik</th><th>İşlem</th></tr>
					</thead>
					<tbody>
						if len(v.Sessions) == 0 {
							<tr><td colspan="5" class="empty">Aktif oturum bulunmuyor.</td></tr>
						}
						for _, session := range v.Sessions {
							<tr>
								<td class="member-mono">{ session.IP }</td>
								<td class="member-user-agent">{ session.UserAgent }</td>
								<td class="member-mono">{ session.LastSeen }</td>
								<td class="member-mono">{ session.Expires }</td>
								<td>
									@ui.ActionForm(session.Revoke)
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</section>
		<section class="studio-card">
			<div class="card-title-group"><h2>Güvenlik ve İşlem Kayıtları (Audit)</h2></div>
			<div class="table-wrap">
				<table>
					<thead>
						<tr><th>Olay / Aksiyon</th><th>İstek ID</th></tr>
					</thead>
					<tbody>
						if len(v.Audit) == 0 {
							<tr><td colspan="2" class="empty">Kayıtlı audit olayı bulunmuyor.</td></tr>
						}
						for _, event := range v.Audit {
							<tr><td><strong>{ event.Action }</strong></td><td class="member-request-id">{ event.RequestID }</td></tr>
						}
					</tbody>
				</table>
			</div>
		</section>
	</div>
}

templ memberKPI(label, value string) {
	<div class="kpi-card"><span class="kpi-label">{ label }</span><strong class="member-kpi-value">{ value }</strong></div>
}
