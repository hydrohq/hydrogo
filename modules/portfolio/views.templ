package portfolio
import "github.com/ardaozyildirim/hydrogo/internal/sectoral"

templ Collection(items []Project) {
<section class="sectoral-collection bg-background text-foreground" data-module="portfolio">
 for _, item := range items {
  if item.Status == "published" {
   <article class="sectoral-card bg-surface border-border"><h2>{ item.Title }</h2>
   if item.CoverURL != "" {
	<img src={ templ.SafeURL(sectoral.SanitizeWebURL(item.CoverURL)) } alt={ item.Title } loading="lazy"/>
   }
   <p>{ item.Industry }</p>
   if item.Client != "" {
	<p>{ item.Client }</p>
   }
   if item.Summary != "" {
	<p>{ item.Summary }</p>
   }
   </article>
  }
 }
</section>
}
