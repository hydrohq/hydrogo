package transport

import (
	"fmt"
	"strconv"

	"github.com/ardaozyildirim/hydrogo/internal/ui"
)

// pageBlockEditor renders the form-based block editor. The admin block editor
// script (ui.AdminBlockEditorJS) hydrates the data-block-* hooks: it adds,
// moves and removes rows and shows only the fields a block type uses.
templ pageBlockEditor(v blockEditorView) {
	<input type="hidden" name="block_count" value={ strconv.Itoa(len(v.Rows)) }/>
	<div data-block-editor>
		for _, row := range v.Rows {
			@pageBlockRow(row, v.CSRF)
		}
		<button
			type="button"
			class="block-add-btn"
			data-block-add
			if v.Full {
				disabled
				aria-disabled="true"
			}
		>+ Yeni İçerik Bloku Ekle</button>
		<p role="status" aria-live="polite" data-block-status></p>
	</div>
}

templ pageBlockRow(row blockEditorRow, csrf string) {
	<div class="block-editor-row" data-block-row data-block-type={ row.Type }>
		<div class="block-editor-row-header">
			<div class="block-editor-row-title">
				<strong data-block-number>{ fmt.Sprintf("Blok %d", row.Index+1) }</strong>
				<span class="block-type-badge" data-block-type-badge>{ row.TypeLabel }</span>
			</div>
			<div class="block-editor-order">
				<button type="button" data-block-up aria-label={ fmt.Sprintf("Move block %d up", row.Index+1) } title="Yukarı taşı">↑</button>
				<button type="button" data-block-down aria-label={ fmt.Sprintf("Move block %d down", row.Index+1) } title="Aşağı taşı">↓</button>
				<button type="button" class="block-delete-btn" data-block-remove aria-label="Bloku kaldır" title="Bloku kaldır">✕ Kaldır</button>
			</div>
		</div>
		<label class="block-field block-field-type" data-block-field="type">
			<span class="block-field-label">Blok türü</span>
			<select name={ blockFieldName("block_type_", row.Index) }>
				<option value="">-- Blok Kaldır / Seçilmedi --</option>
				for _, option := range blockTypeOptions {
					<option value={ option.Type } selected?={ option.Type == row.Type }>{ option.Label }</option>
				}
			</select>
		</label>
		<label class="block-field" data-block-field="title">
			<span class="block-field-label">Başlık</span>
			<input name={ blockFieldName("block_title_", row.Index) } value={ row.Title } placeholder="Blok ana başlığı"/>
		</label>
		<label class="block-field" data-block-field="subtitle">
			<span class="block-field-label">Alt başlık</span>
			<input name={ blockFieldName("block_subtitle_", row.Index) } value={ row.Subtitle } placeholder="Açıklayıcı alt metin"/>
		</label>
		<div class="block-field media-field" data-block-field="media">
			<label>
				<span class="block-field-label">Medya Asset</span>
				<input id={ blockFieldName("block_media_asset_id_", row.Index) } name={ blockFieldName("block_media_asset_id_", row.Index) } value={ row.MediaAssetID } placeholder="Medyadan seçin"/>
			</label>
			<button class="button button-quiet media-picker-open" type="button" data-media-target={ blockFieldName("block_media_asset_id_", row.Index) }>Medyadan seç</button>
		</div>
		<label class="block-field" data-block-field="buttonText">
			<span class="block-field-label">Buton metni</span>
			<input name={ blockFieldName("block_button_text_", row.Index) } value={ row.ButtonText } placeholder="Örn: İncele →"/>
		</label>
		<label class="block-field" data-block-field="buttonURL">
			<span class="block-field-label">Buton URL</span>
			<input name={ blockFieldName("block_button_url_", row.Index) } value={ row.ButtonURL } placeholder="/shop"/>
		</label>
		<div class="block-field block-field-items" data-block-field="items">
			<span class="block-field-label">İçerik Maddeleri</span>
			<textarea name={ blockFieldName("block_items_", row.Index) } class="block-items-raw" spellcheck="false">{ row.Items }</textarea>
		</div>
		@ui.BlockPresetFields(ui.BlockStyleFieldsProps{Index: row.Index, Background: row.Background, Padding: row.Padding})
		<div class="block-field block-field-payload" data-block-field="payload">
			<span class="block-field-label">Blok JSON Verisi</span>
			<textarea name={ blockFieldName("block_payload_", row.Index) } spellcheck="false">{ row.Payload }</textarea>
		</div>
		<input type="hidden" name={ blockFieldName("block_csrf_", row.Index) } value={ csrf }/>
	</div>
}
