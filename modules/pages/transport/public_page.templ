package transport

// Public page markup. The view types live in public_head.go.

// publicReadingHead loads the article reading styles and tools. The
// in-place edit button shown to editors is styled there too.
templ publicReadingHead() {
	<link rel="stylesheet" href="/designsystem/static/article-reading.css"/>
	<script src="/designsystem/static/article-reading.js" defer></script>
}

// publicPageArticle is the page title, reading tools, table of contents and
// rich-text body. The HTML arguments are already-rendered, trusted markup.
templ publicPageArticle(title string, tools, toc, article string) {
	<div data-testid="public-page"><h1>{ title }</h1>@templ.Raw(tools)@templ.Raw(toc)<div class="content-body article-reading-body">@templ.Raw(article)</div></div>
}

// publicPageDocument is the document served when no theme is active.
templ publicPageDocument(v publicPageView) {
	<!doctype html>
	<html lang={ v.Locale } dir={ v.Direction }><head><meta charset="utf-8"/><title>{ v.Title }</title>@templ.Raw(v.Head)</head><body>@templ.Raw(v.Search)<main data-testid="public-page"><h1>{ v.Title }</h1>@templ.Raw(v.EditLink)@templ.Raw(v.Tools)<div class="content-body article-reading-body">@templ.Raw(v.Article)</div>@templ.Raw(v.Blocks)@templ.Raw(v.Related)</main>@templ.Raw(v.Consent)@templ.Raw(v.Support)</body></html>
}

// draftPreviewBody is a draft page's content; article and blocks are
// already-rendered, trusted markup.
templ draftPreviewBody(title, article, blocks string) {
	<main><h1>{ title }</h1><div class="content-body article-reading-body">@templ.Raw(article)</div>@templ.Raw(blocks)</main>
}

// draftPreviewDocument is the theme-less draft preview; it is never indexed.
templ draftPreviewDocument(locale, title, body string) {
	<!doctype html>
	<html lang={ locale }><head><meta charset="utf-8"/><meta name="robots" content="noindex,nofollow"/><title>{ title }</title></head><body>@templ.Raw(body)</body></html>
}

// seoHead renders appearance, font, favicon, business and social metadata.
templ seoHead(v seoHeadView) {
	if v.AppearanceCSS != "" {
		@inlineStyle(v.AppearanceCSS)
	}
	if v.FontCSS != "" {
		<link rel="stylesheet" href={ templ.SafeURL(v.FontCSS) }/>
	}
	if v.FaviconURL != "" {
		<link rel="icon" href={ templ.SafeURL(v.FaviconURL) }/>
	}
	if len(v.BusinessJSONLD) > 0 {
		@templ.JSONScript("", v.BusinessJSONLD).WithType("application/ld+json")
	}
	if v.Social {
		for _, alternate := range v.Alternates {
			<link rel="alternate" hreflang={ alternate.Locale } href={ templ.SafeURL(alternate.Href) }/>
		}
		<link rel="canonical" href={ templ.SafeURL(v.Canonical) }/>
		<meta name="description" content={ v.Description }/>
		<meta property="og:type" content="website"/>
		<meta property="og:title" content={ v.OGTitle }/>
		<meta property="og:description" content={ v.OGDescription }/>
		<meta property="og:url" content={ v.Canonical }/>
		<meta property="og:image" content={ v.OGImage }/>
		<meta name="twitter:card" content="summary_large_image"/>
		<meta name="twitter:image" content={ v.OGImage }/>
	}
}
