package transport

import (
	"fmt"
	"strconv"

	"github.com/ardaozyildirim/hydrogo/internal/ui"
	uicomponents "github.com/ardaozyildirim/hydrogo/internal/ui/components"
	"github.com/ardaozyildirim/hydrogo/modules/designsystem"
)

// pageListScreen wraps the shared admin list table with the view switcher,
// the optional import action and the optional view-count sort control.
templ pageListScreen(v pageListView) {
	@ui.ListViewSwitcher("admin-content-list", "hydro-view-content")
	<section class="studio-card">
		if v.ImportLabel != "" {
			<div class="studio-actions">
				<a class="button button-quiet" href="/admin/pages/import">{ v.ImportLabel }</a>
			</div>
		}
		<div class="table-wrap" id="admin-content-list" data-view-mode="table">
			if v.ViewSort != nil {
				@designsystem.ContentViewSort(*v.ViewSort)
			}
			@v.List
		</div>
	</section>
}

templ pageImportResult(created, skipped int) {
	<section class="studio-card" role="status">
		<h2>Aktarım tamamlandı</h2>
		<p>{ fmt.Sprintf("%d taslak eklendi. %d satır atlandı.", created, skipped) }</p>
		<a href="/admin/pages">Sayfalara dön</a>
	</section>
}

templ pageNewScreen(v pageNewView) {
	<section class="studio-card">
		<form class="studio-form" method="post" action="/admin/pages">
			@designsystem.PageLayoutPicker(v.Layouts)
			@v.Fields
			@uicomponents.Input(uicomponents.InputProps{ID: "page-tags", Name: "tags", Type: "text", Label: pageTagsLabel})
			<div class="page-editor-submit-bar">
				@uicomponents.Button(uicomponents.ButtonProps{Label: v.SubmitLabel, Type: "submit"})
			</div>
		</form>
	</section>
}

templ pageEditScreen(v pageEditView) {
	for _, panel := range v.Before {
		@panel
	}
	<section class="studio-card">
		<form class="studio-form" method="post" action={ templ.SafeURL(v.Action) } data-local-autosave data-autosave-resource={ "page:" + v.ID }>
			@v.Fields
			<div class="block-editor">
				<div class="block-editor-heading">
					<div>
						<h3>İçerik blokları</h3>
						<p>Sayfanın görsel bölümlerini ve sıralamasını yönetin.</p>
					</div>
					<span>{ strconv.Itoa(v.BlockCount) } blok</span>
				</div>
				<fieldset>
					<legend class="visually-hidden">İçerik blokları</legend>
					@pageBlockEditor(v.Blocks)
				</fieldset>
			</div>
			<input type="hidden" name="version" value={ strconv.Itoa(v.Version) }/>
			<div class="page-editor-submit-bar">
				@uicomponents.Button(uicomponents.ButtonProps{Label: "Taslağı kaydet", Type: "submit"})
			</div>
		</form>
	</section>
	<section class="studio-card publishing-card">
		<h2>Yayınlama</h2>
		<p class="muted">Taslağı kaydedin veya doğrudan yayına alın.</p>
		<div class="studio-actions">
			<form method="post" action={ templ.SafeURL(v.PublishAction) }>
				<input type="hidden" name="_csrf" value={ v.CSRF }/>
				<input type="hidden" name="version" value={ strconv.Itoa(v.Version) }/>
				<button type="submit" class="button button-success">Yayına Al</button>
			</form>
		</div>
	</section>
	for _, panel := range v.After {
		@panel
	}
}

// pageReadOnlyBody shows a page to readers without any mutation control; the
// rendered content sits in a preview frame (see previewFrameSandbox).
templ pageReadOnlyBody(v pageReadOnlyView) {
	for _, field := range v.Fields {
		@uicomponents.Input(field)
	}
	<iframe class="revision-preview readonly-content-preview" title={ v.Title } sandbox={ previewFrameSandbox } referrerpolicy="no-referrer" srcdoc={ v.Preview }></iframe>
}

// pageRevisionCompare shows a stored revision next to the current draft.
templ pageRevisionCompare(before, after, beforeLabel, afterLabel string) {
	<details class="studio-card studio-revision-toggle" data-visual-revision>
		<summary class="revision-summary-header" aria-expanded="false">
			<span class="revision-summary-title">
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 8v4l3 3"></path><circle cx="12" cy="12" r="9"></circle></svg>
				<strong>Görsel sürüm karşılaştırması</strong>
			</span>
			<span class="revision-toggle-btn">Görsel Önizlemeyi Göster ▾</span>
		</summary>
		<div class="studio-split-editor" style="margin-top:16px;">
			<article>
				<h3>{ beforeLabel }</h3>
				<iframe class="revision-preview" sandbox={ previewFrameSandbox } referrerpolicy="no-referrer" loading="lazy" title={ beforeLabel } srcdoc={ before }></iframe>
			</article>
			<article>
				<h3>{ afterLabel }</h3>
				<iframe class="revision-preview" sandbox={ previewFrameSandbox } referrerpolicy="no-referrer" loading="lazy" title={ afterLabel } srcdoc={ after }></iframe>
			</article>
		</div>
	</details>
}

// pagePreviewDocument is the standalone document shown in revision and
// read-only preview frames.
templ pagePreviewDocument(title, bodyHTML, blocksHTML string) {
	<!DOCTYPE html>
	<html lang="tr">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width"/>
			<link rel="stylesheet" href="/admin-assets/revision-preview.css"/>
		</head>
		<body>
			<main>
				<h1>{ title }</h1>
				<div class="content-body">
					@templ.Raw(bodyHTML)
				</div>
				@templ.Raw(blocksHTML)
			</main>
		</body>
	</html>
}
