package pages

templ RelatedPages(currentID string, locale string, items []Page) {
 if len(items) > 0 {
  <section class="related-content mt-10" aria-label="Benzer sayfalar">
   <h2 class="mb-4 text-xl font-semibold">Bunlar da ilginizi çekebilir</h2>
   <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
    for _, item := range items {
     if item.ID != currentID && item.Status == StatusPublished && item.Locale == locale {
      <article class="rounded-lg border border-border bg-surface p-4">
       <h3 class="font-medium"><a href={ templ.SafeURL("/public/pages/" + item.Locale + "/" + item.Slug + "/html") }>{ item.Title }</a></h3>
      </article>
     }
    }
   </div>
  </section>
 }
}
