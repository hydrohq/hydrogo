package downloads
import (
 "strconv"
 "github.com/ardaozyildirim/hydrogo/internal/sectoral"
)
templ Collection(items []Download) {
<section class="sectoral-collection bg-background text-foreground" data-module="downloads">
 for _, item := range items {
  if item.Status == "published" {
   <article class="sectoral-card bg-surface border-border"><h2>{ item.Title }</h2>
   if item.Summary != "" {
	<p>{ item.Summary }</p>
   }
   <a href={ templ.SafeURL(sectoral.SanitizeWebURL(item.FileURL)) } download>Dosyayı indir</a>
   <span>{ strconv.FormatInt(item.DownloadCount, 10) } indirme</span>
   </article>
  }
 }
</section>
}
