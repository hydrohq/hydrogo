package partners
import (
 "github.com/ardaozyildirim/hydrogo/internal/sectoral"
)
templ Collection(items []Partner) {
<section class="sectoral-collection bg-background text-foreground" data-module="partners">
 for _, item := range items {
  if item.Status == "published" {
   <article class="sectoral-card bg-surface border-border"><h2>{ item.Title }</h2>
   if item.LogoURL != "" {
	<img src={ templ.SafeURL(sectoral.SanitizeWebURL(item.LogoURL)) } alt={ item.Title } loading="lazy"/>
   }
   if item.Tier != "" {
	<p>{ item.Tier }</p>
   }
   if item.WebsiteURL != "" {
	<a href={ templ.SafeURL(sectoral.SanitizeWebURL(item.WebsiteURL)) } rel="noopener noreferrer">{ item.Title }</a>
   }
   </article>
  }
 }
</section>
}
