#!/bin/sh
set -eu

# Fast verification (build, vet, gofmt, guards, tests). Set HYDRO_PUSH_FULL=1
# to run the long release suite in scripts/verify-local.ps1 instead.
if [ "${HYDRO_PUSH_FULL:-0}" = "1" ] && command -v pwsh >/dev/null 2>&1; then
  exec pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/verify-local.ps1
fi
exec go run ./tools/check
