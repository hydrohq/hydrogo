{
  "version": 1,
  "base_url": "http://127.0.0.1:8090",
  "admin": {
    "login_path": "/login",
    "surfaces": [
      {"id": "developer", "route": "/admin/developer", "test_id": "developer-area", "style_selector": ".dev-console", "style_property": "display", "style_value": "grid"},
      {"id": "operations", "route": "/admin/operations", "test_id": "operations-area", "navigate_from": "/admin/developer", "style_selector": ".ops-grid", "style_property": "display", "style_value": "grid"},
      {"id": "security", "route": "/admin/security", "test_id": "security-area", "navigate_from": "/admin/developer", "style_selector": ".sec-grid", "style_property": "display", "style_value": "grid"},
      {"id": "permissions", "route": "/admin/permissions", "test_id": "permissions-area", "navigate_from": "/admin/developer", "style_selector": ".perm-grid", "style_property": "display", "style_value": "grid"},
      {"id": "developer resources", "route": "/admin/developer/resources", "test_id": "resource-page", "navigate_from": "/admin/developer", "style_selector": ".resource-page", "style_property": "display", "style_value": "grid"}
    ],
    "collections": [
      {"id": "news", "route": "/admin/news/new", "fields": [{"id": "title", "test_id": "admin-field-news-title"}, {"id": "body", "widget": "richtext", "test_id": "admin-field-news-body"}]},
      {"id": "pages", "route": "/admin/pages/new", "fields": [{"id": "title", "test_id": "admin-field-pages-title"}, {"id": "body", "widget": "richtext", "test_id": "admin-field-pages-body"}]}
    ]
  },
  "frontend": {
    "routes": [
      {"name": "home", "path": "/public/pages/tr/demo/html", "public": true, "test_id": "public-page"},
      {"name": "shop", "path": "/shop", "public": true, "test_id": "public-shop"},
      {"name": "news", "path": "/public/news/tr/html", "public": true, "test_id": "public-news"},
      {"name": "product", "path": "/shop/products/demo-bottle", "public": true, "test_id": "public-product"},
      {"name": "member login", "path": "/member/login", "public": true, "test_id": "member-auth"}
    ]
  },
  "media": {
    "route": "/admin/media",
    "upload_enabled": true
  },
  "assets": {
    "corporate": {
      "version": "1.0.0",
      "assets": {
        "theme.css": {"bytes": 72843, "sha256": "d986ae3d766be283a136830d6da6a9e4425be10eb6ba23daf8ef951682e7ea66"},
        "theme.js": {"bytes": 18240, "sha256": "60d7340a209909ac69d88785cdfef48356edab1cffe6606d93a95b59ae3fa65e"}
      }
    }
  }
}
