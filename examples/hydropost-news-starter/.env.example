# HydroGo backend base URL
HYDROGO_API_URL=http://127.0.0.1:8090

# Personal access token (scope: admin) minted from a logged-in session via
# POST /api/v1/admin/account/tokens. Self-service API keys (/api/v1/admin/api-keys)
# are read-only and cannot write news items, so this must be a personal token.
# Required for /api/translate (reads + writes modules/news).
HYDROGO_ADMIN_API_KEY=

# Optional: used in place of HYDROGO_ADMIN_API_KEY to authorize calls to
# /api/translate, if you want a separate secret for that one endpoint.
TRANSLATE_API_SECRET=

# Optional: enables real AI translation in /api/translate. Without it, the
# endpoint still runs but copies the source text instead of translating it.
ANTHROPIC_API_KEY=

# Must match the webhook secret configured on the HydroGo backend
# (webhooks[].url -> this app's /api/revalidate, secret via HYDRO_WEBHOOK_SECRET env).
HYDROGO_WEBHOOK_SECRET=

# Password that gates /yonetim/ceviri, the editor-facing translate trigger page.
TRANSLATE_PANEL_PASSWORD=

# Used only by /api/admin/rss-ingest to log in and fetch an admin session.
HYDRO_ADMIN_EMAIL=
HYDRO_ADMIN_PASSWORD=
RSS_INGEST_TOKEN=
