{
  "name": "hydrogo-crm-starter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "CRM panel for a HydroGo project (SvelteKit, server-side session, no browser tokens)",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "ioredis": "^6.0.0",
    "nodemailer": "^10.3.1"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.2.0",
    "@sveltejs/kit": "^2.15.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^6.4.17",
    "svelte": "^5.20.2",
    "svelte-check": "^4.1.4",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "cookie": "^0.7.2"
  }
}
