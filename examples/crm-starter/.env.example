# Where your HydroGo server runs (read on the server only).
HYDRO_API_ORIGIN=http://127.0.0.1:8080
# Panel language: en or tr. Users can switch it from the top bar.
CRM_LANG=en
# Set to true when the panel is served over HTTPS (marks the session cookie Secure).
CRM_SECURE_COOKIES=false
# Optional: share sessions across panel instances instead of the per-process in-memory store.
# REDIS_URL=redis://localhost:6379
# Required when REDIS_URL is set; encrypts session data at rest in Redis.
# SESSION_SECRET=
# Optional: serve more than one tenant from this deployment, resolved by Host header
# (mirrors HydroGo's own cfg.Tenancy.Hosts — each entry needs a matching host there too).
# With CRM_TENANTS unset, every request uses the single HYDRO_API_ORIGIN above.
# CRM_TENANTS=[{"slug":"acme","host":"acme.crm.example.com","hydroOrigin":"https://acme.hydro.example.com","webhookSecret":"..."}]

# Email notifications on content.created/updated/deleted (configure a matching
# webhooks: entry in HydroGo's own config, pointing at /api/webhooks/hydrogo/<slug>).
# Single-tenant fallback secret; per-tenant deployments set webhookSecret in CRM_TENANTS instead.
# WEBHOOK_SECRET=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=crm@example.com
# NOTIFY_TO=sales-team@example.com
