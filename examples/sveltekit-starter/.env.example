# Where your HydroGo server runs. Only read at build time -- see
# docs/decisions/0026-sveltekit-starter-static-adapter.md: this starter has
# no server of its own, so there is no per-request env read.
VITE_HYDRO_API_ORIGIN=http://127.0.0.1:8080
# Public URL of THIS site: canonical links, sitemap and RSS use it.
VITE_PUBLIC_SITE_ORIGIN=http://localhost:3000
# Site languages. The first is the default and has no URL prefix (/news); the
# others get one (/tr/news). Must match the locales your HydroGo content uses.
VITE_PUBLIC_LOCALES=en
