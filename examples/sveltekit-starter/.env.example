# Where your HydroGo server runs (read on the server only).
HYDRO_API_ORIGIN=http://127.0.0.1:8080
# Public URL of THIS site: canonical links, sitemap and RSS use it.
PUBLIC_SITE_ORIGIN=http://localhost:3000
# Site languages. The first is the default and has no URL prefix (/news); the
# others get one (/tr/news). Must match the locales your HydroGo content uses.
PUBLIC_LOCALES=en
