# Where your HydroGo server runs (read on the server only).
HYDRO_API_ORIGIN=http://127.0.0.1:8080
# The same server's address as the BROWSER reaches it, for <img> src to
# uploaded media -- only differs from HYDRO_API_ORIGIN behind a reverse
# proxy or in production, where it is usually a public hostname instead
# of 127.0.0.1.
PUBLIC_HYDRO_API_ORIGIN=http://127.0.0.1:8080
# Public URL of THIS storefront: used for canonical links.
PUBLIC_SITE_ORIGIN=http://localhost:3000
# Must be true in production (HTTPS): tells the storefront to mark the
# cookies it proxies from HydroGo (cart, CSRF, member session) Secure.
PUBLIC_SECURE_COOKIES=false
# Required in production (adapter-node): this site's own public URL, so its
# CSRF protection can tell a real form submission from a cross-site one.
ORIGIN=http://localhost:3000
