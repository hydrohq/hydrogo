// Package example is a working reference for Tailwind-authored custom UI
// (ADR-0338). It is not wired into any route and exists only so the
// standalone Tailwind build and its contract tests have a real component to
// scan and verify against.
package example

templ Card(title string, body string) {
	<section class="rounded-lg border border-slate-200 bg-white p-6 shadow-md">
		<h2 class="text-lg font-semibold text-slate-900">{ title }</h2>
		<p class="mt-2 text-sm text-slate-600">{ body }</p>
	</section>
}
