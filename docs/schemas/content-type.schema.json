{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ozyildirims/hydrogo/docs/schemas/content-type.schema.json",
  "title": "HydroGo content type",
  "description": "One file in content-types/*.yaml. In VS Code with the YAML extension, add `# yaml-language-server: $schema=<path or URL to this file>` as the first line for completion and validation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "label", "fields"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$", "description": "Becomes /api/v1/content/<id> and /admin/content/<id>."},
    "label": {"type": "string"},
    "description": {"type": "string"},
    "group": {"type": "string", "description": "Admin navigation group."},
    "icon": {"type": "string"},
    "title_field": {"type": "string", "description": "Field id shown as the record title."},
    "public": {"type": "boolean", "description": "Serve published records at /api/v1/content/<id>."},
    "drafts": {"type": "boolean", "description": "Records have a draft/published status; the public API returns only published ones."},
    "revisions": {"type": "boolean", "description": "Keep the last 50 saved versions of each record. Required when any field is localized."},
    "fields": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/field"}}
  },
  "$defs": {
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "kind"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$", "not": {"enum": ["id", "version", "created_at", "updated_at", "locale"]}},
        "label": {"type": "string"},
        "kind": {"enum": ["text", "textarea", "richtext", "number", "boolean", "date", "datetime", "select", "media", "relation"]},
        "required": {"type": "boolean"},
        "unique": {"type": "boolean"},
        "list": {"type": "boolean", "description": "Show as a sortable column in the admin list."},
        "options": {"type": "array", "items": {"type": "string"}, "description": "Choices of a select field."},
        "to": {"type": "string", "description": "Target content type id of a relation field."},
        "many": {"type": "boolean", "description": "A relation field holding several records."},
        "min": {"type": "number"},
        "max": {"type": "number"},
        "searchable": {"type": "boolean", "description": "text, textarea, richtext, select."},
        "filterable": {"type": "boolean", "description": "text, textarea, select, number."},
        "localized": {"type": "boolean", "description": "One value per site locale (text, textarea, richtext, media)."}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "relation"}}, "required": ["kind"]}, "then": {"required": ["to"]}},
        {"if": {"properties": {"kind": {"const": "select"}}, "required": ["kind"]}, "then": {"required": ["options"]}}
      ]
    }
  }
}
