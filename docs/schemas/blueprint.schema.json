{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hydrogo.dev/schemas/blueprint-v1.json",
  "title": "HydroGo Client Edition Blueprint",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "fields"],
  "properties": {
    "version": { "type": "string", "enum": ["v0"], "default": "v0" },
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,62}$" },
    "type": { "type": "string", "enum": ["collection", "global"], "default": "collection" },
    "auth": { "type": "boolean", "default": false, "description": "Require Edition-owned Identity/Session/RBAC composition before exposing the generated resource." },
    "tenant_scoped": { "type": "boolean", "default": false },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["states"],
      "properties": {
        "states": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" }, "uniqueItems": true },
        "transitions": { "type": "object", "maxProperties": 32, "additionalProperties": { "type": "array", "maxItems": 32, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" }, "uniqueItems": true } }
      }
    },
    "table": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,62}$" },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,62}$" },
          "type": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean" },
          "values": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "validation": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "min_length": { "type": "integer", "minimum": 0 },
              "max_length": { "type": "integer", "minimum": 0 },
              "min": { "type": "number" },
              "max": { "type": "number" },
              "regex": { "type": "string", "maxLength": 256 },
              "format": { "type": "string", "enum": ["email", "date", "datetime", "url"] },
              "unique": { "type": "boolean" },
              "immutable": { "type": "boolean" },
              "default": { "type": "string", "maxLength": 256 }
            }
          },
          "ui": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "list": { "type": "boolean", "default": false },
              "searchable": { "type": "boolean", "default": false },
              "filterable": { "type": "boolean", "default": false },
              "widget": {
                "type": "string",
                "enum": ["text", "textarea", "number", "boolean", "date", "datetime", "select", "media", "richtext", "block-editor", "relation", "array", "hidden"]
              }
            }
          }
        }
      }
    },
    "kits": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "admin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "maxLength": 120 },
        "description": { "type": "string", "maxLength": 500 },
        "icon": { "type": "string", "pattern": "^[a-z][a-z0-9._:-]{0,63}$" },
        "group": { "type": "string", "pattern": "^[a-z][a-z0-9._:-]{0,63}$" },
        "actions": { "type": "array", "items": { "$ref": "#/$defs/action" } },
        "bulk_actions": { "type": "array", "items": { "$ref": "#/$defs/action" } }
      }
    }
  },
  "$defs": {
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "href"],
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 120 },
        "href": { "type": "string", "pattern": "^/(?!/).*" }
      }
    }
  }
}
