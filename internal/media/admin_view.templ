package media

import (
	"net/url"
	"strconv"

	"github.com/ardaozyildirim/hydrogo/internal/ui"
	uicomponents "github.com/ardaozyildirim/hydrogo/internal/ui/components"
)

// mediaLibraryView is everything the /admin/media screen renders.
type mediaLibraryView struct {
	CSRF           string
	SelectedFolder string
	SelectedTag    string
	Folders        []ui.MediaFolderItem
	ShowCleanup    bool
	Settings       ui.MediaSettingsFormProps
	Cards          []mediaCardView
}

// mediaCardView is one asset card in the library grid.
type mediaCardView struct {
	ID             string
	Filename       string
	Meta           string
	Private        bool
	Preview        string // image, pdf, video or file
	ObjectPosition string
	Metadata       ui.MediaMetadataFormProps
}

func mediaAssetURL(id string) string { return "/media/" + url.PathEscape(id) }

func mediaCountLabel(count int) string { return strconv.Itoa(count) + " asset" }

templ mediaLibrary(view mediaLibraryView) {
	@ui.MediaUploadFolderField(view.SelectedFolder)
	<section class="media-overview">
		<div class="media-dropzone-card">
			<div class="media-dropzone-wrap" id="media-dropzone">
				<div class="media-dropzone-icon" aria-hidden="true">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
				</div>
				<div class="media-dropzone-text">
					<strong>Yeni Medya Yükle</strong>
					<small>Dosyaları sürükleyip bırakın veya aşağıdan seçin (JPEG, PNG, WebP, MP4, WebM)</small>
				</div>
				<form class="media-upload-form" id="media-upload-form" method="post" action="/admin/media" enctype="multipart/form-data">
					<input type="hidden" name="_csrf" value={ view.CSRF }/>
					<input type="file" id="media-file-input" name="file" aria-label="Yüklenecek medya dosyaları" accept="image/jpeg,image/png,image/webp,video/mp4,video/webm,video/quicktime" multiple/>
					<select name="visibility" aria-label="Görünürlük">
						<option value="public" selected>Herkese açık</option>
						<option value="private">Özel</option>
					</select>
					<button class="button" type="submit">
						<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
						<span>Yükle</span>
					</button>
				</form>
				<div id="media-upload-progress" aria-live="polite"></div>
			</div>
		</div>
		<div class="media-toolbar-card">
			<div class="table-toolbar media-search-toolbar">
				<div class="search-wrap media-search-wrap">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
					<input type="search" id="media-search" aria-label="Medya dosya adı veya ID ile ara" placeholder="Dosya adı veya ID ile ara..." autocomplete="off"/>
				</div>
				<span class="status-badge" id="media-count-badge" aria-live="polite">{ mediaCountLabel(len(view.Cards)) }</span>
			</div>
		</div>
	</section>
	<div class="media-toolbar-row">
		@ui.ListViewSwitcher("media-grid", "hydro-view-media")
		@ui.MediaFolderTree(view.Folders, view.SelectedFolder)
		@ui.MediaCreateFolderForm(view.Folders, view.CSRF, view.SelectedFolder)
		@ui.MediaTagFilter(view.SelectedTag, view.SelectedFolder)
		if view.ShowCleanup {
			@ui.MediaCleanupLink()
		}
		@ui.MediaSettingsForm(view.Settings)
	</div>
	<div class="media-grid" id="media-grid" data-view-mode="cards">
		for _, card := range view.Cards {
			@mediaCard(card, view.CSRF)
		}
		if len(view.Cards) == 0 {
			<p class="empty media-empty">Henüz medya yüklenmedi. Yukarıdaki alandan dosya sürükleyerek veya seçerek yükleyebilirsiniz.</p>
		}
	</div>
	@uicomponents.Script("/admin-assets/js/media-library.js")
	@uicomponents.Script("/admin/media/static/uploader.js")
}

templ mediaCard(card mediaCardView, csrf string) {
	<article id={ "media-" + card.ID } class="media-card" data-filename={ card.Filename } data-id={ card.ID }>
		<div class="media-thumb-wrap">
			switch card.Preview {
				case "image":
					<img class="media-focal-preview cursor-crosshair" src={ mediaAssetURL(card.ID) } alt={ card.Filename } loading="lazy" style={ "object-position:" + card.ObjectPosition }/>
				case "pdf":
					@ui.MediaPDFCoverPreview(ui.MediaPDFCoverProps{AssetID: card.ID, Filename: card.Filename})
				case "video":
					<video preload="metadata" src={ mediaAssetURL(card.ID) }></video>
				default:
					<div class="media-placeholder">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
						<span>Dosya</span>
					</div>
			}
			if card.Private {
				<span class="media-badge is-private">Özel</span>
			} else {
				<span class="media-badge is-public">Açık</span>
			}
			<div class="media-thumb-overlay">
				<a href={ templ.SafeURL(mediaAssetURL(card.ID)) } target="_blank" rel="noopener noreferrer" class="media-overlay-btn" title="Yeni sekmede aç" aria-label={ card.Filename + ": yeni sekmede aç" }>
					<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" x2="21" y1="14" y2="3"></line></svg>
				</a>
				<button type="button" class="media-overlay-btn media-copy-link" data-url={ mediaAssetURL(card.ID) } title="Bağlantıyı kopyala" aria-label={ card.Filename + ": bağlantıyı kopyala" }>
					<svg class="media-copy-link-idle" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>
					<svg class="media-copy-link-done" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
				</button>
			</div>
		</div>
		<div class="media-card-body">
			<strong class="media-title" title={ card.Filename }>{ card.Filename }</strong>
			<small class="media-sub">{ card.Meta }</small>
			<div class="media-card-actions">
				<code>{ card.ID }</code>
				<button class="button button-quiet media-copy" type="button" data-copy={ card.ID } title="ID Kopyala">Kopyala</button>
			</div>
			<form class="media-visibility-form" method="post" action={ templ.SafeURL("/admin/media/" + url.PathEscape(card.ID) + "/visibility") }>
				<input type="hidden" name="_csrf" value={ csrf }/>
				<select name="visibility" aria-label="Görünürlük">
					<option value="private" selected?={ card.Private }>Özel</option>
					<option value="public" selected?={ !card.Private }>Herkese açık</option>
				</select>
				<button class="button button-quiet" type="submit">Güncelle</button>
			</form>
			@ui.MediaAssetMetadataForm(card.Metadata)
		</div>
	</article>
}
