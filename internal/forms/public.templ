package forms

import (
	"fmt"
	"time"
)

type PublicFormProps struct {
	Form              Form
	Action            string
	CSRFToken         string
	SubmissionToken   string
	TurnstileSiteKey  string
	SubmitLabel       string
}

templ Head() {
	<link rel="stylesheet" href="/forms/static/forms.css" />
	<script src="/forms/static/forms.js" defer></script>
}

templ PublicForm(p PublicFormProps) {
	if p.Form.Validate() == nil {
	<form class="hydro-form" method="post" enctype="multipart/form-data" action={ safeFormAction(p.Action, p.Form.ID) } data-public-form data-form-view-endpoint={ publicFormViewEndpoint(p.Form.ID) } data-reset-on-success data-step-wizard?={ publicFormHasSteps(p.Form) } novalidate?={ publicFormHasSteps(p.Form) } data-step-count={ fmt.Sprint(maximumFormStep(p.Form)) } data-conversion-enabled?={ p.Form.ConversionTracking } data-google-ads-conversion-id={ p.Form.GoogleAdsConversionID } data-google-ads-conversion-label={ p.Form.GoogleAdsConversionLabel } data-meta-pixel-event={ publicMetaPixelEvent(p.Form) }>
		<input type="hidden" name="_csrf" value={ p.CSRFToken } />
		<input type="hidden" name="_submission_token" value={ publicSubmissionToken(p.SubmissionToken) } />
		<div class="hydro-form__honeypot" aria-hidden="true"><label for="hydro-website-url">Leave this field empty</label><input id="hydro-website-url" name="website_url" type="text" tabindex="-1" autocomplete="off" /></div>
		<h2>{ p.Form.Title }</h2>
		if notice := p.Form.PublicWorkingHoursNotice(time.Now()); notice != "" {
			<p class="hydro-form__hours-notice" role="note">{ notice }</p>
		}
		for _, field := range p.Form.Fields {
			<div class="hydro-form__field" data-form-step={ fmt.Sprint(publicFieldStep(field)) } hidden?={ publicFormHasSteps(p.Form) && publicFieldStep(field) != 1 }>
				<label for={ "hydro-" + p.Form.ID + "-" + field.ID }>{ field.Label }
					if field.Required {
						<span aria-hidden="true">*</span>
					}
				</label>
				if field.Type == Document {
					<input id={ "hydro-" + p.Form.ID + "-" + field.ID } name={ field.ID } type="file" accept=".pdf,.doc,.docx,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document" required?={ field.Required } />
				} else if field.Type == Textarea {
					<textarea id={ "hydro-" + p.Form.ID + "-" + field.ID } name={ field.ID } required?={ field.Required } maxlength={ fmt.Sprint(MaxValueLength) } data-character-counter></textarea>
					<output class="hydro-form__counter" data-character-count aria-live="off">0 / { fmt.Sprint(MaxValueLength) }</output>
				} else if field.Type == CascadingSelect {
					<select id={ "hydro-" + p.Form.ID + "-" + field.ID } name={ field.ID } data-cascade-select data-cascade-parent={ field.DependsOn } data-cascade-options={ publicCascadeOptions(field) } required?={ field.Required }>
						<option value="">Choose one</option>
						for _, option := range field.Options {
							<option value={ option }>{ option }</option>
						}
					</select>
				} else if field.Type == Select {
					<select id={ "hydro-" + p.Form.ID + "-" + field.ID } name={ field.ID } required?={ field.Required }>
						<option value="">Choose one</option>
						for _, option := range field.Options {
							<option value={ option }>{ option }</option>
						}
					</select>
				} else if field.Type == Checkbox {
					<input id={ "hydro-" + p.Form.ID + "-" + field.ID } name={ field.ID } type="checkbox" value="true" required?={ field.Required } />
					if field.PolicyText != "" {
						<button type="button" class="hydro-form__policy-open" data-policy-open={ publicPolicyDialogID(p.Form.ID, field.ID) }>Read the policy</button>
						<dialog class="hydro-form__policy" id={ publicPolicyDialogID(p.Form.ID, field.ID) } aria-label={ field.Label }>
							<div class="hydro-form__policy-content">{ field.PolicyText }</div>
							<button type="button" data-policy-close>Close</button>
						</dialog>
					}
				} else {
					<input id={ "hydro-" + p.Form.ID + "-" + field.ID } name={ field.ID } type={ publicInputType(field.Type) } required?={ field.Required } maxlength={ fmt.Sprint(MaxValueLength) } inputmode={ phoneInputMode(field.Type) } autocomplete={ phoneAutocomplete(field.Type) } data-phone-mask?={ field.Type == Phone } data-email-suggest?={ field.Type == Email } />
					if field.Type == Email {
						<span class="hydro-form__suggestion" data-email-suggestion role="status" aria-live="polite"></span>
					}
				}
			</div>
		}
		if publicFormHasSteps(p.Form) {
			<nav class="hydro-form__steps" aria-label="Form steps"><button type="button" data-form-previous disabled>Previous</button><span data-form-step-status aria-live="polite"></span><button type="button" data-form-next>Next</button></nav>
		}
		if p.Form.TurnstileEnabled {
			if p.TurnstileSiteKey != "" {
				<div class="cf-turnstile" data-sitekey={ p.TurnstileSiteKey }></div>
				<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
			}
		}
		<button type="submit" data-form-submit><span data-submit-label>{ publicFormSubmitLabel(p.SubmitLabel) }</span><span class="hydro-form__spinner" data-submit-spinner hidden aria-hidden="true"></span></button>
		<p data-submit-status role="status" aria-live="polite"></p>
	</form>
	}
}

func publicPolicyDialogID(formID, fieldID string) string {
	return "hydro-policy-" + formID + "-" + fieldID
}
