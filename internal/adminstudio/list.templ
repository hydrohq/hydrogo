package adminstudio

import "strconv"

// listView renders the shared admin collection table used by the generated
// admin and by the pages and news modules through RenderList.
templ listView(d ListData) {
	<div class="table-wrap">
		<table class="studio-table" data-admin-list-state>
			<caption class="visually-hidden">{ d.ResolvedListCaption() }</caption>
			<thead>
				<tr>
					if len(d.Collection.BulkActions) > 0 {
						<th scope="col" class="studio-table-select"><span class="visually-hidden">Seç</span><input type="checkbox" aria-label="Tümünü seç" data-bulk-select-all/></th>
					}
					for _, field := range d.Collection.Fields {
						if field.VisibleInList {
							<th scope="col">
								if href := d.SortURLs[field.ID]; href != "" {
									<a class="text-link" href={ templ.URL(href) }>{ field.Label }</a>
								} else {
									{ field.Label }
								}
							</th>
						}
					}
					<th scope="col" class="studio-table-actions">{ d.ResolvedActionColumnLabel() }</th>
				</tr>
			</thead>
			<tbody>
				if len(d.Rows) > 0 {
					for _, row := range d.Rows {
						<tr
							if row.Status.Value != "" {
								data-status-row={ row.Status.Value }
							}
						>
							if len(d.Collection.BulkActions) > 0 {
								<td data-label="Seç" class="studio-table-select"><input type="checkbox" value={ row.ID } aria-label={ d.Collection.Label + " kaydını seç" } data-bulk-select/></td>
							}
							for _, field := range d.Collection.Fields {
								if field.VisibleInList {
									<td data-label={ field.Label }>
										if field.ID == d.Collection.TitleField && row.DetailURL != "" {
											<a class="text-link" href={ templ.URL(row.DetailURL) }>{ row.Values[field.ID] }</a>
										} else if row.ValueHTML[field.ID] != "" {
											@templ.Raw(string(row.ValueHTML[field.ID]))
										} else if field.ID == "status" && row.StatusHTML != "" {
											@templ.Raw(string(row.StatusHTML))
										} else {
											{ row.Values[field.ID] }
										}
									</td>
								}
							}
							<td data-label={ d.ResolvedActionColumnLabel() } class="studio-table-actions">
								for index, action := range row.Actions {
									if row.ActionHTML[index] != "" {
										{ " " }
										@templ.Raw(string(row.ActionHTML[index]))
										{ " " }
									} else {
										<a class="text-link" href={ templ.URL(action.Href) }>{ action.Label }</a>
										{ " " }
									}
								}
							</td>
						</tr>
					}
				} else {
					<tr><td colspan={ strconv.Itoa(d.ColumnCount()) } class="empty-state"><p role="status">{ d.ResolvedEmptyMessage() }</p></td></tr>
				}
			</tbody>
		</table>
	</div>
	if len(d.Collection.BulkActions) > 0 {
		<div class="studio-bulk-actions" role="group" aria-label="Toplu işlemler">
			for _, action := range d.Collection.BulkActions {
				<a class="button button-quiet button-sm" href={ templ.URL(action.Href) } data-bulk-action={ action.Label }>
					@bulkActionIcon()
					<span>{ action.Label }</span>
				</a>
			}
		</div>
	}
}

templ bulkActionIcon() {
	<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
}
