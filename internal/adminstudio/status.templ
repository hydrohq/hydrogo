package adminstudio

templ StatusPill(info StatusInfo) {
	<span class={ statusPillClass(info.Value) } aria-label={ statusPillLabel(info) }>
		<span aria-hidden="true">●</span>
		if statusPillScheduledAt(info) != "" {
			<time datetime={ statusPillScheduledAt(info) }>{ statusPillLabel(info) }</time>
		} else {
			{ statusPillLabel(info) }
		}
	</span>
}
