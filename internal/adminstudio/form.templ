package adminstudio

// createFormView renders the metadata-driven controls of RenderCreateForm.
// The surrounding <form> element belongs to the calling module.
templ createFormView(d FormData, v createFormViewModel) {
	for _, field := range d.Collection.Fields {
		if field.Kind != FieldRelation && !field.ReadOnly {
			if field.Widget == "hidden" {
				<input type="hidden" name={ field.ID } value={ d.Values[field.ID] }/>
			} else if field.Widget == "media" {
				@createFormMedia(d, field)
			} else if field.Widget == "list" || field.ID == "key_takeaways" {
				@createFormItemList(d, field)
			} else if isCreateFormRichText(field) {
				@createFormRichText(d, field, v.RichTextLabel)
			} else if field.Widget == "checkbox" {
				<label class="editor-checkbox-row"><input type="checkbox" name={ field.ID } value="true" checked?={ createFormChecked(d.Values[field.ID]) }/><span>{ field.Label }</span></label>
			} else {
				if field.Kind == FieldStatus || len(field.Options) > 0 {
					<label>{ createFormLabel(field) }<select name={ field.ID } required?={ field.Required }>
	for _, option := range field.Options {
		<option value={ option } selected?={ d.Values[field.ID] == option }>{ option }</option>
	}
</select></label>
				} else if field.Widget == "textarea" {
					<label>{ createFormLabel(field) }<textarea name={ field.ID } required?={ field.Required }>{ d.Values[field.ID] }</textarea></label>
				} else {
					<label>{ createFormLabel(field) }<input name={ field.ID } type={ createFormInputType(field) } value={ d.Values[field.ID] } required?={ field.Required }/></label>
				}
			}
		}
	}
	<input type="hidden" name="_csrf" value={ d.CSRFToken }/>
	if !d.HideSubmit {
		<button type="submit">{ v.SubmitLabel }</button>
	}
	if d.Nonce != "" {
		<script nonce={ d.Nonce }>(function(){if(window.HydroInitQuill)window.HydroInitQuill();if(window.HydroInitItemLists)window.HydroInitItemLists();if(window.HydroInitAutoResizeTextareas)window.HydroInitAutoResizeTextareas();if(window.HydroInitMediaSelectPreviews)window.HydroInitMediaSelectPreviews();})();</script>
	}
	for _, relation := range v.Relations {
		<label>{ createFormLabel(relation.Field) }<select name={ relation.Field.ID } required?={ relation.Field.Required }>
	<option value="">{ v.ChooseRelation }</option>
	for _, option := range relation.Options {
		<option value={ option.ID } selected?={ d.Values[relation.Field.ID] == option.ID }>{ option.Label }</option>
	}
</select></label>
	}
	if len(d.Locales) > 0 {
		<label>{ v.LocaleLabel }<select name="locale" aria-label={ v.LocaleLabel }>
	for _, locale := range v.Locales {
		<option value={ locale } selected?={ locale == d.CurrentLocale }>{ locale }</option>
	}
</select></label>
	}
}


templ createFormMedia(d FormData, field Field) {
	<div class={ "media-select-field", templ.KV("has-selected", d.Values[field.ID] != "") }>
		<span class="studio-form-label">{ createFormLabel(field) }</span>
		<div class={ "media-select-card", templ.KV("has-selected", d.Values[field.ID] != "") }>
			<div class="media-select-preview">
				<img class={ templ.KV("is-hidden", d.Values[field.ID] == "") } src={ createFormMediaSrc(d.Values[field.ID]) } alt={ d.T("admin.generated.widget.media.selected_image_alt") }/>
				<div class="media-select-empty">
					<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
					<span>{ d.T("admin.generated.widget.media.empty") }</span>
				</div>
			</div>
			<div class="media-select-body">
				<div class="media-select-info">
					<span class="media-select-name">
						if d.Values[field.ID] != "" {
							{ d.Values[field.ID] }
						} else {
							{ d.T("admin.generated.widget.media.empty") }
						}
					</span>
				</div>
				<div class="media-select-actions">
					<button class="button button-quiet media-picker-open" type="button" data-media-target={ "media_" + field.ID }>
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 14.899A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 2.5 8.242"/><path d="M12 12v9"/><path d="m16 16-4-4-4 4"/></svg>
						<span>{ d.T("admin.generated.widget.media.choose") }</span>
					</button>
					<button class={ "button button-quiet button-danger media-select-clear", templ.KV("is-hidden", d.Values[field.ID] == "") } type="button">{ d.T("admin.generated.widget.media.clear") }</button>
				</div>
			</div>
		</div>
		<input type="hidden" id={ "media_" + field.ID } name={ field.ID } value={ d.Values[field.ID] } required?={ field.Required }/>
	</div>
}

templ createFormItemList(d FormData, field Field) {
	<div class="studio-form-field full-width item-list-widget" data-item-list data-field-name={ field.ID } data-item-list-label={ field.Label }>
		<span class="studio-form-label">{ createFormLabel(field) }</span>
		<div class="item-list-container"><div class="item-list-rows"></div><button type="button" class="button button-quiet item-list-add-btn">+ { d.T("admin.generated.widget.array.add") }</button></div>
		<textarea class="item-list-hidden-input" name={ field.ID } hidden>{ d.Values[field.ID] }</textarea>
	</div>
}

templ createFormRichText(d FormData, field Field, accessibleLabel string) {
	<div class="studio-form-field full-width richtext-wrap" data-field-name={ field.ID }>
		<span class="studio-form-label">{ createFormLabel(field) }</span>
		<div class="richtext-field" data-richtext>
			<div class="richtext-toolbar ql-toolbar ql-snow">
				<span class="ql-formats">
					<select class="ql-header" aria-label="Başlık boyutu">
						<option value="1">Başlık 1</option>
						<option value="2">Başlık 2</option>
						<option value="3">Başlık 3</option>
						<option value="4">Başlık 4</option>
						<option selected>Normal Metin</option>
					</select>
				</span>
				<span class="ql-formats">
					<button type="button" class="ql-bold" aria-label="Kalın"></button>
					<button type="button" class="ql-italic" aria-label="İtalik"></button>
					<button type="button" class="ql-underline" aria-label="Altı çizili"></button>
					<button type="button" class="ql-strike" aria-label="Üstü çizili"></button>
					<button type="button" class="ql-code" aria-label="Satır içi kod"></button>
				</span>
				<span class="ql-formats">
					<button type="button" class="ql-link" aria-label="Bağlantı ekle"></button>
					<button type="button" class="ql-image" aria-label="Görsel ekle"></button>
					<button type="button" class="ql-blockquote" aria-label="Alıntı"></button>
					<button type="button" class="ql-code-block" aria-label="Kod bloğu"></button>
				</span>
				<span class="ql-formats">
					<button type="button" class="ql-list" value="ordered" aria-label="Numaralı liste"></button>
					<button type="button" class="ql-list" value="bullet" aria-label="Madde listesi"></button>
				</span>
				<span class="ql-formats">
					<button type="button" class="ql-clean" aria-label="Biçimlendirmeyi temizle"></button>
				</span>
			</div>
			<div class="richtext-editor ql-container ql-snow" role="textbox" aria-label={ accessibleLabel } aria-multiline="true"></div>
			<textarea class="richtext-value" name={ field.ID } hidden>{ d.Values[field.ID] }</textarea>
		</div>
	</div>
}
