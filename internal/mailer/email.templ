package mailer

templ AutoresponderEmail(title string, paragraphs []string) {
	<!doctype html>
	<html lang="en">
		<head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>{ title }</title></head>
		<body style="margin:0;background:#f4f6f8;color:#17212b;font-family:Arial,sans-serif">
			<main style="max-width:600px;margin:24px auto;padding:24px;background:#fff;border-radius:12px">
				<h1 style="font-size:22px;line-height:1.3">{ title }</h1>
				for _, paragraph := range paragraphs {
					<p style="font-size:16px;line-height:1.6">{ paragraph }</p>
				}
			</main>
		</body>
	</html>
}
