package mailer

// Markup for applyEmailBranding (branding.go). Email clients ignore
// stylesheets, so the styles are inline attributes. Color is a validated
// six-digit hex value (EmailBranding.Normalize).

// emailPlainDocument wraps a text-only message so branding has a body to
// decorate.
templ emailPlainDocument(text string) {
	<!doctype html>
	<html><body><p>{ text }</p></body></html>
}

templ emailBrandingHeader(logoURL, logoAlt, name, color string) {
	<header style={ templ.SafeCSS("border-bottom:3px solid " + color + ";padding:0 0 16px;margin:0 0 20px") }>@emailBrandingLogo(logoURL, logoAlt)<strong style="font:600 18px Arial,sans-serif">{ name }</strong></header>
}

templ emailBrandingLogo(logoURL, logoAlt string) {
	if logoURL != "" {
		<img src={ templ.SafeURL(logoURL) } alt={ logoAlt } style="display:block;max-width:180px;max-height:64px;margin:0 0 18px"/>
	}
}

templ emailBrandingFooter(lines []string, privacyPolicyURL string) {
	<footer style="border-top:1px solid #d6dbe1;padding-top:16px;margin-top:24px;color:#536170;font:12px/1.5 Arial,sans-serif">
		for _, line := range lines {
			<p style="margin:4px 0">{ line }</p>
		}
		if privacyPolicyURL != "" {
			<p style="margin:4px 0"><a href={ templ.SafeURL(privacyPolicyURL) }>Privacy policy</a></p>
		}
	</footer>
}
