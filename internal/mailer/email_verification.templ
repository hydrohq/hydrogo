package mailer

templ EmailVerificationEmail(link string) {
	<html><body>
		<h1>Confirm your HydroGo email address</h1>
		<p>Use this one-time link to confirm that this mailbox belongs to your account.</p>
		<p><a href={ link }>Confirm email address</a></p>
		<p>If you did not request this message, you can ignore it.</p>
	</body></html>
}
