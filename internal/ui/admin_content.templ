package ui

import "strconv"
import "github.com/ardaozyildirim/hydrogo/internal/adminstudio"

type TranslationEditorData struct {
	SourceTitle string
	SourceBody string
	Locale string
	TargetTitle string
	TargetBody string
	Action string
	CSRF string
	Version int
	Exists bool
	Outdated bool
}

templ TranslationEditor(data TranslationEditorData) {
	<section class="studio-card" data-translation-editor aria-labelledby="translation-editor-title">
		<div class="studio-split-editor">
			<article><h2 id="translation-editor-title">Kaynak içerik</h2><p>{ data.SourceTitle }</p><div class="translation-source" data-translation-source aria-readonly="true">{ data.SourceBody }</div></article>
			<form method="post" action={ data.Action } class="studio-form">
				<h2>Çeviri · { data.Locale }</h2>
				<input type="hidden" name="_csrf" value={ data.CSRF } />
				<input type="hidden" name="locale" value={ data.Locale } />
				<input type="hidden" name="version" value={ strconv.Itoa(data.Version) } />
				<label>Başlık<input name="title" value={ data.TargetTitle } required maxlength="256" aria-label="Başlık çevirisi" /></label>
				<label>Metin<textarea name="body" rows="16" required data-translation-target aria-label="Metin çevirisi">{ data.TargetBody }</textarea></label>
				<p role="status" aria-live="polite">
					if data.Outdated {
						<span class="warning-text">Kaynak güncellendi; çeviriyi gözden geçirin.</span>
					} else if !data.Exists {
						<span class="info-text">Bu dil için henüz çeviri yok.</span>
					}
				</p>
				<button class="button button-primary" type="submit" aria-busy="false" data-loading-text="Kaydediliyor...">Çeviriyi kaydet</button>
			</form>
		</div>
	</section>
}

templ RevisionDiffPanel(diffs []adminstudio.FieldDiff, editor, modified string, restoreAction, csrf string) {
	<details class="studio-card studio-revision-toggle" data-revision-diff>
		<summary class="revision-summary-header" aria-expanded="false">
			<span class="revision-summary-title">
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path><path d="M3 3v5h5"></path></svg>
				<strong>Değişiklikleri karşılaştır</strong>
				<span class="revision-summary-meta">{ editor } · { modified }</span>
			</span>
			<span class="revision-toggle-btn">Farkları İncele ▾</span>
		</summary>
		<div class="revision-diff-fields" style="margin-top:14px;">
			if len(diffs) == 0 {
				<p role="status">Gösterilecek değişiklik yok.</p>
			} else {
				for _, diff := range diffs {
					<article><h3>{ diff.Field }</h3><div class="revision-removed" aria-label="Önceki">{ diff.Before }</div><div class="revision-added" aria-label="Sonraki">{ diff.After }</div></article>
				}
			}
		</div>
		<form method="post" action={ restoreAction } data-confirm-action="Bu sürüm geri yüklensin mi?" style="margin-top:14px;"><input type="hidden" name="_csrf" value={ csrf }/><button class="button button-quiet" type="submit">Bu sürümü geri yükle</button></form>
	</details>
}

templ VisualRevisionCompare(before, after string, beforeLabel, afterLabel string) {
	<details class="studio-card studio-revision-toggle" data-visual-revision>
		<summary class="revision-summary-header" aria-expanded="false">
			<span class="revision-summary-title">
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 8v4l3 3"></path><circle cx="12" cy="12" r="9"></circle></svg>
				<strong>Görsel sürüm karşılaştırması</strong>
			</span>
			<span class="revision-toggle-btn">Görsel Önizlemeyi Göster ▾</span>
		</summary>
		<div class="studio-split-editor" style="margin-top:16px;">
			<article><h3>{ beforeLabel }</h3><iframe class="revision-preview" sandbox="" loading="lazy" title={ beforeLabel } srcdoc={ before }></iframe></article>
			<article><h3>{ afterLabel }</h3><iframe class="revision-preview" sandbox="" loading="lazy" title={ afterLabel } srcdoc={ after }></iframe></article>
		</div>
	</details>
}

templ ImportWizard(headers []string, csrf string, mapping bool) {
	<section class="studio-card" data-import-wizard aria-labelledby="import-title">
		<h2 id="import-title">İçerik içe aktar</h2>
		<p>CSV veya Excel dosyası yükleyin. Dosya 5 MB ve 5.000 satırla sınırlıdır.</p>
		<form method="post" enctype="multipart/form-data" action="/admin/pages/import">
			<input type="hidden" name="_csrf" value={ csrf } />
			<label>Dosya<input type="file" name="file" accept=".csv,.xlsx" required aria-label="İçeri aktarılacak dosya" /></label>
			if mapping {
				<h3>Sütunları eşleştirin</h3>
				for _, field := range []string{"locale", "slug", "title", "body"} {
					<label>{ field }
						<select name={ "map_" + field } aria-label={ field + " sütun eşleştirmesi" }>
							<option value="">Atla</option>
							for i, header := range headers {
								<option value={ strconv.Itoa(i) }>{ header }</option>
							}
						</select>
					</label>
				}
			}
			<button class="button button-primary" type="submit" aria-busy="false" data-loading-text="İşleniyor...">
				if mapping {
					<span>Aktarımı başlat</span>
				} else {
					<span>Sütunları incele</span>
				}
			</button>
		</form>
	</section>
}

templ ImportPreview(csrf string, mappings map[string]string, valid, duplicates, invalid int) {
	<section class="studio-card" data-import-preview aria-labelledby="import-preview-title">
		<h2 id="import-preview-title">Aktarımı gözden geçirin</h2>
		<p role="status">{ strconv.Itoa(valid) } yeni taslak aktarılabilir. { strconv.Itoa(duplicates) } yinelenen satır ve { strconv.Itoa(invalid) } geçersiz satır atlanacak.</p>
		<p>Aktarım önizlemesi hazır. Devam etmek için aynı dosyayı yeniden seçin.</p>
		<form method="post" enctype="multipart/form-data" action="/admin/pages/import">
			<input type="hidden" name="_csrf" value={ csrf }/><input type="hidden" name="action" value="import"/>
			for _, field := range []string{"locale", "slug", "title", "body"} {
				<input type="hidden" name={ "map_" + field } value={ mappings[field] }/>
			}
			<label>Dosya<input type="file" name="file" accept=".csv,.xlsx" required aria-label="Onaylanan dosya"/></label>
			<button class="button button-primary" type="submit" aria-busy="false" data-loading-text="Aktarılıyor...">Taslakları aktar</button>
		</form>
	</section>
}

templ DraftPreviewLinkForm(action, csrf string) {
	<section class="studio-card" aria-labelledby="draft-preview-title">
		<h2 id="draft-preview-title">Share draft preview</h2>
		<p class="muted">The link expires after 24 hours and stops working when this draft changes.</p>
		<form method="post" action={ action } hx-post={ action } hx-target="#draft-preview-result" hx-swap="innerHTML">
			<input type="hidden" name="_csrf" value={ csrf } />
			<button type="submit" class="button button-quiet" aria-busy="false" data-loading-text="Oluşturuluyor...">Create preview link</button>
		</form>
		<div id="draft-preview-result" aria-live="polite"></div>
	</section>
}

templ DraftPreviewLinkResult(link, expires string) {
	<p><a href={ link } target="_blank" rel="noopener noreferrer">Open draft preview</a></p>
	<label>Shareable preview URL<input type="url" readonly value={ link } aria-label="Shareable URL" /></label>
	<p class="muted">Expires { expires }</p>
}
