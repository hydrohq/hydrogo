package shell

import (
	"strings"

	"github.com/ardaozyildirim/hydrogo/modules/designsystem"
)

// Page is a complete Admin Studio document: content goes into the main area,
// chrome (shared dialogs) after it.
templ Page(v View, content templ.Component, chrome templ.Component) {
	<!doctype html>
	<html lang={ v.Lang() } data-ui-theme="hydrogo">
		@Head(v)
		<body
			if v.User.Scope != "" {
				data-studio-user-scope={ v.User.Scope }
			}
			if len(v.User.Permissions) > 0 {
				data-admin-permissions={ strings.Join(v.User.Permissions, " ") }
			}
			if v.User.Role != "" {
				data-studio-role={ v.User.Role }
			}
		>
			@banners(v)
			<main class="studio-app">
				@Sidebar(v)
				<section class="studio-main">
					@Topbar(v)
					@PageHeading(v)
					@content
					@tail(v)
					@chrome
				</section>
			</main>
		</body>
	</html>
}

// Head links the admin stylesheets and scripts. The only inline script is the
// pre-paint light/dark bootstrap, which must run before the first paint; its
// CSP hash is taken from this rendered output.
templ Head(v View) {
	<head>
		<meta charset="utf-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1"/>
		<title>{ v.Title } · HydroGo Studio</title>
		<script>(()=>{const root=document.documentElement;root.setAttribute('data-ui-theme','hydrogo');try{let variant=localStorage.getItem('hydro-theme');if(variant!=='dark'&&variant!=='light'){const legacy=localStorage.getItem('hydro-ui-theme-v2')||'';variant=legacy.endsWith('-dark')?'dark':legacy.endsWith('-light')?'light':(window.matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light');}root.setAttribute('data-theme',variant);}catch(_){root.setAttribute('data-theme','dark');}})();</script>
		for _, href := range Stylesheets {
			<link rel="stylesheet" href={ href }/>
		}
		<script src={ QuillScript }></script>
		<meta name="htmx-config" content="{&#34;includeIndicatorStyles&#34;:false}"/>
		for _, src := range Scripts {
			<script defer src={ src }></script>
		}
		if v.Lang() == "en" {
			<script defer src={ EnglishScript }></script>
		}
		for _, src := range AlpineScripts {
			<script defer src={ src }></script>
		}
		<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%231f3b78'/%3E%3Cpath d='M16 4 6 9l10 5 10-5-10-5zm-10 10 10 5 10-5m-20 5 10 5 10-5' fill='none' stroke='white' stroke-width='2'/%3E%3Ccircle cx='25' cy='24' r='6' fill='%23ef4444'/%3E%3Cpath d='M23 24h4' stroke='white' stroke-width='2'/%3E%3C/svg%3E"/>
	</head>
}

templ banners(v View) {
	if v.Banners.Maintenance {
		<div role="status" class="border-b border-amber-500 bg-amber-100 px-4 py-2 text-center font-semibold text-amber-950">Site bakım modunda; ziyaretçiler geçici bilgilendirme görüyor. <a class="underline" href="/admin/site/maintenance">Ayarları yönet</a></div>
	}
	if v.Banners.BrokenLinksJobID != "" {
		<div role="status" class="border-b border-amber-500 bg-amber-100 px-4 py-2 text-center font-semibold text-amber-950">Son bağlantı denetiminde erişilemeyen bağlantılar bulundu. <a class="underline" href={ templ.SafeURL("/admin/site/link-check?job=" + v.Banners.BrokenLinksJobID) }>Sonuçları incele</a></div>
	}
	if v.Banners.SafeMode {
		<div role="alert" class="border-b border-red-500 bg-red-100 px-4 py-2 text-center font-semibold text-red-950">System is operating in Safe Mode. External integrations and background delivery are paused.</div>
	}
	if notice := v.Banners.StaffNotice; notice != nil {
		@designsystem.StaffBroadcastNotice(notice.Message, notice.Severity, notice.DismissKey)
	}
}

// Sidebar is the brand, the role-filtered navigation and the support card.
templ Sidebar(v View) {
	<aside class="studio-sidebar" x-data="studioSidebar" x-on:click="follow">
		<div class="sidebar-header">
			<a class="studio-brand" href={ templ.SafeURL(v.HomeHref()) }><div class="brand-logo-mark">@brandMark()</div><div class="brand-text"><span>HYDRO<b>GO</b></span><small>Studio</small></div></a>
		</div>
		<div class="sidebar-scroll">
			<nav aria-label={ v.T(Text{"Yönetim menüsü", "Admin navigation"}) }>
				for _, section := range v.Sidebar() {
					<span class="sidebar-section-label">{ section.Label }</span>
					for _, item := range section.Items {
						@navLink(item)
						if len(item.Children) > 0 {
							<div class="nav-children">
								for _, child := range item.Children {
									@navLink(child)
								}
							</div>
						}
					}
				}
			</nav>
		</div>
		<div class="sidebar-bottom">
			<a class="nav-item site-link" href="/" target="_blank" rel="noopener noreferrer"><span class="nav-icon">@navIcon("external")</span><span>{ v.T(Text{"Siteyi Görüntüle", "View site"}) }</span></a>
		</div>
		if v.Support != nil {
			@supportCard(*v.Support)
		}
	</aside>
}

templ navLink(item VisibleItem) {
	<a
		class={ navItemClass(item) }
		href={ templ.SafeURL(item.Href) }
		if item.Active {
			aria-current="page"
		}
	>
		if item.Icon != "" {
			<span class="nav-icon">@navIcon(item.Icon)</span>
		}
		<span>{ item.Label }</span>
	</a>
}

templ supportCard(s Support) {
	<section class="studio-support-card" aria-label="Destek">
		<strong>{ s.AgencyName }</strong>
		if s.SLABadge != "" {
			<span class="studio-support-sla">{ s.SLABadge }</span>
		}
		if s.Email != "" {
			<a href={ templ.SafeURL("mailto:" + s.Email) }>{ s.Email }</a>
		}
		if s.Phone != "" {
			<a href={ templ.SafeURL("tel:" + s.Phone) }>{ s.Phone }</a>
		}
		if s.WhatsAppURL != "" {
			<a href={ templ.URL(s.WhatsAppURL) } target="_blank" rel="noopener noreferrer">WhatsApp desteği</a>
		}
		if s.GuideURL != "" {
			<a href="/admin/guide">Yardım ve video rehberi</a>
		}
	</section>
}

// Topbar holds the mobile menu toggle, search, notifications, the light/dark
// switch and the user menu. Its interactive parts are Alpine components from
// static/admin/shell.js.
templ Topbar(v View) {
	<header class="studio-topbar">
		<button type="button" class="studio-mobile-menu-toggle" aria-label={ v.T(Text{"Menüyü aç", "Open menu"}) } aria-expanded="false" x-data="navToggle" x-on:click="toggle" x-bind:aria-expanded="expanded">@menuIcon()</button>
		<div class="studio-search">@searchIcon()<span>{ v.T(Text{"Studio içinde ara...", "Search Studio..."}) }</span><kbd>⌘K</kbd></div>
		<div class="topbar-right">
			@notifications(v)
			<button id="theme-toggle-btn" class="theme-toggle-btn" type="button" aria-label={ v.T(Text{"Temayı Değiştir", "Change theme"}) } title={ v.T(Text{"Temayı Değiştir", "Change theme"}) } x-data="themeToggle" x-on:click="toggle" x-bind:aria-label="label" x-bind:title="title"><span class="theme-icon-sun">@sunIcon()</span><span class="theme-icon-moon">@moonIcon()</span></button>
			<div class="studio-badge-status"><span class="live-pulse"></span>{ v.T(Text{"Canlı Sistem", "Live system"}) }</div>
			@userMenu(v)
		</div>
	</header>
}

templ notifications(v View) {
	<div class="studio-notifications" x-data="notifications" x-on:keydown.escape="dismiss" x-on:click.outside="close" x-on:keydown.down.prevent="next" x-on:keydown.up.prevent="previous">
		<button type="button" class="studio-ux-trigger studio-notification-bell" data-notifications-open aria-label={ v.T(Text{"Bildirimler", "Notifications"}) } aria-haspopup="true" aria-controls="studio-notifications-panel" aria-expanded="false" x-ref="button" x-on:click="toggle" x-bind:aria-expanded="expanded" x-bind:aria-label="label">@bellIcon()<span data-notification-count hidden x-bind:hidden="noBadge" x-text="badge">0</span></button>
		<div id="studio-notifications-panel" class="user-dropdown-menu studio-notifications-panel" role="region" aria-label={ v.T(Text{"Bildirimler", "Notifications"}) } hidden x-bind:hidden="closed" x-ref="panel">
			<div class="user-dropdown-header">
				<strong>{ v.T(Text{"Bildirimler", "Notifications"}) }</strong>
				<small x-show="failed">{ v.T(Text{"Bildirimler şu anda yüklenemedi.", "Notifications could not be loaded."}) }</small>
			</div>
			<div class="user-dropdown-divider"></div>
			<template x-for="item in items" x-bind:key="item.id">
				<a class="dropdown-item studio-notification-item" x-bind:href="item.href" x-bind:class="item.state"><span class="studio-notification-text"><strong x-text="item.title"></strong><small x-text="item.message"></small></span></a>
			</template>
			<p class="studio-notifications-empty" x-show="empty">{ v.T(Text{"Yeni bildirim yok.", "No new notifications."}) }</p>
			<div class="user-dropdown-divider"></div>
			<a class="dropdown-item" href="/admin/notifications"><span>{ v.T(Text{"Tüm bildirimler", "All notifications"}) }</span></a>
		</div>
	</div>
}

templ userMenu(v View) {
	<div class="user-menu-wrap" x-data="userMenu" x-on:keydown.escape="dismiss" x-on:click.outside="close" x-on:keydown.down.prevent="next" x-on:keydown.up.prevent="previous">
		<button id="user-menu-btn" class="studio-user" type="button" aria-haspopup="true" aria-controls="user-dropdown" aria-expanded="false" x-ref="button" x-on:click="toggle" x-bind:aria-expanded="expanded">
			if v.User.Email != "" {
				@designsystem.InitialsAvatar(designsystem.InitialsAvatarProps{Initials: designsystem.Initials(v.User.Name()), Class: designsystem.InitialsAvatarClass(v.User.Email)})
			} else {
				<div class="user-avatar">A</div>
			}
			<span class="user-name">{ v.User.Name() }</span>
			@chevronIcon()
		</button>
		<div id="user-dropdown" class="user-dropdown-menu" hidden x-bind:hidden="closed" x-ref="menu">
			<div class="user-dropdown-header">
				<strong>{ v.RoleLabel() }</strong>
				if v.User.Email != "" {
					<small>{ v.User.Email }</small>
				}
			</div>
			<div class="user-dropdown-divider"></div>
			<a class="dropdown-item" href="/admin/account">@settingsIcon()<span>{ v.T(Text{"Hesap Ayarları", "Account settings"}) }</span></a>
			if v.CanSeeSecurity() {
				<a class="dropdown-item" href="/admin/permissions">@shieldIcon()<span>{ v.T(Text{"Güvenlik & Yetkiler", "Security & permissions"}) }</span></a>
			}
			<div class="user-dropdown-divider"></div>
			<button id="studio-logout-btn" class="dropdown-item dropdown-item-danger" type="button">@logoutIcon()<span>{ v.T(Text{"Çıkış Yap", "Sign out"}) }</span></button>
		</div>
	</div>
}

// PageHeading is the page title, its info tip and the primary action.
templ PageHeading(v View) {
	<section class="studio-heading">
		<div class="heading-title-group">
			<div class="heading-title-row">
				<h1>{ v.Title }</h1>
				if v.Eyebrow != "" || v.Description != "" {
					<span class="studio-info-tip" tabindex="0" role="button" aria-label={ v.T(Text{"Bilgi", "Information"}) }>
						@infoIcon()
						<span class="studio-tip-popover">
							if v.Eyebrow != "" {
								<span class="tip-eyebrow">{ v.Eyebrow }</span>
							}
							if v.Description != "" {
								<p>{ v.Description }</p>
							}
						</span>
					</span>
				}
			</div>
		</div>
		if v.Action != nil {
			<div class="heading-actions"><a class="button" href={ templ.SafeURL(v.Action.Href) }>@plusIcon() <span>{ v.T(v.Action.Label) }</span></a></div>
		}
	</section>
}

// tail closes the main area: the mobile drawer backdrop and the shared media
// picker dialog.
templ tail(v View) {
	<button type="button" class="studio-mobile-backdrop" aria-label={ v.T(Text{"Menüyü kapat", "Close menu"}) } x-data="navBackdrop" x-on:click="close"></button>
	<div id="admin-media-picker-modal" class="admin-media-picker-modal" hidden>
		<div class="admin-media-picker-dialog" role="dialog" aria-modal="true" aria-label="Medya kütüphanesi">
			<div class="admin-media-picker-header"><h2 class="admin-media-picker-title">Görsel seç</h2><button class="button button-quiet admin-media-picker-close" type="button" data-media-close>Kapat</button></div>
			<div class="admin-media-picker-toolbar"><input id="admin-media-picker-search" class="admin-media-picker-search" type="search" autocomplete="off" placeholder="Görsel ara..."/><p class="muted admin-media-picker-hint">Yalnız hazır görseller</p></div>
			<div id="admin-media-picker-grid" class="admin-media-picker-grid"></div>
		</div>
	</div>
}
