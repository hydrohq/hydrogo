package ui

templ PageWeightInspector() {
	<section class="studio-card page-weight-inspector" data-page-weight hidden aria-live="polite" aria-label="Tahmini sayfa boyutu">
		<div class="card-title-group"><div><p class="eyebrow">SAYFA PERFORMANSI</p><h2>Tahmini sayfa boyutu</h2></div><strong data-page-weight-total>—</strong></div>
		<p data-page-weight-state>İçerik boyutu hesaplanıyor.</p>
		<ul class="grid gap-1 text-sm"><li>Sayfa kodu <strong data-page-weight-html>—</strong></li><li>Stil dosyaları <strong data-page-weight-css>—</strong></li><li>Medya dosyaları <strong data-page-weight-assets>—</strong></li></ul>
		<p class="text-sm text-muted-foreground">Tahmin, bu sitedeki dosyaların boyutlarını kullanır. Dış kaynaklar hesaba katılmayabilir.</p>
		<ul data-page-weight-large-assets class="grid gap-1 text-sm"></ul>
	</section>
}
