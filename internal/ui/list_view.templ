package ui

templ BlockPresetFields(p BlockStyleFieldsProps) {
	<label class="block-field">Arka plan<select name={ blockPresetFieldName("block_bg_color_", p.Index) }>
		<option value="" selected?={ p.Background == "" || p.Background == "default" }>Varsayılan</option>
		<option value="muted" selected?={ p.Background == "muted" }>Soluk</option>
		<option value="primary_tint" selected?={ p.Background == "primary_tint" }>Ana renk tonu</option>
		<option value="dark" selected?={ p.Background == "dark" }>Koyu</option>
	</select></label>
	<label class="block-field">Dikey boşluk<select name={ blockPresetFieldName("block_padding_y_", p.Index) }>
		<option value="normal" selected?={ p.Padding == "" || p.Padding == "normal" }>Normal</option>
		<option value="compact" selected?={ p.Padding == "compact" }>Sıkı</option>
		<option value="spacious" selected?={ p.Padding == "spacious" }>Geniş</option>
	</select></label>
}

templ ListViewSwitcher(target, storageKey string) {
	<div class="list-view-switch" role="group" aria-label="Liste görünümü" data-list-view-toggle={ target } data-storage-key={ storageKey }>
		<button type="button" data-list-view-choice="cards" aria-pressed="false">Kartlar</button>
		<button type="button" data-list-view-choice="table" aria-pressed="false">Tablo</button>
	</div>
}
