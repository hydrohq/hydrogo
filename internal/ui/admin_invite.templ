package ui

templ AdminInviteShareDialog() {
	<dialog class="admin-draft-recovery" data-invite-share-dialog aria-labelledby="invite-share-title">
		<h2 id="invite-share-title">Davet hazır</h2>
		<p>Davet bağlantısı e-postayla gönderildi. İsterseniz bu mesajı güvenli bir kanaldan da paylaşabilirsiniz.</p>
		<label for="invite-share-message">Davet mesajı</label>
		<textarea id="invite-share-message" rows="5" readonly data-invite-share-message></textarea>
		<div class="admin-draft-recovery__actions">
			<button type="button" class="button button-success" data-invite-share-copy>Mesajı kopyala</button>
			<button type="button" class="button button-quiet" data-invite-share-close>Kapat</button>
		</div>
		<p role="status" aria-live="polite" data-invite-share-status></p>
	</dialog>
}
