package ui

templ PublicArticleTools() {
	<div class="article-read-tools" role="group" aria-label="Okuma araçları">
		<button type="button" data-font-size="down" aria-label="Yazı boyutunu küçült">A−</button>
		<button type="button" data-font-size="reset" aria-label="Yazı boyutunu sıfırla">A</button>
		<button type="button" data-font-size="up" aria-label="Yazı boyutunu büyüt">A+</button>
		<button type="button" data-print-article>Yazdır</button>
	</div>
}

// articleTOC is the nested table of contents PrepareArticleHTML returns.
templ articleTOC(entries []tocEntry) {
	<nav class="article-toc" aria-label="İçindekiler">
		<h2>İçindekiler</h2>
		@articleTOCList(entries)
	</nav>
}

templ articleTOCList(entries []tocEntry) {
	<ul>
		for _, entry := range entries {
			<li>
				<a href={ templ.SafeURL("#" + entry.ID) }>{ entry.Title }</a>
				if len(entry.Children) > 0 {
					@articleTOCList(entry.Children)
				}
			</li>
		}
	</ul>
}
