package components

templ mediaPickerTemplate(p MediaPickerProps, selected bool) {
	<div id={ p.ID + "-field" } class={ "media-select-field", templ.KV("has-selected", selected) }>
		<label class="studio-form-label" for={ p.ID }>{ p.Label }</label>
		<div class={ "media-select-card", templ.KV("has-selected", selected) }>
			<div class="media-select-preview">
				<img class={ templ.KV("is-hidden", !selected) } src={ templ.SafeURL(mediaPickerImageURL(p, selected)) } alt={ p.SelectedImageAlt }/>
				<div class="media-select-empty"><span>{ p.EmptySelection }</span></div>
			</div>
			<div class="media-select-body">
				<div class="media-select-info"><span class="media-select-name">{ mediaPickerLabel(p, selected) }</span></div>
				<div class="media-select-actions">
					<button class="button button-quiet media-picker-open" type="button" data-media-target={ p.ID }>{ p.ChooseFromLibrary }</button>
					<button class={ "button button-quiet button-danger media-select-clear", templ.KV("is-hidden", selected == false) } type="button">{ p.ClearSelection }</button>
					<a class="text-link" href={ templ.SafeURL(mediaLibraryHref(p.ID)) }>{ p.OpenLibrary }</a>
				</div>
			</div>
		</div>
		<input type="hidden" id={ p.ID } name={ p.Name } value={ p.Value }/>
	</div>
}
