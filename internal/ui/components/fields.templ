package components

import "strconv"

// Attributes returns the allowlisted htmx attributes for templ spreading.
func (h HTMX) Attributes() templ.Attributes {
	attrs := templ.Attributes{}
	for name, value := range map[string]string{"hx-get": h.Get, "hx-post": h.Post, "hx-target": h.Target, "hx-swap": h.Swap, "hx-trigger": h.Trigger, "hx-confirm": h.Confirm} {
		if value != "" {
			attrs[name] = value
		}
	}
	return attrs
}

func lengthAttrs(minLength, maxLength int, hasMin, hasMax bool) templ.Attributes {
	attrs := templ.Attributes{}
	if hasMin && minLength >= 0 {
		attrs["minlength"] = strconv.Itoa(minLength)
	}
	if hasMax && maxLength >= 0 {
		attrs["maxlength"] = strconv.Itoa(maxLength)
	}
	return attrs
}

func inputType(typ string) string {
	if typ == "" {
		return "text"
	}
	return typ
}

func textareaRows(rows int) string {
	if rows < 1 {
		rows = 5
	}
	return strconv.Itoa(rows)
}

// Input renders a labelled input. Label and control share one wrapper so the
// field occupies a single cell of the form grid.
templ Input(p InputProps) {
	<div class="studio-form-field">
		<label class="studio-form-label" for={ p.ID }>{ p.Label }</label>
		<input
			id={ p.ID }
			name={ p.Name }
			type={ inputType(p.Type) }
			value={ p.Value }
			if p.Placeholder != "" {
				placeholder={ p.Placeholder }
			}
			required?={ p.Required }
			readonly?={ p.ReadOnly }
			checked?={ p.Checked }
			{ lengthAttrs(p.MinLength, p.MaxLength, p.HasMinLength, p.HasMaxLength)... }
			{ p.HTMX.Attributes()... }
		/>
	</div>
}

// Select renders a labelled select. Items wins over Options when both are set.
templ Select(p SelectProps) {
	<div class="studio-form-field">
		<label class="studio-form-label" for={ p.ID }>{ p.Label }</label>
		<select id={ p.ID } name={ p.Name } required?={ p.Required } multiple?={ p.Multiple } { p.HTMX.Attributes()... }>
			for _, option := range selectItems(p) {
				<option value={ option.Value } selected?={ option.Value == p.Value || containsValue(p.Selected, option.Value) }>{ option.Label }</option>
			}
		</select>
	</div>
}

// Textarea renders a labelled multiline control.
templ Textarea(p TextareaProps) {
	<div class="studio-form-field">
		<label class="studio-form-label" for={ p.ID }>{ p.Label }</label>
		<textarea
			id={ p.ID }
			name={ p.Name }
			rows={ textareaRows(p.Rows) }
			required?={ p.Required }
			{ lengthAttrs(p.MinLength, p.MaxLength, p.HasMinLength, p.HasMaxLength)... }
			{ p.HTMX.Attributes()... }
		>{ p.Value }</textarea>
	</div>
}
