package components

import "strconv"

templ itemListEditorTemplate(p ItemListEditorProps) {
	<div
		id={ p.ID }
		class="studio-form-field item-list-widget"
		data-item-list
		data-field-name={ p.ID }
		data-item-list-label={ p.Label }
		data-item-list-input-placeholder={ p.ItemPlaceholder }
		data-item-list-item-aria={ p.ItemAriaLabelPattern }
		data-item-list-remove-aria={ p.RemoveAriaLabelPattern }
	>
		<span class="studio-form-label">{ p.Label }</span>
		<div class="item-list-container">
			<div class="item-list-rows"></div>
			<button type="button" class="button button-quiet item-list-add-btn" aria-label={ p.AddAriaLabel }>+ { p.AddLabel }</button>
		</div>
		<textarea class="item-list-hidden-input" name={ p.Name } hidden>{ p.Value }</textarea>
	</div>
}

templ tableTemplate(p TableProps) {
	<table>
		<caption class="visually-hidden">{ p.Caption }</caption>
		<thead>
			<tr>
				for _, column := range p.Columns {
					<th scope="col">{ column }</th>
				}
				if len(p.RowActions) > 0 {
					<th scope="col">İşlem</th>
				}
			</tr>
		</thead>
		<tbody>
			if len(p.Rows) == 0 {
				<tr><td colspan={ tableEmptyColspan(p) } role="status">{ p.EmptyMessage }</td></tr>
			}
			for index, row := range p.Rows {
				<tr>
					for i := range p.Columns {
						<td>{ tableCell(row, i) }</td>
					}
					if len(p.RowActions) > 0 {
						<td>
							for _, action := range tableRowActions(p, index) {
								@tableActionForm(action)
							}
						</td>
					}
				</tr>
			}
		</tbody>
	</table>
}

templ paginationTemplate(p PaginationProps) {
	<nav aria-label="Sayfalama" class="pagination">
		for _, page := range paginationPages(p.Pages) {
			<a
				href={ templ.SafeURL(paginationHref(p, page)) }
				{ paginationHTMX(p, page)... }
				if page == p.Page {
					aria-current="page"
				}
			>{ strconv.Itoa(page) }</a>
		}
	</nav>
}
