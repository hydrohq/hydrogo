package components

templ richTextEditorTemplate(p RichTextEditorProps) {
	<div class="studio-form-field full-width richtext-wrap" data-field-name={ p.ID }>
		<span class="studio-form-label" id={ p.ID + "-label" }>{ p.Label }</span>
		<div class="richtext-field" data-richtext>
			<div class="richtext-toolbar ql-toolbar ql-snow" aria-label={ p.ToolbarLabel }>
				<span class="ql-formats">
					<button type="button" class="ql-bold" aria-label={ p.BoldLabel }></button>
					<button type="button" class="ql-italic" aria-label={ p.ItalicLabel }></button>
					<button type="button" class="ql-underline" aria-label={ p.UnderlineLabel }></button>
				</span>
				<span class="ql-formats">
					<button type="button" class="ql-link" aria-label={ p.LinkLabel }></button>
					<button type="button" class="ql-image" aria-label={ p.ImageLabel }></button>
					<button type="button" class="ql-blockquote" aria-label={ p.BlockQuoteLabel }></button>
				</span>
				<span class="ql-formats">
					<button type="button" class="ql-list" value="ordered" aria-label={ p.OrderedListLabel }></button>
					<button type="button" class="ql-list" value="bullet" aria-label={ p.BulletListLabel }></button>
				</span>
			</div>
			<div id={ p.ID + "-editor" } class="richtext-editor ql-container ql-snow" role="textbox" aria-labelledby={ p.ID + "-label" } aria-multiline="true" tabindex="0"></div>
			<textarea id={ p.ID } class="richtext-value" name={ p.Name } hidden aria-hidden="true">{ p.Value }</textarea>
		</div>
	</div>
}
