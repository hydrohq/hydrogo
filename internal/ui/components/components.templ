package components

import "strings"

templ linkTemplate(p LinkProps) {
	<a
		href={ templ.SafeURL(p.Href) }
		if strings.TrimSpace(p.Class) != "" {
			class={ p.Class }
		}
	>{ p.Label }</a>
}

templ hiddenInputTemplate(p HiddenInputProps) {
	<input type="hidden" name={ p.Name } value={ p.Value }/>
}

templ validationSummaryTemplate(p ValidationSummaryProps) {
	<section class="studio-alert" role="alert" aria-labelledby="generated-validation-title">
		<h2 id="generated-validation-title">{ p.Title }</h2>
		<p>{ p.Message }</p>
		if len(p.Fields) > 0 {
			<ul>
				for _, field := range p.Fields {
					<li><a href={ templ.SafeURL("#" + field.FieldID) }>{ field.Label }: { field.Message }</a></li>
				}
			</ul>
		}
	</section>
}

// Button renders a typed button; only allowlisted htmx attributes can be set.
templ Button(p ButtonProps) {
	<button type={ buttonType(p.Type) } class={ buttonClass(p) } { p.HTMX.Attributes()... } disabled?={ p.Disabled }>{ p.Label }</button>
}

// Card wraps Body in a titled design-system surface.
templ Card(p CardProps) {
	<section class={ cardClass(p.Class) }>
		<h2>{ p.Title }</h2>
		if p.Body != nil {
			@p.Body
		}
	</section>
}

// Form renders a form with its CSRF token and optional confirmation hook.
templ Form(p FormProps) {
	<form
		action={ templ.SafeURL(p.Action) }
		method={ formMethod(p.Method) }
		if strings.TrimSpace(p.Class) != "" {
			class={ strings.TrimSpace(p.Class) }
		}
		if strings.TrimSpace(p.ConfirmAction) != "" {
			data-confirm-action={ p.ConfirmAction }
		}
	>@formCSRF(p.CSRF)@formBody(p.Body)</form>
}

templ formCSRF(token string) {
	if token != "" {
		<input type="hidden" name="_csrf" value={ token }/>
	}
}

templ formBody(body templ.Component) {
	if body != nil {
		@body
	}
}
