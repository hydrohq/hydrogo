package components

templ blockEditorTemplate(p BlockEditorProps) {
	<fieldset class="block-editor" data-hydro-block-editor={ p.ID }>
		<legend>{ p.Label }</legend>
		<div class="block-editor-layout">
			<div class="block-editor-canvas">
				<div
					id={ p.ID + "-mount" }
					data-editorjs-mount={ p.ID }
					data-editorjs-label={ p.Label }
					data-editorjs-script={ p.EditorScript }
					if p.PreviewURL != "" {
						data-editorjs-preview="true"
					}
				></div>
				<textarea id={ p.ID } name={ p.Name } hidden { blockEditorPreviewAttrs(p)... }>{ p.Value }</textarea>
			</div>
			<aside id={ p.ID + "-preview" } class="block-editor-preview" aria-live="polite"><span>{ p.PreviewPending }</span></aside>
		</div>
	</fieldset>
}
