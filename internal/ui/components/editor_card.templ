package components

// EditorCardProps describes one titled card of the split content editor
// (static/admin/css/editor.css). Tag is an optional small badge next to the
// title; Status is an optional status pill.
type EditorCardProps struct {
	Title  string
	Tag    string
	Status string
}

// EditorCard renders a titled editor card around its children. The title is
// exposed as a heading (keeping the card's compact title styling) so
// screen-reader users can jump between the editor's sections.
templ EditorCard(p EditorCardProps) {
	<section class="editor-card">
		<div class="editor-card-title">
			<span role="heading" aria-level="2">{ p.Title }</span>
			if p.Tag != "" {
				<span class="card-tag">{ p.Tag }</span>
			}
			if p.Status != "" {
				<span class="status">{ p.Status }</span>
			}
		</div>
		{ children... }
	</section>
}
