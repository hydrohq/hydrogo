package components

import "strings"

// ButtonLinkProps describes a local navigation link styled as a button. Unlike
// Link it accepts a query string, so filters and tabs can be expressed as
// plain links.
type ButtonLinkProps struct {
	Href    string
	Label   string
	Variant Variant
	Class   string
	// Current marks the link as the active choice (aria-current="page").
	Current bool
}

// CheckboxProps describes a labelled checkbox whose label wraps the control.
type CheckboxProps struct {
	ID      string
	Name    string
	Label   string
	Value   string
	Class   string
	Checked bool
}

// localHref keeps button links on this origin; anything else becomes "#".
func localHref(value string) string {
	if !strings.HasPrefix(value, "/") || strings.HasPrefix(value, "//") || strings.ContainsAny(value, "\\\r\n\x00") {
		return "#"
	}
	return value
}

func buttonLinkClass(p ButtonLinkProps) string {
	variant := p.Variant
	if variant == "" {
		variant = Quiet
	}
	return strings.TrimSpace("button button-" + string(variant) + " " + p.Class)
}

func ariaCurrent(current bool) string {
	if current {
		return "page"
	}
	return ""
}

// ButtonLink renders a same-origin link with button styling.
templ ButtonLink(p ButtonLinkProps) {
	<a
		class={ buttonLinkClass(p) }
		href={ templ.SafeURL(localHref(p.Href)) }
		if p.Current {
			aria-current={ ariaCurrent(p.Current) }
		}
	>{ p.Label }</a>
}

// Checkbox renders a checkbox inside its label so the whole row is clickable.
templ Checkbox(p CheckboxProps) {
	<label class={ strings.TrimSpace("studio-form-field studio-form-field-checkbox " + p.Class) }>
		<input
			type="checkbox"
			name={ p.Name }
			if p.ID != "" {
				id={ p.ID }
			}
			if p.Value != "" {
				value={ p.Value }
			}
			checked?={ p.Checked }
		/>
		<span>{ p.Label }</span>
	</label>
}

// Script loads an admin script file. Admin pages never carry inline scripts:
// behaviour lives in static files so the strict CSP needs no hashes.
templ Script(src string) {
	<script defer src={ localHref(src) }></script>
}
