package ui

templ BusinessOwnerDashboard(enabled map[string]bool) {
	<section class="business-home" data-business-view aria-label="İşletme paneli">
		<p class="eyebrow">İŞLETME PANELİ</p><h2>İçeriğinizi kolayca yönetin</h2><p>Günlük işleriniz için ihtiyacınız olan alanları buradan açabilirsiniz.</p>
		<nav aria-label="İçerik yönetimi">
			if len(enabled) == 0 {
				<p role="status" class="empty-state">Henüz aktif bir modül bulunmuyor.</p>
			}
			if enabled["pages"] {
				<a class="studio-card" href="/admin/pages"><strong>Sayfalar</strong><span>Site metinlerini ve sayfa bölümlerini düzenleyin.</span></a>
			}
			if enabled["news"] {
				<a class="studio-card" href="/admin/news"><strong>Haberler</strong><span>Haberlerinizi hazırlayın ve yayınlayın.</span></a>
			}
			if enabled["media"] {
				<a class="studio-card" href="/admin/media"><strong>Görseller</strong><span>Site görsellerini yönetin.</span></a>
			}
		</nav>
	</section>
}

templ NotificationCenter(items []NotificationItem, csrf string, digestEnabled bool, timezone, frequency string, digestAvailable bool) {
	<section class="studio-card" data-notification-center aria-labelledby="notifications-title">
		<div class="studio-actions"><h2 id="notifications-title">Bildirimler</h2><form method="post" action="/admin/notifications"><input type="hidden" name="_csrf" value={ csrf }/><input type="hidden" name="action" value="read_all"/><button class="button button-quiet" type="submit" aria-label="Tümünü okundu işaretle">Tümünü okundu işaretle</button></form></div>
		if digestAvailable {
			<form class="studio-actions" method="post" action="/admin/notifications"><input type="hidden" name="_csrf" value={ csrf }/><input type="hidden" name="action" value="digest"/><label><input type="checkbox" name="enabled" value="true" checked?={ digestEnabled }/> Site özeti e-postasını al</label><label>Sıklık<select name="frequency" aria-label="Sıklık"><option value="monthly" selected?={ frequency == "monthly" }>Aylık yönetici özeti</option><option value="weekly" selected?={ frequency == "weekly" }>Haftalık özet</option></select></label><label>Saat dilimi<select name="timezone" aria-label="Saat dilimi"><option value="UTC" selected?={ timezone == "UTC" }>UTC</option><option value="Europe/Istanbul" selected?={ timezone == "Europe/Istanbul" }>İstanbul</option><option value="Europe/London" selected?={ timezone == "Europe/London" }>Londra</option><option value="America/New_York" selected?={ timezone == "America/New_York" }>New York</option></select></label><button class="button button-quiet" type="submit">Tercihi kaydet</button></form>
		}
		if len(items) == 0 {
			<p role="status" class="empty-state">Yeni bildiriminiz yok.</p>
		} else {
			<div role="feed" aria-busy="false">
				for _, item := range items {
					<article class="notification-item"><div><h3>{ item.Title }</h3><p>{ item.Message }</p><time>{ item.Created }</time></div><div class="studio-actions"><a href={ item.TargetPath } aria-label={ "Görüntüle: " + item.Title }>Görüntüle</a><form method="post" action="/admin/notifications"><input type="hidden" name="_csrf" value={ csrf }/><input type="hidden" name="action" value="dismiss"/><input type="hidden" name="id" value={ item.ID }/><button class="button button-quiet" type="submit" aria-label={ "Kapat: " + item.Title }>Kapat</button></form></div></article>
				}
			</div>
		}
	</section>
}

templ GuideCenter(videoURL string) {
	<section class="studio-card" data-guide-center aria-labelledby="guide-title">
		<h2 id="guide-title">Yardım ve rehberler</h2>
		<div role="tablist" aria-label="Rehber sekmeleri">
			<button type="button" role="tab" aria-selected="true" aria-controls="guide-start" id="guide-tab-start" data-guide-tab="start">Başlangıç</button>
			<button type="button" role="tab" aria-selected="false" aria-controls="guide-video" id="guide-tab-video" data-guide-tab="video">Video rehberi</button>
		</div>
		<section role="tabpanel" id="guide-start" aria-labelledby="guide-tab-start" data-guide-panel="start"><h3>Studio’da çalışmaya başlayın</h3><p>İçerik alanından sayfa ve haberlerinizi düzenleyin. Değişiklikleri önizleyip hazır olduğunda yayınlayın.</p><nav><a href="/admin/pages">Sayfaları aç</a><a href="/admin/news">Haberleri aç</a></nav></section>
		<section role="tabpanel" id="guide-video" aria-labelledby="guide-tab-video" data-guide-panel="video" hidden><h3>Video rehberi</h3>
			if videoURL != "" {
				<p>Studio’nun temel adımlarını videoda izleyin.</p>
				<a class="button button-primary" href={ videoURL } target="_blank" rel="noopener noreferrer">Videoyu aç</a>
			} else {
				<p role="status">Video rehberi henüz yapılandırılmadı.</p>
			}
		</section>
	</section>
}
