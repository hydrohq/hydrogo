package ui

import (
	"github.com/ardaozyildirim/hydrogo/internal/auth"
	"github.com/ardaozyildirim/hydrogo/internal/i18n"
	"github.com/ardaozyildirim/hydrogo/modules/designsystem"
)

templ usersArea(data AdminAreaData) {
	<div class="studio-card" data-testid="users-area">
		<div class="dashboard-card-head"><div><h2>{ areaText(data.Locale, "Admin Studio Kullanıcıları", "Admin Studio users") }</h2><p class="muted">{ areaText(data.Locale, "Bu liste yalnızca yönetim paneline giriş yapan hesapları içerir. Frontend üyeleri Üyeler ekranında ayrı tutulur.", "This list contains Admin Studio accounts only. Frontend members remain separate on the Members screen.") }</p></div></div>
		<div class="studio-table-wrap">
			<table class="studio-table">
				<thead><tr><th>Email</th><th>{ areaText(data.Locale, "Rol", "Role") }</th><th>{ areaText(data.Locale, "Durum", "Status") }</th><th>Actions</th></tr></thead>
				<tbody>
					if len(data.Users) == 0 {
						<tr><td colspan="4">{ areaText(data.Locale, "Henüz admin kullanıcısı bulunamadı.", "No admin users found.") }</td></tr>
					}
					for _, user := range data.Users {
						@userRow(data, user)
					}
				</tbody>
			</table>
		</div>
	</div>
}

templ userRow(data AdminAreaData, user *auth.User) {
	<tr>
		<td>
			<strong>{ user.Email }</strong>
			<div>
				if user.EmailVerifiedAt != nil {
					<span class="status-pill status-pill--published">{ areaText(data.Locale, "Doğrulanmış", "Verified") }</span>
				} else {
					<span class="status-pill status-pill--draft">{ areaText(data.Locale, "Doğrulama bekliyor", "Unverified") }</span>
				}
			</div>
		</td>
		<td>
			<form method="post" action={ templ.SafeURL("/auth/users/" + user.ID + "/role") } class="inline-form">
				<input type="hidden" name="_csrf" value={ data.CSRF }/>
				<select name="role" aria-label={ user.Email + " · " + areaText(data.Locale, "Rol", "Role") }>
					<option value="admin" selected?={ string(user.Role) == "admin" }>Admin</option>
					<option value="editor" selected?={ string(user.Role) == "editor" }>Editor</option>
					<option value="viewer" selected?={ string(user.Role) == "viewer" }>Viewer</option>
				</select>
				{ " " }
				<button class="button button-quiet" type="submit">{ areaText(data.Locale, "Kaydet", "Save") }</button>
			</form>
		</td>
		<td>{ userStatus(data.Locale, user.Active) }</td>
		<td>
			if user.EmailVerifiedAt == nil && user.ID != "" && data.EmailVerificationEnabled {
				<form method="post" action={ templ.SafeURL("/auth/users/" + user.ID + "/email/verification/resend") }><input type="hidden" name="_csrf" value={ data.CSRF }/><button class="button button-quiet" type="submit">{ areaText(data.Locale, "Doğrulama e-postasını yeniden gönder", "Resend verification email") }</button></form>
			}
			if data.PasswordResetLinkEnabled && user.Active && user.ID != "" {
				<button class="button button-quiet" type="button" data-password-reset-link={ "/auth/users/" + user.ID + "/password-reset-link" }>{ areaText(data.Locale, "Parola sıfırlama bağlantısını kopyala", "Copy password reset link") }</button><span role="status" aria-live="polite" data-password-reset-status></span>
			}
			if user.ID != "" {
				<form method="post" action={ templ.SafeURL("/auth/users/" + user.ID + "/disable") }><input type="hidden" name="_csrf" value={ data.CSRF }/><button class="button button-quiet" type="submit">Disable</button></form>
			}
			<details class="user-permissions">
				<summary>Custom permissions</summary>
				<form method="post" action={ templ.SafeURL("/auth/users/" + user.ID + "/permissions") } class="studio-form">
					<input type="hidden" name="_csrf" value={ data.CSRF }/>
					for _, permission := range userPermissionCatalog(data.Permissions) {
						<label class="user-permission-row">
							<span>{ permission }</span>
							<select name={ "perm_" + permission }>
								<option value="inherit" selected?={ permissionOverride(user, permission) == "inherit" }>Inherit</option>
								<option value="allow" selected?={ permissionOverride(user, permission) == "allow" }>Allow</option>
								<option value="deny" selected?={ permissionOverride(user, permission) == "deny" }>Deny</option>
							</select>
						</label>
					}
					<button class="button button-quiet" type="submit">{ areaText(data.Locale, "Kaydet", "Save") }</button>
				</form>
			</details>
		</td>
	</tr>
}

templ accountInfoRow(label, value string, accent bool) {
	<div class="acc-info-row">
		<span class="acc-info-label">{ label }</span>
		if accent {
			<span class="acc-info-val acc-info-val--accent">{ value }</span>
		} else {
			<span class="acc-info-val">{ value }</span>
		}
	</div>
}

templ accountArea(data AdminAreaData) {
	<div class="acc-grid">
		<div class="acc-card">
			<h3>{ areaText(data.Locale, "👤 Yönetici Profil Bilgileri", "👤 Administrator profile") }</h3>
			<p>{ areaText(data.Locale, "Admin Studio paneline erişim sağlayan mevcut yetkili hesap:", "The administrator account currently authorized to access Admin Studio:") }</p>
			<div class="acc-info-list">
				@accountInfoRow(areaText(data.Locale, "E-Posta:", "Email:"), data.Email, false)
				@accountInfoRow(areaText(data.Locale, "Rol:", "Role:"), areaText(data.Locale, "👑 Sistem Yöneticisi (Admin)", "👑 System administrator (Admin)"), true)
				@accountInfoRow(areaText(data.Locale, "Oturum Tipi:", "Session type:"), areaText(data.Locale, "Güvenli Oturum", "Secure session"), false)
				@accountInfoRow(areaText(data.Locale, "Erişim Alanı:", "Access scope:"), areaText(data.Locale, "Tüm Modüller & Operasyon", "All modules & operations"), false)
			</div>
			<div class="acc-actions">
				<a href="/admin/security" class="button">Güvenlik &amp; Yetki Ayarları</a>
				<button type="button" data-admin-logout class="button button-quiet">Oturumu Kapat</button>
			</div>
		</div>
		<div class="acc-card">
			<h3>{ areaText(data.Locale, "🔒 Hesap Güvenliği & Parola Yenileme", "🔒 Account security & password reset") }</h3>
			<p>{ areaText(data.Locale, "Yönetici parolanız yüksek güvenlik standartları ile korunmaktadır. Güvenlik politikası gereği güçlü parolalar (en az 8 karakter) zorunludur.", "Your administrator password is protected by strong security standards. Passwords must contain at least 8 characters.") }</p>
			<div class="acc-note">
				<div class="acc-note-title">{ areaText(data.Locale, "Parola Değiştirme:", "Change password:") }</div>
				<div class="acc-note-body">
					if data.Locale == "en" {
						Start a password reset flow from the Security Center or run <code>hydro user reset-password</code> from the CLI.
					} else {
						Parolanızı yenilemek için Güvenlik Merkezinden şifre sıfırlama akışını başlatabilir veya CLI üzerinden <code>hydro user reset-password</code> komutunu çalıştırabilirsiniz.
					}
				</div>
			</div>
		</div>
		<div class="acc-card">
			<h3>✏️ { areaText(data.Locale, "Hesap Bilgilerini Kaydet", "Save account changes") }</h3>
			<p>{ areaText(data.Locale, "Email veya parolanızı değiştirmek için mevcut parolanızı doğrulayın. Değişiklikten sonra güvenlik için tüm oturumlar kapatılır.", "Verify your current password to change your email or password. All sessions will be signed out after the change.") }</p>
			<form method="post" action="/auth/me/credentials" class="studio-form acc-credentials-form">
				<input type="hidden" name="_csrf" value={ data.CSRF }/>
				<label class="studio-form-field"><span>{ areaText(data.Locale, "E-Posta:", "Email:") }</span><input type="email" name="email" value={ data.Email } autocomplete="email" required/></label>
				<label class="studio-form-field"><span>{ areaText(data.Locale, "Mevcut Parola", "Current password") }</span><input type="password" name="current_password" autocomplete="current-password" required/></label>
				<label class="studio-form-field"><span>{ areaText(data.Locale, "Yeni Parola", "New password") }</span><input type="password" name="new_password" minlength="8" autocomplete="new-password" data-password-strength/></label>
				<label class="studio-form-field"><span>{ areaText(data.Locale, "Yeni Parola (Tekrar)", "New password (confirm)") }</span><input type="password" name="confirm_password" minlength="8" autocomplete="new-password"/></label>
				@designsystem.PasswordStrengthMeter()
				<button class="button" type="submit">{ areaText(data.Locale, "Hesap Bilgilerini Kaydet", "Save account changes") }</button>
			</form>
		</div>
		<div class="acc-card">
			<h3>🌐 { i18n.TForTenant(data.TenantID, data.Locale, "admin.language") }</h3>
			<p>{ i18n.TForTenant(data.TenantID, data.Locale, "admin.language") }</p>
			if data.LocaleSaved {
				<p class="studio-kit-summary" role="status">{ i18n.TForTenant(data.TenantID, data.Locale, "admin.language.saved") }</p>
			}
			<form method="post" action="/admin/account/locale" class="studio-form">
				<input type="hidden" name="_csrf" value={ data.CSRF }/>
				<label class="studio-form-field">
					<span>{ i18n.TForTenant(data.TenantID, data.Locale, "admin.language") }</span>
					<select name="locale">
						<option value="tr" selected?={ data.Locale == "tr" }>Türkçe (TR)</option>
						<option value="en" selected?={ data.Locale == "en" }>English (EN)</option>
					</select>
				</label>
				<button class="button" type="submit">{ i18n.TForTenant(data.TenantID, data.Locale, "admin.language.save") }</button>
			</form>
		</div>
	</div>
	@designsystem.MFASettings(designsystem.MFASettingsProps{CSRF: data.CSRF, Locale: data.Locale, Enabled: data.MFAEnabled, Available: data.MFAAvailable, StatusLoaded: data.MFAStatusLoaded})
	if data.SoundAlertsEnabled {
		@designsystem.SoundAlertPreference(designsystem.SoundAlertPreferenceProps{
			Title:       areaText(data.Locale, "Bildirim sesleri", "Notification sounds"),
			Label:       areaText(data.Locale, "Yeni taleplerde sesli uyarı ver", "Play a sound for new inquiries"),
			Description: areaText(data.Locale, "Bu tercih yalnızca bu tarayıcıda saklanır ve varsayılan olarak kapalıdır.", "This preference is stored in this browser and is off by default."),
		})
	}
}
