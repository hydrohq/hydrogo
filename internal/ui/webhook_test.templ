package ui

import "strconv"

templ WebhookTestPage(endpoints []WebhookTestEndpoint, csrf string) {
	<section class="studio-card">
		<h1>Webhook test sandbox</h1>
		<p>Send one signed sample request and inspect its payload, signature, response and latency. Test requests do not enter delivery queues.</p>
		if len(endpoints) == 0 {
			<p role="status">No webhook endpoints are configured.</p>
		} else {
			<form method="post" action="/admin/api/webhooks/test" hx-post="/admin/api/webhooks/test" hx-target="#webhook-test-result" hx-swap="innerHTML">
				<input type="hidden" name="_csrf" value={ csrf } />
				<label>Endpoint<select name="endpoint_id" required>
					for _, endpoint := range endpoints {
						<option value={ endpoint.ID }>{ endpoint.ID }</option>
					}
				</select></label>
				<label>Event type<select name="topic" required>
					<option value="page.published">page.published</option>
					<option value="form.submitted">form.submitted</option>
					<option value="member.created">member.created</option>
				</select></label>
				<button type="submit" class="button button-primary">Send test payload</button>
			</form>
		}
		<div id="webhook-test-result" aria-live="polite"></div>
	</section>
}

templ WebhookTestResult(status, body, signature string, code int, latencyMS int64, response string) {
	<section class="studio-card" aria-label="Webhook test result">
		<h2>{ status }</h2>
		<p>HTTP status: { strconv.Itoa(code) } · { strconv.FormatInt(latencyMS, 10) } ms</p>
		<h3>Request payload</h3><pre>{ body }</pre>
		<h3>X-Hydro-Signature</h3><code>{ signature }</code>
		<h3>Response preview</h3><pre>{ response }</pre>
	</section>
}
