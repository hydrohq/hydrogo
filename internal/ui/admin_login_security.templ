package ui

import "strconv"

templ AdminLoginSecurityNotice(previousLogin, previousIP string, failedAttempts int) {
	if previousLogin != "" || failedAttempts > 0 {
		<section class="studio-card login-security-notice" role="status" aria-label="Oturum güvenlik özeti" data-login-security-notice data-staff-notice="login-security">
			<div class="login-security-notice-header">
				<h2>Oturum güvenlik özeti</h2>
				<button type="button" class="admin-ux-close" data-staff-notice-dismiss title="Kapat" aria-label="Bu bildirimi gizle">×</button>
			</div>
			if previousLogin != "" {
				<p>Önceki başarılı giriş: { previousLogin }
				if previousIP != "" {
					<span> · { previousIP }</span>
				}
				</p>
			}
			if failedAttempts > 0 {
				<p class="status-danger">Önceki oturumunuzdan bu yana { strconv.Itoa(failedAttempts) } başarısız giriş denemesi engellendi. Tanımadığınız bir hareket varsa parolanızı değiştirin.</p>
			}
			if failedAttempts == 0 && previousLogin != "" {
				<p>Önceki oturumunuzdan bu yana başarısız giriş denemesi yok.</p>
			}
		</section>
	}
}
