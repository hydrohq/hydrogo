package ui

// adminLoginView carries everything the standalone /login page shows.
type adminLoginView struct {
	Locale     string
	CSRF       string
	ReturnTo   string
	HeroStyle  string
	DocsURL    string
	EnglishURL string
	TurkishURL string
	// MFAChallenge is the rendered, localized authenticator challenge.
	MFAChallenge string
}

// heroAttributes passes a configured background to login.css as the
// --login-background custom property.
func (v adminLoginView) heroAttributes() templ.Attributes {
	if v.HeroStyle == "" {
		return nil
	}
	return templ.Attributes{"style": v.HeroStyle}
}

// T picks the Turkish or English copy for the page locale.
func (v adminLoginView) T(tr, en string) string {
	if v.Locale == "tr" {
		return tr
	}
	return en
}

templ adminLoginLanguageLink(href, label string, current bool) {
	if current {
		<a href={ templ.SafeURL(href) } aria-current="page">{ label }</a>
	} else {
		<a href={ templ.SafeURL(href) }>{ label }</a>
	}
}

// AdminLoginPage is the standalone sign-in document. It has no inline script:
// /admin-assets/js/login-theme.js applies the saved theme before first paint
// and /admin-assets/js/login.js submits the form; the messages that script
// shows travel as data-msg-* attributes in the page locale.
templ adminLoginPage(v adminLoginView) {
	<!DOCTYPE html>
	<html lang={ v.Locale } data-theme="dark">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ v.T("Yönetici Girişi · HydroGo Studio", "Sign in · HydroGo Studio") }</title>
			<script src="/admin-assets/js/login-theme.js"></script>
			<link rel="stylesheet" href="/admin-assets/css/login.css"/>
			<script defer src="/admin-assets/js/login.js"></script>
		</head>
		<body class="login-body">
			<div class="login-layout">
				<aside class="login-hero-pane" { v.heroAttributes()... }>
					@adminLoginHero(v)
				</aside>
				<main class="login-form-pane">
					<div class="pane-top-actions">
						<nav class="login-language-switch" aria-label={ v.T("Dil", "Language") }>
							@adminLoginLanguageLink(v.EnglishURL, "EN", v.Locale == "en")
							@adminLoginLanguageLink(v.TurkishURL, "TR", v.Locale == "tr")
						</nav>
						<button id="theme-toggle-btn" class="theme-switch-btn" type="button" aria-label={ v.T("Temayı Değiştir", "Change theme") } data-label-dark={ v.T("Koyu Mod", "Dark mode") } data-label-light={ v.T("Açık Mod", "Light mode") }>
							<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
							<span id="theme-toggle-label">{ v.T("Tema", "Theme") }</span>
						</button>
					</div>
					<div class="form-container">
						<div class="form-header">
							<h2 class="form-title">{ v.T("Hoş Geldiniz", "Welcome back") }</h2>
							<p class="form-subtitle">{ v.T("Yönetim merkezine erişmek için giriş yapın.", "Sign in to your Admin Studio workspace.") }</p>
						</div>
						<form
							id="login-form"
							class="auth-form"
							method="post"
							data-return-to={ v.ReturnTo }
							data-msg-signing-in={ v.T("Giriş yapılıyor…", "Signing in…") }
							data-msg-code-expires={ v.T("Kodun süresi ", "Code expires in ") }
							data-msg-code-expires-suffix={ v.T(" sonra dolacak.", ".") }
							data-msg-next-code={ v.T("Authenticator uygulamanızdan yeni kodu girin.", "Enter the next code from your authenticator app.") }
							data-msg-mfa-required={ v.T("Parola doğru. İki adımlı doğrulama kodunuzu girin.", "Password accepted. Enter your two-step verification code.") }
							data-msg-mfa-invalid={ v.T("Kod doğrulanamadı. Authenticator uygulamanızdaki güncel kodu deneyin.", "Code could not be verified. Try the current code in your authenticator app.") }
							data-msg-invalid={ v.T("E-posta veya şifre hatalı. Lütfen bilgilerinizi kontrol edin.", "Email or password is incorrect. Check your details and try again.") }
							data-msg-rate-limited={ v.T("Çok fazla başarısız deneme yapıldı. Lütfen biraz bekleyin.", "Too many attempts. Please wait and try again.") }
							data-msg-csrf={ v.T("Güvenlik doğrulaması başarısız. Lütfen sayfayı yenileyin.", "Security check failed. Refresh the page and try again.") }
							data-msg-unavailable={ v.T("Giriş şu anda tamamlanamadı. Lütfen tekrar deneyin.", "Sign in is temporarily unavailable. Please try again.") }
							data-msg-success={ v.T("Giriş başarılı! Yönetim paneline aktarılıyorsunuz…", "Signed in. Opening Admin Studio…") }
							data-msg-previous-login={ v.T("Önceki başarılı giriş: ", "Previous successful sign in: ") }
							data-msg-failed-attempts={ v.T(" başarısız deneme.", " failed attempts.") }
							data-msg-first-login={ v.T("İlk başarılı girişiniz. Önceki oturumdan bu yana ", "This is your first successful sign in. There have been ") }
							data-msg-first-login-suffix={ v.T(" başarısız deneme kaydedildi.", " failed attempts since the previous session.") }
							data-msg-unreachable={ v.T("Sunucuya ulaşılamadı. Lütfen bağlantınızı kontrol edip tekrar deneyin.", "Could not reach the server. Check your connection and try again.") }
						>
							<input type="hidden" name="_csrf" value={ v.CSRF }/>
							@templ.Raw(v.MFAChallenge)
							<div class="input-group">
								<label class="input-label" for="login-email">{ v.T("E-posta Adresi", "Email address") }</label>
								<div class="input-wrapper">
									<span class="input-icon">
										<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
									</span>
									<input id="login-email" class="auth-input" name="email" type="email" required autocomplete="username" placeholder="admin@hydrogo.local" autofocus/>
								</div>
							</div>
							<div class="input-group">
								<div class="input-label-row">
									<label class="input-label" for="login-password">{ v.T("Şifre", "Password") }</label>
									<a href={ templ.SafeURL("mailto:destek@hydrogo.local?subject=Sifre%20Sifirlama") } class="link-subtle">{ v.T("Şifremi unuttum?", "Forgot password?") }</a>
								</div>
								<div class="input-wrapper">
									<span class="input-icon">
										<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
									</span>
									<input id="login-password" class="auth-input" name="password" type="password" required autocomplete="current-password" placeholder="••••••••••••"/>
								</div>
							</div>
							<div class="form-row-utility">
								<label class="checkbox-label">
									<input type="checkbox" name="remember" id="remember-me"/>
									<span class="checkbox-custom">
										<svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
									</span>
									<span>{ v.T("Beni hatırla", "Remember me") }</span>
								</label>
							</div>
							<button class="btn-submit" type="submit">
								<span>{ v.T("Giriş Yap", "Sign in") }</span>
								<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
							</button>
							<div id="login-status" class="form-alert" role="alert"></div>
						</form>
					</div>
					<footer class="form-pane-footer">
						<span>HydroGo Studio</span>
					</footer>
				</main>
			</div>
		</body>
	</html>
}

templ adminLoginHero(v adminLoginView) {
	<div class="hero-glow-sphere"></div>
	<header class="hero-header">
		<a class="brand-badge" href="/" aria-label={ v.T("HydroGo Ana Sayfa", "HydroGo home") }>
			<div class="brand-icon-box">
				<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
			</div>
			<div class="brand-text-wrap">
				<span class="brand-name">HYDRO<strong>GO</strong></span>
				<span class="brand-tag">Studio</span>
			</div>
		</a>
	</header>
	<div class="hero-content">
		<p class="hero-eyebrow">{ v.T("Modern yayıncılık için çalışma alanı", "The workspace for modern publishing") }</p>
		<h1 class="hero-headline">{ v.T("Güçlü Yönetim,", "One workspace,") } <br/><span class="gradient-text">{ v.T("Yüksek Performans", "built for speed") }</span></h1>
		<p class="hero-description">{ v.T("İçerik, üyelik ve ticaret süreçlerinizi hızlı ve güvenli tek bir çalışma alanından yönetin.", "Manage your content, memberships, and commerce operations from one fast, secure workspace.") }</p>
		<nav class="hero-links" aria-label={ v.T("Kaynaklar", "Resources") }><a href={ templ.SafeURL(v.DocsURL) }>{ v.T("Dokümantasyon ↗", "Documentation ↗") }</a><a href="/">{ v.T("Ana sayfa ↗", "Home ↗") }</a></nav>
	</div>
}
