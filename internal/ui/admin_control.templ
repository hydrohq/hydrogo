package ui

// infoTip is the "i" button with a hover popover used in dashboard card heads.
templ infoTip(eyebrow, text string) {
	<span class="studio-info-tip" tabindex="0" role="button" aria-label="Bilgi">
		<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
		<span class="studio-tip-popover">
			<span class="tip-eyebrow">{ eyebrow }</span>
			<p>{ text }</p>
		</span>
	</span>
}

type controlTile struct {
	Href, Icon, Title, Text string
	External                bool
}

var controlPublishingTiles = []controlTile{
	{Href: "/admin/site/appearance", Icon: "appearance", Title: "Marka ve Görünüm", Text: "Renk paleti, kontrast ve yazı tipi ayarları"},
	{Href: "/site/settings", Icon: "code", Title: "Public Site Ayarları JSON ↗", Text: "Uygulamanın dışa sunduğu genel yapılandırma çıktısı", External: true},
	{Href: "/site/navigation/tr", Icon: "menu", Title: "TR Navigasyon Menüsü ↗", Text: "Yayınlanan menü ve hiyerarşi ağacı JSON çıktısı", External: true},
	{Href: "/admin/site/inbox/contact", Icon: "mail", Title: "İletişim Formu Gelen Kutusu ↗", Text: "Web sitesinden gönderilen form mesajları", External: true},
}

type controlProbe struct {
	Href, Badge, BadgeClass, Title, Text string
}

var controlProbes = []controlProbe{
	{Href: "/healthz", Badge: "HTTP 200", BadgeClass: "tool-badge tool-badge-green", Title: "Healthz (Liveness)", Text: "Temel servis çalışma kontrolü"},
	{Href: "/readyz", Badge: "READY", BadgeClass: "tool-badge tool-badge-green", Title: "Readyz (Readiness)", Text: "Veritabanı & havuz hazırlığı"},
	{Href: "/metrics", Badge: "METRICS", BadgeClass: "tool-badge", Title: "Prometheus Metrikleri", Text: "İstek, gecikme ve bellek verileri"},
}

templ controlTileIcon(name string) {
	switch name {
		case "appearance":
			<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="12" cy="12" r="9"></circle><path d="M12 3v18M3 12h18"></path></svg>
		case "code":
			<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>
		case "menu":
			<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
		case "mail":
			<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
	}
}

// adminControlBody is the body of /admin/control. Its forms post through
// /admin-assets/js/admin-control.js.
templ adminControlBody(data AdminControlData) {
	@DeveloperTabs("control")
	<div class="control-container">
		<div class="dashboard-grid">
			<article class="studio-card dashboard-card">
				<div class="dashboard-card-head">
					<div class="card-title-group">
						<svg class="control-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
						<h2>Site Yapılandırması</h2>
						@infoTip("YAPILANDIRMA", "Sitenin genel ayar parametrelerini (site.title vb.) ve URL yönlendirme kurallarını buradan yönetin.")
					</div>
					<span class="muted control-meta">Anahtar / Değer &amp; URL Kuralları</span>
				</div>
				<div class="control-stack">
					<div>
						<h3 class="control-subtitle">
							<span>Ayar Kaydet / Güncelle</span>
						</h3>
						<form class="studio-form control-form" id="setting-form">
							<label class="control-span">
								<span>Ayar Anahtarı (Key)</span>
								<input name="key" placeholder="Örn: site.title, site.tagline, contact.email" required/>
							</label>
							<label class="control-span">
								<span>Değer (Value)</span>
								<textarea name="value" rows="2" class="control-textarea" placeholder="Ayar değerini girin..." required></textarea>
							</label>
							<div class="control-form-actions">
								<button type="submit" class="button">Ayarı Kaydet</button>
							</div>
						</form>
					</div>
					<div class="control-divider"></div>
					<div>
						<h3 class="control-subtitle">URL Yönlendirme (Redirect)</h3>
						<form class="studio-form control-form" id="redirect-form">
							<label>
								<span>Kaynak Yol</span>
								<input name="source_path" placeholder="/eski-sayfa" required/>
							</label>
							<label>
								<span>Hedef Yol</span>
								<input name="target_path" placeholder="/yeni-sayfa" required/>
							</label>
							<label class="control-span">
								<span>HTTP Durum Kodu</span>
								<select name="status">
									<option value="301">301 - Kalıcı Yönlendirme (Permanent Redirect)</option>
									<option value="308">308 - Kalıcı Yönlendirme (Permanent Preserve Method)</option>
									<option value="302">302 - Geçici Yönlendirme (Found / Temporary)</option>
									<option value="307">307 - Geçici Yönlendirme (Temporary Preserve Method)</option>
								</select>
							</label>
							<div class="control-form-actions">
								<button type="submit" class="button button-quiet">Yönlendirmeyi Kaydet</button>
							</div>
						</form>
					</div>
				</div>
			</article>
			<article class="studio-card dashboard-card">
				<div class="dashboard-card-head">
					<div class="card-title-group">
						<svg class="control-icon control-icon--green" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
						<h2>Medya &amp; Asset Hattı</h2>
						@infoTip("ASSET PIPELINE", "Yüklenen görseller otomatik olarak güvenli kontrol, MIME doğrulaması ve pending → ready hattından geçer.")
					</div>
					<span class="status status-success control-format-badge">JPEG, PNG, WebP</span>
				</div>
				<form class="studio-form control-form" id="media-form" enctype="multipart/form-data">
					<input type="hidden" name="_csrf" value={ data.CSRF }/>
					<label class="control-span">
						<span>Yüklenecek Görsel Dosyası</span>
						<input class="control-file-input" name="file" type="file" accept="image/jpeg,image/png,image/webp" required/>
					</label>
					<div class="control-form-footer control-form-footer--spaced">
						<small class="muted control-meta">Maksimum dosya boyutu: 10MB</small>
						<button type="submit" class="button">Görseli Yükle</button>
					</div>
				</form>
				<div class="control-divider control-divider--spaced"></div>
				<div>
					<h3 class="control-subtitle control-subtitle--small">Yayın Yüzeyleri &amp; Form Kutuları</h3>
					<div class="collection-grid">
						for _, tile := range controlPublishingTiles {
							if tile.External {
								<a class="collection-tile" href={ templ.SafeURL(tile.Href) } target="_blank">
									@controlTileBody(tile)
								</a>
							} else {
								<a class="collection-tile" href={ templ.SafeURL(tile.Href) }>
									@controlTileBody(tile)
								</a>
							}
						}
					</div>
				</div>
			</article>
		</div>
		<div class="dashboard-grid">
			<article class="studio-card dashboard-card">
				<div class="dashboard-card-head">
					<div class="card-title-group">
						<svg class="control-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="8.5" cy="7" r="4"></circle><line x1="20" y1="8" x2="20" y2="14"></line><line x1="23" y1="11" x2="17" y2="11"></line></svg>
						<h2>Yönetici &amp; Editör Daveti</h2>
						@infoTip("ERİŞİM YÖNETİMİ", "Yeni bir yönetici veya editör için güvenli davet e-postası tetikleyin.")
					</div>
					<span class="muted control-meta">E-posta &amp; Rol Belirleme</span>
				</div>
				<form class="studio-form control-form" id="invite-form">
					<input type="hidden" name="_csrf" value={ data.CSRF }/>
					<label>
						<span>Davet Edilecek E-posta</span>
						<input name="email" type="email" placeholder="ornek@alanadi.com" required/>
					</label>
					<label>
						<span>Atanacak Rol</span>
						<select name="role">
							<option value="editor">Editor (İçerik &amp; Taslak Yönetimi)</option>
							<option value="viewer">Viewer (Salt Okunur Gözlem)</option>
							<option value="admin">Admin (Tam Yetkili Yönetici)</option>
						</select>
					</label>
					<div class="control-form-footer">
						<small class="muted control-meta">Davet bağlantısı 24 saat geçerlidir.</small>
						<button type="submit" class="button">Davet Gönder</button>
					</div>
				</form>
				<div class="control-divider control-divider--spaced"></div>
				<div class="control-link-row">
					<a class="button button-quiet control-link" href="/auth/me" target="_blank">
						<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
						<span>Hesap &amp; MFA Durumu ↗</span>
					</a>
					<a class="button button-quiet control-link" href="/admin/permissions">
						<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
						<span>Yetki Matrisi</span>
					</a>
				</div>
			</article>
			<article class="studio-card dashboard-card">
				<div class="dashboard-card-head">
					<div class="card-title-group">
						<svg class="control-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>
						<h2>Sistem Tanıları &amp; API Uçları</h2>
						@infoTip("OBSERVABILITY & API", "Canlılık, hazırlık, Prometheus metrikleri ve headless API uç noktaları.")
					</div>
					<span class="muted control-meta">Gözlemlenebilirlik</span>
				</div>
				<div class="tool-grid control-tool-grid">
					for _, probe := range controlProbes {
						<a class="tool-tile" href={ templ.SafeURL(probe.Href) } target="_blank">
							<div class="tool-header">
								<span class={ probe.BadgeClass }>{ probe.Badge }</span>
								<b>↗</b>
							</div>
							<strong>{ probe.Title }</strong>
							<small>{ probe.Text }</small>
						</a>
					}
				</div>
			</article>
		</div>
		<section class="studio-card control-shortcuts">
			<div class="dashboard-card-head control-shortcuts-head">
				<div class="card-title-group">
					<svg class="control-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg>
					<h2>Modül Yönetim Kısayolları</h2>
					@infoTip("HIZLI ERİŞİM", "Sık kullanılan içerik, e-ticaret ve üye yönetimi panellerine doğrudan geçiş.")
				</div>
				<span class="muted control-meta">Doğrudan Erişim</span>
			</div>
			<div class="studio-actions control-shortcut-actions">
				<a class="button" href="/admin/news">Haber Yönetimi</a>
				<a class="button button-quiet" href="/admin/pages">Sayfa Yönetimi</a>
				<a class="button button-quiet" href="/admin/commerce/products">Ürün Kataloğu</a>
				<a class="button button-quiet" href="/admin/commerce/orders">Siparişler</a>
				<a class="button button-quiet" href="/admin/members">Üyeler</a>
				<a class="button button-quiet" href="/admin/reports">Raporlar &amp; Analitik</a>
			</div>
		</section>
	</div>
	@AdminInviteShareDialog()
}

templ controlTileBody(tile controlTile) {
	<span class="tile-icon">
		@controlTileIcon(tile.Icon)
	</span>
	<span><strong>{ tile.Title }</strong><small>{ tile.Text }</small></span>
	<span class="arrow">→</span>
}
