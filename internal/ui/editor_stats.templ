package ui

templ EditorStats() {
	<output class="studio-card editor-stats" data-editor-stats hidden aria-live="polite">
		<span><strong data-editor-words>0</strong> words</span>
		<span><strong data-editor-characters>0</strong> characters</span>
		<span><strong data-editor-reading-time>1</strong> min read</span>
		<span data-editor-keyword-wrap hidden>Keyword density: <strong data-editor-keyword-density>0%</strong></span>
	</output>
}
