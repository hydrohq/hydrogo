package ui

import "github.com/ardaozyildirim/hydrogo/modules/designsystem"

templ EditorStats() {
	<output class="studio-card editor-stats" data-editor-stats hidden aria-live="polite">
		<span><strong data-editor-words>0</strong> kelime</span>
		<span><strong data-editor-characters>0</strong> karakter</span>
		<span>~<strong data-editor-reading-time>1</strong> dk okuma</span>
		<span data-editor-keyword-wrap hidden>Anahtar kelime yoğunluğu: <strong data-editor-keyword-density>0%</strong></span>
	</output>
	@designsystem.SEOAudit()
	@PageWeightInspector()
}
