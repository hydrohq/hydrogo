package server

// maintenanceFallbackPage is served while maintenance mode is on and no
// renderer (the configured maintenance page) produced a body.
templ maintenanceFallbackPage() {
	<!doctype html>
	<html lang="en"><meta charset="utf-8"/><title>We'll be back soon</title><h1>We'll be back soon</h1><p>We're making a few improvements. Please try again shortly.</p></html>
}
