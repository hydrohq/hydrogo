# ==============================================================================
# HydroGo Environment Configuration
# ==============================================================================

# Server Network Configuration
HYDRO_HTTP_ADDRESS=127.0.0.1:8080
HYDRO_PUBLIC_ORIGIN=https://example.com
HYDRO_CAPACITY_PROFILE=compact
HYDRO_SAFE_MODE=false

# Database Configuration (PostgreSQL / SQLite / MySQL)
HYDRO_DATABASE_DIALECT=postgres
HYDRO_DATABASE_DSN=postgres://hydrogo_app:change-me@127.0.0.1:5432/hydrogo_cloud?sslmode=disable

# Authentication & Security
HYDRO_JWT_SECRET=replace-with-a-cryptographically-secure-random-secret-key-at-least-32-chars
HYDRO_SECURITY_PASSWORD_RESET_TTL=1h
HYDRO_SECURITY_INVITATION_TTL=24h

# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# Multi-tenant Store Factory & Domain Bindings (Opsiyonel)
# ------------------------------------------------------------------------------
HYDRO_BASE_DOMAIN=example.com
HYDRO_CONSOLE_HOST=console.example.com
SERVER_PUBLIC_IP=203.0.113.10
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
