# HydroGo Local Development Configuration

HYDRO_ENV=development
HYDRO_PROFILE=compact
HYDRO_HTTP_HOST=127.0.0.1
HYDRO_HTTP_PORT=8080

# Local SQLite (zero dependency)
HYDRO_DATABASE_DRIVER=sqlite
HYDRO_DATABASE_URL=file:hydro.sqlite?_pragma=busy_timeout(5000)&_pragma=journal_mode(WAL)&_pragma=foreign_keys(ON)

# Local In-Memory Cache (No Redis required in compact mode)
# HYDRO_REDIS_URL=redis://127.0.0.1:6379/15

# Local filesystem media storage
HYDRO_MEDIA_ROOT=./data/media

# Local logger
HYDRO_LOG_FORMAT=text
HYDRO_LOG_LEVEL=debug
