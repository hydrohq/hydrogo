# HydroGo local development configuration. Values below match internal/config.
HYDRO_CAPACITY_PROFILE=compact
HYDRO_HTTP_ADDRESS=127.0.0.1:8080
HYDRO_DATABASE_DIALECT=sqlite
HYDRO_DATABASE_DSN=file:hydro.sqlite?_pragma=busy_timeout(5000)&_pragma=journal_mode(WAL)&_pragma=foreign_keys(ON)
HYDRO_MEDIA_DIR=./data/media

# Optional services remain disabled in Compact unless explicitly configured.
# HYDRO_REDIS_URL=redis://127.0.0.1:6379/15
