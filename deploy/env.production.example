# HydroGo Production Environment Configuration
# NEVER commit unredacted secrets into git or production logs.

HYDRO_ENV=production
HYDRO_PROFILE=standard
HYDRO_HTTP_HOST=0.0.0.0
HYDRO_HTTP_PORT=8080
HYDRO_CANONICAL_HOST=example.com
HYDRO_FORCE_HTTPS=true

# Database Configuration (PostgreSQL 18 HA)
HYDRO_DATABASE_DRIVER=postgres
HYDRO_DATABASE_URL=postgres://hydro_app:REPLACE_WITH_SECURE_PASSWORD@pg-cluster.internal:5432/hydro_prod?sslmode=verify-full&sslrootcert=/etc/ssl/certs/pg-ca.pem
HYDRO_DB_MAX_OPEN_CONNS=50
HYDRO_DB_MAX_IDLE_CONNS=10
HYDRO_DB_CONN_MAX_LIFETIME=30m

# Distributed Cache & Rate Limiter (Redis / Valkey)
HYDRO_REDIS_URL=rediss://:REPLACE_WITH_VALKEY_AUTH@valkey-cluster.internal:6379/0?ssl=true
HYDRO_REDIS_POOL_SIZE=30

# Cryptographic Keys (Loaded via Secret Manager in live env)
HYDRO_SESSION_KEY=REPLACE_WITH_64_CHAR_HEX_KEY
HYDRO_ENCRYPTION_KEY=REPLACE_WITH_64_CHAR_HEX_KEY

# Object Storage (S3 / R2 / MinIO)
HYDRO_S3_ENDPOINT=s3.eu-central-1.amazonaws.com
HYDRO_S3_BUCKET=hydro-prod-media-example
HYDRO_S3_REGION=eu-central-1
HYDRO_S3_ACCESS_KEY=REPLACE_WITH_AWS_ACCESS_KEY
HYDRO_S3_SECRET_KEY=REPLACE_WITH_AWS_SECRET_KEY
HYDRO_S3_PUBLIC_BASE_URL=https://cdn.example.com

# Mailer (SMTP with STARTTLS)
HYDRO_MAILER_DRIVER=smtp
HYDRO_MAILER_SMTP_HOST=smtp.sendgrid.net
HYDRO_MAILER_SMTP_PORT=587
HYDRO_MAILER_SMTP_USER=apikey
HYDRO_MAILER_SMTP_PASS=REPLACE_WITH_SENDGRID_API_KEY
HYDRO_MAILER_FROM_ADDRESS=noreply@example.com
HYDRO_MAILER_FROM_NAME="HydroGo Production"

# Observability & Logging
HYDRO_LOG_FORMAT=json
HYDRO_LOG_LEVEL=info
HYDRO_OBSERVABILITY_PROMETHEUS=true
HYDRO_METRICS_TOKEN=REPLACE_WITH_METRICS_SCRAPE_BEARER_TOKEN
