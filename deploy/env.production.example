# HydroGo production configuration. Keep actual values only in a secret manager.
HYDRO_CAPACITY_PROFILE=standard
HYDRO_HTTP_ADDRESS=0.0.0.0:8080
HYDRO_PUBLIC_ORIGIN=https://example.com
HYDRO_SECURE_COOKIES=true
HYDRO_ENABLE_HSTS=true
HYDRO_DATABASE_DIALECT=postgres
HYDRO_DATABASE_DSN=postgres://hydro_app:REPLACE_ME@pg-cluster.internal:5432/hydro_prod?sslmode=verify-full
HYDRO_REDIS_URL=rediss://:REPLACE_ME@valkey-cluster.internal:6379/0
HYDRO_MFA_MASTER_KEY=REPLACE_WITH_16_24_OR_32_BYTE_SECRET
HYDRO_MEDIA_STORAGE_DRIVER=s3
HYDRO_MEDIA_S3_ENDPOINT=s3.eu-central-1.amazonaws.com
HYDRO_MEDIA_S3_BUCKET=hydro-prod-media-example
HYDRO_MEDIA_S3_REGION=eu-central-1
HYDRO_MEDIA_S3_ACCESS_KEY=REPLACE_ME
HYDRO_MEDIA_S3_SECRET_KEY=REPLACE_ME
HYDRO_MEDIA_CDN_BASE_URL=https://cdn.example.com
HYDRO_SMTP_HOST=smtp.example.com
HYDRO_SMTP_PORT=587
HYDRO_SMTP_USERNAME=REPLACE_ME
HYDRO_SMTP_PASSWORD=REPLACE_ME
HYDRO_SMTP_FROM=noreply@example.com
HYDRO_SMTP_STARTTLS=true
