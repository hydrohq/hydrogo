Options +ExecCGI -Indexes
AddHandler cgi-script .cgi
RewriteEngine On

# Cached HTML is only an internal rewrite target. Never expose its filesystem
# path as a public URL.
RewriteCond %{THE_REQUEST} \s/+static_cache/ [NC]
RewriteRule ^static_cache/ - [F,L]

# 1. Keep real static assets (images, CSS, JS, favicon) on Apache's direct static path.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 2a. Brotli-compressed cache passthrough. Same conditions as 2 below, plus a
# pre-compressed ".html.br" sibling (written alongside every ".html" cache
# entry, see internal/server/static_cache.go's writeCachedFileBrotliSibling)
# and client support. Must come first so a supporting client prefers it.
RewriteCond %{REQUEST_METHOD} GET
RewriteCond %{QUERY_STRING} ^$
RewriteCond %{HTTP_COOKIE} ^$
RewriteCond %{HTTP:Accept-Encoding} br
RewriteCond %{DOCUMENT_ROOT}/static_cache/%{SERVER_NAME}%{REQUEST_URI}.html.br -f
RewriteRule ^(.*)$ static_cache/%{SERVER_NAME}/$1.html.br [L]

# 2. Static HTML Cache Passthrough:
# If a cached static HTML file exists and the visitor has no active session cookie,
# Apache serves the static file directly from disk with ZERO CGI process invocation!
RewriteCond %{REQUEST_METHOD} GET
RewriteCond %{QUERY_STRING} ^$
RewriteCond %{HTTP_COOKIE} ^$
RewriteCond %{DOCUMENT_ROOT}/static_cache/%{SERVER_NAME}%{REQUEST_URI}.html -f
RewriteRule ^(.*)$ static_cache/%{SERVER_NAME}/$1.html [L]

# 3. Static asset caching headers
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 1 minute"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
</IfModule>

# Cached HTML has no per-request CSP nonce, so use a fixed policy. Matches
# both the plain ".html" cache file and its pre-compressed ".html.br" sibling.
<FilesMatch "\.html(\.br)?$">
  <IfModule mod_headers.c>
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
    Header always set X-Content-Type-Options "nosniff"
  </IfModule>
</FilesMatch>

# ".html.br" has no extension Apache recognizes, so its Content-Type and
# Content-Encoding must be set explicitly; without this a client would
# receive raw Brotli bytes labeled as application/octet-stream.
<FilesMatch "\.html\.br$">
  <IfModule mod_headers.c>
    Header always set Content-Encoding br
    Header always set Content-Type "text/html; charset=utf-8"
    Header always set Vary "Accept-Encoding"
  </IfModule>
</FilesMatch>

# 4. Route all remaining dynamic requests to the self-contained HydroGo binary.
RewriteRule ^ hydro.cgi [QSA,L]
