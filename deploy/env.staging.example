# HydroGo Staging Environment Configuration

HYDRO_ENV=staging
HYDRO_PROFILE=standard
HYDRO_HTTP_HOST=0.0.0.0
HYDRO_HTTP_PORT=8080
HYDRO_CANONICAL_HOST=staging.example.com
HYDRO_FORCE_HTTPS=true

# Database Configuration (PostgreSQL 18)
HYDRO_DATABASE_DRIVER=postgres
HYDRO_DATABASE_URL=postgres://hydro_app:staging_password@pg-staging.internal:5432/hydro_staging?sslmode=require
HYDRO_DB_MAX_OPEN_CONNS=20
HYDRO_DB_MAX_IDLE_CONNS=5

# Distributed Cache (Redis / Valkey)
HYDRO_REDIS_URL=redis://valkey-staging.internal:6379/1

# Cryptographic Keys (Staging)
HYDRO_SESSION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
HYDRO_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Object Storage (MinIO or Staging S3 Bucket)
HYDRO_S3_ENDPOINT=s3.eu-central-1.amazonaws.com
HYDRO_S3_BUCKET=hydro-staging-media
HYDRO_S3_REGION=eu-central-1
HYDRO_S3_ACCESS_KEY=staging_access_key
HYDRO_S3_SECRET_KEY=staging_secret_key
HYDRO_S3_PUBLIC_BASE_URL=https://staging-cdn.example.com

# Mailer (Mock or MailHog/Mailpit for Staging)
HYDRO_MAILER_DRIVER=smtp
HYDRO_MAILER_SMTP_HOST=mailpit.internal
HYDRO_MAILER_SMTP_PORT=1025
HYDRO_MAILER_FROM_ADDRESS=noreply@staging.example.com
HYDRO_MAILER_FROM_NAME="HydroGo Staging"

# Observability
HYDRO_LOG_FORMAT=json
HYDRO_LOG_LEVEL=debug
HYDRO_OBSERVABILITY_PROMETHEUS=true
