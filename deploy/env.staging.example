# HydroGo staging configuration. Do not commit real credentials.
HYDRO_CAPACITY_PROFILE=standard
HYDRO_HTTP_ADDRESS=0.0.0.0:8080
HYDRO_PUBLIC_ORIGIN=https://staging.example.com
HYDRO_SECURE_COOKIES=true
HYDRO_ENABLE_HSTS=true
HYDRO_DATABASE_DIALECT=postgres
HYDRO_DATABASE_DSN=postgres://hydro_app:REPLACE_ME@pg-staging.internal:5432/hydro_staging?sslmode=require
HYDRO_REDIS_URL=redis://:REPLACE_ME@valkey-staging.internal:6379/1
HYDRO_MFA_MASTER_KEY=REPLACE_WITH_16_24_OR_32_BYTE_SECRET
HYDRO_MEDIA_STORAGE_DRIVER=s3
HYDRO_MEDIA_S3_ENDPOINT=s3.eu-central-1.amazonaws.com
HYDRO_MEDIA_S3_BUCKET=hydro-staging-media
HYDRO_MEDIA_S3_REGION=eu-central-1
HYDRO_MEDIA_S3_ACCESS_KEY=REPLACE_ME
HYDRO_MEDIA_S3_SECRET_KEY=REPLACE_ME
HYDRO_MEDIA_CDN_BASE_URL=https://staging-cdn.example.com
HYDRO_SMTP_HOST=mailpit.internal
HYDRO_SMTP_PORT=1025
HYDRO_SMTP_FROM=noreply@staging.example.com
HYDRO_SMTP_STARTTLS=false
